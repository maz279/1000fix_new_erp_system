# 1000fix_new_erp_system — root .gitignore
# (deeper subtrees carry their own .gitignore, e.g. 1000_fix_codebase/.gitignore)

# --- Tool-local state (never repository content) ---
.mimosa/
.zcode/
.v2c/
.video_agent/

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
!**/*.key.example
secrets/
vault/

# --- Dependencies ---
node_modules/
.pnpm-store/
# Root-anchored ONLY: 1000_fix_codebase/vendor is first-party content by design
# (Odoo submodule + OCA subtrees — clone-budget.md, FF-03). A bare `vendor/`
# pattern matched at every depth and ignored the pinned submodule.
/vendor/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv-cache/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Database dumps / archives (never commit) ---
*.dump
*.sql.gz
*.backup
db/backups/

# --- Editors / OS ---
.idea/
*.swp
Thumbs.db
.DS_Store
nul

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
coverage/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
# 自定义规则写在下方（本行提示可删除）
