{
  "$description": "1000FiX Design Token Source (DSY-01, P04-M07-T02). THE single source of truth. Every runtime consumes a GENERATED artefact; no runtime authors a value. Format: W3C Design Tokens Format Module 2025.10 (DTCG JSON).",
  "$note": "Five realisations consume this tree: R1=OWL2/QWeb, R2=Next.js, R3=Flutter, R4=Email/WhatsApp, R5=Grafana (partial). CFM-01: no raw literals in any realisation.",
  "color": {
    "$type": "color",
    "text": {
      "primary": { "$value": "#1a1a2e", "$description": "Primary text on light surfaces" },
      "secondary": { "$value": "#5c6370", "$description": "Secondary/de-emphasised text" },
      "disabled": { "$value": "#9ca3af", "$description": "Disabled state text" },
      "inverse": { "$value": "#ffffff", "$description": "Text on dark surfaces" }
    },
    "surface": {
      "primary": { "$value": "#ffffff", "$description": "Main content background" },
      "secondary": { "$value": "#f8f9fa", "$description": "Secondary panels" },
      "tertiary": { "$value": "#e9ecef", "$description": "Tertiary/background" },
      "dark": { "$value": "#1a1a2e", "$description": "Dark mode background" }
    },
    "status": {
      "success": { "$value": "#10b981", "$description": "Passed/healthy/active" },
      "warning": { "$value": "#f59e0b", "$description": "Pending/near-breach/caution" },
      "error": { "$value": "#c62222", "$description": "Failed/breach/critical (white text 5.75:1, WCAG 2.2 AA)" },
      "info": { "$value": "#3b82f6", "$description": "Informational" },
      "neutral": { "$value": "#6b7280", "$description": "Neutral/inactive" },
      "brand": { "$value": "#2563eb", "$description": "1000FiX brand blue" },
      "accent": { "$value": "#8b5cf6", "$description": "Accent/highlight" },
      "urgent": { "$value": "#dc2626", "$description": "Emergency/expedited" }
    },
    "border": {
      "default": { "$value": "#d1d5db" },
      "strong": { "$value": "#9ca3af" },
      "focus": { "$value": "#2563eb" }
    }
  },
  "dimension": {
    "$type": "dimension",
    "space": {
      "xs": { "$value": "4px" },
      "sm": { "$value": "8px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "24px" },
      "xl": { "$value": "32px" },
      "xxl": { "$value": "48px" }
    },
    "border": {
      "radius-sm": { "$value": "4px" },
      "radius-md": { "$value": "8px" },
      "radius-lg": { "$value": "12px" },
      "width": { "$value": "1px" }
    },
    "target": {
      "minimum": { "$value": "44px", "$description": "WCAG 2.2 AA minimum touch target" }
    }
  },
  "typography": {
    "$type": "typography",
    "font": {
      "latin": {
        "family": { "$value": "Inter", "$description": "Primary Latin typeface" },
        "fallback": { "$value": "system-ui, -apple-system, sans-serif" }
      },
      "bengali": {
        "family": { "$value": "Noto Sans Bengali", "$description": "Bengali typeface (TR-07, UX-007)" },
        "fallback": { "$value": "'Hind Siliguri', 'SolaimanLipi', sans-serif" }
      },
      "mono": {
        "family": { "$value": "JetBrains Mono", "$description": "Code/reference numbers" }
      }
    },
    "size": {
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "14px", "$type": "dimension" },
      "md": { "$value": "16px", "$type": "dimension" },
      "lg": { "$value": "18px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" },
      "xxl": { "$value": "32px", "$type": "dimension" }
    },
    "weight": {
      "normal": { "$value": "400", "$type": "fontWeight" },
      "medium": { "$value": "500", "$type": "fontWeight" },
      "bold": { "$value": "700", "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight": { "$value": "1.2", "$type": "number" },
      "normal": { "$value": "1.5", "$type": "number" },
      "loose": { "$value": "1.8", "$type": "number", "$description": "Bengali text requires more leading (UX-007)" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px rgba(0,0,0,0.05)" },
    "md": { "$value": "0 4px 6px rgba(0,0,0,0.1)" },
    "lg": { "$value": "0 10px 15px rgba(0,0,0,0.15)" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px", "$description": "Mobile" },
    "md": { "$value": "768px", "$description": "Tablet" },
    "lg": { "$value": "1024px", "$description": "Desktop" },
    "xl": { "$value": "1280px", "$description": "Wide desktop" }
  }
}
