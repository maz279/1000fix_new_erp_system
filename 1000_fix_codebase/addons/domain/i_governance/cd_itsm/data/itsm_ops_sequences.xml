<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_fix_itsm_change" model="ir.sequence">
            <field name="name">IT Change Request</field>
            <field name="code">fix.itsm.change</field>
            <field name="prefix">CHG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_project_gate" model="ir.sequence">
            <field name="name">Stage-Gate Review</field>
            <field name="code">fix.project.gate</field>
            <field name="prefix">GATE/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
