<?xml version="1.0" encoding="utf-8"?>
<!--
  A10 deep audit (2026-11-22, A1-F03): the M23 clocks. Nothing watched a
  certificate's valid_until — for a company whose credential IS the ISO
  certificate, a lapse would have gone unnoticed until a customer asked.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_qms_cert_surveillance" model="ir.cron">
            <field name="name">M23: certification surveillance clock (90/30-day windows + lapse)</field>
            <field name="model_id" ref="model_fix_qms_certification"/>
            <field name="state">code</field>
            <field name="code">model.cron_certification_surveillance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
