<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_fix_qms_copq" model="ir.sequence">
            <field name="name">Cost of Poor Quality</field>
            <field name="code">fix.qms.copq</field>
            <field name="prefix">COPQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_ncr_code" model="ir.sequence">
            <field name="name">Quality NCR</field>
            <field name="code">fix.ncr</field>
            <field name="prefix">NCR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
