<?xml version="1.0" encoding="utf-8"?>
<!--
  A12 audit (2026-11-04) R3 / M67-11: cd_ppm shipped no ir.cron record, so
  the overdue-milestone flag and the overdue-risk escalation never ran
  (FF-48: a cron method without an ir.cron record never runs).
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_ppm_overdue_milestones" model="ir.cron">
            <field name="name">M67: flag overdue project milestones</field>
            <field name="model_id" ref="model_fix_project_milestone"/>
            <field name="state">code</field>
            <field name="code">model.cron_flag_overdue_milestones()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_ppm_overdue_risks" model="ir.cron">
            <field name="name">M67: escalate overdue project risks</field>
            <field name="model_id" ref="model_fix_project_risk"/>
            <field name="state">code</field>
            <field name="code">model.cron_escalate_overdue_risks()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
