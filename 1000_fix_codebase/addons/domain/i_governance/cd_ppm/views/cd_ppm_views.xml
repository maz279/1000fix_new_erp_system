<?xml version="1.0" encoding="utf-8"?>
<!-- cd_ppm views (P10 / M67). -->
<odoo>
    <record id="view_fix_project_list" model="ir.ui.view">
        <field name="name">fix.project.list</field>
        <field name="model">fix.project</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'" decoration-info="state == 'active'">
                <field name="code"/>
                <field name="name"/>
                <field name="project_type"/>
                <field name="manager_id"/>
                <field name="budget"/>
                <field name="actual_cost"/>
                <field name="budget_variance"/>
                <field name="progress_pct"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fix_project_form" model="ir.ui.view">
        <field name="name">fix.project.form</field>
        <field name="model">fix.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete Project" type="object" class="btn-success" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3><field name="code"/></h3>
                    </div>
                    <group>
                        <group string="Project Details">
                            <field name="project_type"/>
                            <field name="manager_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="operating_unit_id"/>
                        </group>
                        <group string="Budget &amp; Progress">
                            <field name="currency_id"/>
                            <field name="budget"/>
                            <field name="actual_cost"/>
                            <field name="budget_variance"/>
                            <field name="variance_pct"/>
                            <field name="progress_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Milestones" name="milestones">
                            <field name="milestone_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="milestone_id"/>
                                    <field name="assigned_to"/>
                                    <field name="planned_hours"/>
                                    <field name="actual_hours"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_project" model="ir.actions.act_window">
        <field name="name">Projects &amp; Programs</field>
        <field name="res_model">fix.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Task Views -->
    <record id="view_fix_project_task_list" model="ir.ui.view">
        <field name="name">fix.project.task.list</field>
        <field name="model">fix.project.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="milestone_id"/>
                <field name="assigned_to"/>
                <field name="planned_hours"/>
                <field name="actual_hours"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_fix_project_task" model="ir.actions.act_window">
        <field name="name">Project Tasks</field>
        <field name="res_model">fix.project.task</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Milestone Views -->
    <record id="view_fix_project_milestone_list" model="ir.ui.view">
        <field name="name">fix.project.milestone.list</field>
        <field name="model">fix.project.milestone</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_fix_project_milestone" model="ir.actions.act_window">
        <field name="name">Project Milestones</field>
        <field name="res_model">fix.project.milestone</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_ppm_root" name="Project &amp; Portfolio (PPM)" parent="cd_entity_config.menu_fix_operations_root" sequence="340"/>
    <menuitem id="menu_fix_project" name="Projects" parent="menu_fix_ppm_root" action="action_fix_project" sequence="10"/>
    <menuitem id="menu_fix_project_milestone" name="Milestones" parent="menu_fix_ppm_root" action="action_fix_project_milestone" sequence="20"/>
    <menuitem id="menu_fix_project_task" name="Tasks" parent="menu_fix_ppm_root" action="action_fix_project_task" sequence="30"/>
</odoo>
