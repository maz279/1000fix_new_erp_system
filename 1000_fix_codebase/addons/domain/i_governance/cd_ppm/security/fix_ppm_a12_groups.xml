<?xml version="1.0" encoding="utf-8"?>
<!--
  A12 audit (2026-11-04) M67: cd_ppm shipped no group at all and its ACL
  gave every internal user write on projects, billing and risks — the
  project manager raised his own budget, anyone closed a severity-9 risk.

  - Project manager: runs projects (create/submit/work). Budget approval is
    still routed by M63+DOFA to a tier holder who is not the PM.
  - Sponsor: approves budgets/gates. Ships EMPTY: who sponsors a project is
    a business appointment (report §7).
  - base.group_user keeps READ (portfolio visibility), never write.
-->
<odoo>
    <data noupdate="1">

        <record id="privilege_fix_ppm" model="res.groups.privilege">
            <field name="name">Project, Program &amp; Portfolio Management</field>
            <field name="description">Project delivery and governance roles of M67.</field>
            <field name="sequence">63</field>
        </record>

        <record id="group_ppm_project_manager" model="res.groups">
            <field name="name">Project Manager</field>
            <field name="privilege_id" ref="privilege_fix_ppm"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Runs projects: milestones, tasks, templates, billing and risks. Never approves their own budget or gates (M63/DOFA routing excludes the PM).</field>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_ppm_sponsor" model="res.groups">
            <field name="name">Project Sponsor</field>
            <field name="privilege_id" ref="privilege_fix_ppm"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Accepts milestones and approves project budgets (writes fix.project to stamp the DOFA approval the M63 inbox routed to them). Ships EMPTY: sponsorship is a business appointment (S7).</field>
        </record>

    </data>
</odoo>
