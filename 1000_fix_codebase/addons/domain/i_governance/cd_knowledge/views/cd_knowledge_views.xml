<?xml version="1.0" encoding="utf-8"?>
<!-- cd_knowledge views (P09 / M61 Knowledge & Technical Library). -->
<odoo>
    <record id="view_fix_knowledge_article_list" model="ir.ui.view">
        <field name="name">fix.knowledge.article.list</field>
        <field name="model">fix.knowledge.article</field>
        <field name="arch" type="xml">
            <list>
                <field name="article_code"/>
                <field name="name"/>
                <field name="title_bn"/>
                <field name="category"/>
                <field name="device_brand"/>
                <field name="device_model"/>
                <field name="rework_level"/>
                <field name="offline_available"/>
                <field name="version"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_fix_knowledge_article_form" model="ir.ui.view">
        <field name="name">fix.knowledge.article.form</field>
        <field name="model">fix.knowledge.article</field>
        <field name="arch" type="xml">
            <form string="Knowledge Article &amp; Technical Manual">
                <header>
                    <button name="action_publish" string="Publish / Increment Version" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Article Title"/>
                        <h1><field name="name" placeholder="e.g. Dell Latitude 7420 No-Power Power-Rail Diagnostic"/></h1>
                        <h3><field name="title_bn" placeholder="বাংলা শিরোনাম..."/></h3>
                    </div>
                    <group>
                        <group string="Categorisation &amp; Hardware">
                            <field name="article_code"/>
                            <field name="category"/>
                            <field name="device_brand"/>
                            <field name="device_model"/>
                            <field name="fault_symptom"/>
                            <field name="rework_level"/>
                        </group>
                        <group string="P02 Offline Sync &amp; Meta">
                            <field name="offline_available"/>
                            <field name="version"/>
                            <field name="content_hash"/>
                            <field name="tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="operating_unit_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="English Documentation">
                            <field name="content" widget="html"/>
                        </page>
                        <page string="Bengali Documentation (বাংলা)">
                            <field name="content_bn" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_fix_knowledge_article" model="ir.actions.act_window">
        <field name="name">Technical Knowledge Library</field>
        <field name="res_model">fix.knowledge.article</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_knowledge_article" name="Technical Knowledge Library" parent="cd_entity_config.menu_fix_operations_root" action="action_fix_knowledge_article" sequence="200"/>
</odoo>
