<?xml version="1.0" encoding="utf-8"?>
<!-- A10 role group (K1 / M61-2, 2026-11-05; workflow audit P0).

     Before this group any employee could publish any article: safety-
     critical technical content (electrical, battery, high-voltage work
     that a technician follows in the field) reached devices with no
     review at all (A10_Workflow_and_Approval_Report §6 K1, M61-1/-2).

     The dev admin is a member so daily work keeps running. Appointing
     the real holders is business decision B1 (report §7). -->
<odoo>
    <data noupdate="1">

        <record id="privilege_knowledge" model="res.groups.privilege">
            <field name="name">Knowledge &amp; Technical Library</field>
            <field name="description">Publishing reviewed technical content to the field (M61, ISO 9001 7.5).</field>
            <field name="sequence">61</field>
        </record>

        <record id="group_knowledge_publisher" model="res.groups">
            <field name="name">Knowledge Publisher</field>
            <field name="privilege_id" ref="privilege_knowledge"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Publishes articles, trees and bulletins. Safety-critical content additionally requires a reviewer from this group who is not the author (A10 K1).</field>
        </record>

    </data>
</odoo>
