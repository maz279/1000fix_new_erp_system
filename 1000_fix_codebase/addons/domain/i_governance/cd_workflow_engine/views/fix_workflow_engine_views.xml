<?xml version="1.0" encoding="utf-8"?>
<!-- cd_workflow_engine views — the automation register (Administration workspace). -->
<odoo>

    <record id="view_fix_automation_tree" model="ir.ui.view">
        <field name="name">fix.automation.tree</field>
        <field name="model">fix.automation</field>
        <field name="arch" type="xml">
            <tree decoration-info="engine == 'airflow'" decoration-warning="engine == 'domain_service'">
                <field name="code"/>
                <field name="trigger"/>
                <field name="engine" widget="badge"/>
                <field name="engine_ref" optional="show"/>
                <field name="failure_policy" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_fix_automation_form" model="ir.ui.view">
        <field name="name">fix.automation.form</field>
        <field name="model">fix.automation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="code" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="trigger"/>
                            <field name="engine"/>
                            <field name="engine_ref"/>
                        </group>
                        <group>
                            <field name="failure_policy"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="action"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fix_approval_matrix_tree" model="ir.ui.view">
        <field name="name">fix.approval.matrix.tree</field>
        <field name="model">fix.approval.matrix</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="decision_domain"/>
                <field name="currency_id" invisible="1"/>
                <field name="threshold"/>
                <field name="approver_role"/>
                <field name="notes" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_fix_automation" model="ir.actions.act_window">
        <field name="name">Automation Register</field>
        <field name="res_model">fix.automation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_fix_approval_matrix" model="ir.actions.act_window">
        <field name="name">Approval Matrix</field>
        <field name="res_model">fix.approval.matrix</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_fix_automation" name="Automation Register"
              parent="cd_rbac_ext.menu_ws_administration"
              action="action_fix_automation" sequence="30"/>
    <menuitem id="menu_fix_approval_matrix" name="Approval Matrix"
              parent="cd_rbac_ext.menu_ws_administration"
              action="action_fix_approval_matrix" sequence="40"/>

</odoo>
