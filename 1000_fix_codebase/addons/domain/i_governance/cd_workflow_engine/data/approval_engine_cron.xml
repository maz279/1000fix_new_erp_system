<?xml version="1.0" encoding="utf-8"?>
<!--
  M63 approval engine (A03 audit R7): overdue requests are reminded, then
  escalated to the next tier, then given their rule's final action. Without
  this record the escalation method would never run.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_approval_escalate_overdue" model="ir.cron">
            <field name="name">M63: remind and escalate overdue approvals</field>
            <field name="model_id" ref="model_fix_approval_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_escalate_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
