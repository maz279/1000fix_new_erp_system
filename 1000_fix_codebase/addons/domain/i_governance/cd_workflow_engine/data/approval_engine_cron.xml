<?xml version="1.0" encoding="utf-8"?>
<!--
  M63 approval engine (A03 audit R7): overdue requests are reminded, then
  escalated to the next tier, then given their rule's final action. Without
  this record the escalation method would never run.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_approval_escalate_overdue" model="ir.cron">
            <field name="name">M63: remind and escalate overdue approvals</field>
            <field name="model_id" ref="model_fix_approval_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_escalate_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <!--
          A11 audit E2 (M63-5): an approval substitution past its end date
          expires, and the open tasks routed through it go back to the absent
          approver. On fix_dev one substitution stayed "active" a day after it
          ended, because nothing ever expired one.
        -->
        <record id="ir_cron_approval_substitution_expire" model="ir.cron">
            <field name="name">M63: expire ended approval substitutions</field>
            <field name="model_id" ref="model_fix_approval_substitution"/>
            <field name="state">code</field>
            <field name="code">model.cron_expire_substitutions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!--
          A11 audit F08: the keep-pending expiry is no longer silent. Every
          escalation has run out and the request is still open; the engine
          publishes approval.expired, and this subscription delivers the last
          warning as a to-do for the requester plus a chatter note on the
          record. It lives in this already-listed data file (a dedicated file
          would need a manifest data entry, which this fix may not add).
        -->
        <record id="consumer_approval_expired_last_warning" model="fix.event.consumer">
            <field name="name">M63: last warning when an approval expires still pending</field>
            <field name="event_type">approval.expired</field>
            <field name="model">fix.approval.request</field>
            <field name="method">consume_approval_expired</field>
            <field name="module">cd_workflow_engine</field>
        </record>
    </data>
</odoo>
