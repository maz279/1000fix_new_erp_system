<?xml version="1.0" encoding="utf-8"?>
<!-- cd_competency views — M22 (P08-M05). -->
<odoo>
    <record id="view_fix_competency_list" model="ir.ui.view">
        <field name="name">fix.competency.list</field>
        <field name="model">fix.competency</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="device_type"/>
                <field name="required_for_dispatch"/>
            </list>
        </field>
    </record>

    <record id="action_fix_competency" model="ir.actions.act_window">
        <field name="name">Competencies</field>
        <field name="res_model">fix.competency</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fix_certification_list" model="ir.ui.view">
        <field name="name">fix.certification.list</field>
        <field name="model">fix.certification</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="competency_id"/>
                <field name="issued_on"/>
                <field name="expires_on"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_fix_certification_form" model="ir.ui.view">
        <field name="name">fix.certification.form</field>
        <field name="model">fix.certification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_grant" type="object" string="Grant"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="competency_id"/>
                        </group>
                        <group>
                            <field name="issued_on"/>
                            <field name="expires_on"/>
                            <field name="evidence_ref"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_certification" model="ir.actions.act_window">
        <field name="name">Certifications</field>
        <field name="res_model">fix.certification</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fix_training_course_list" model="ir.ui.view">
        <field name="name">fix.training.course.list</field>
        <field name="model">fix.training.course</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="competency_id"/>
            </list>
        </field>
    </record>

    <record id="action_fix_training_course" model="ir.actions.act_window">
        <field name="name">Training Courses</field>
        <field name="res_model">fix.training.course</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_competency" name="Competencies"
              parent="cd_hr_core.menu_ws_people"
              action="action_fix_competency" sequence="70"/>
    <menuitem id="menu_fix_certification" name="Certifications"
              parent="cd_hr_core.menu_ws_people"
              action="action_fix_certification" sequence="80"/>
    <menuitem id="menu_fix_training" name="Training"
              parent="cd_hr_core.menu_ws_people"
              action="action_fix_training_course" sequence="90"/>
</odoo>
