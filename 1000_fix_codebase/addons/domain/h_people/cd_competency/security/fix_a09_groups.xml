<?xml version="1.0" encoding="utf-8"?>
<!-- cd_competency privilege model (RAP X-02, A09 zero-trust re-audit 2026-10-30).

     Every transactional model of this module granted write+create to
     base.group_user, so any internal user could write the records that other
     controls depend on. RAP X-02's target is that no A09 model is writable by
     base.group_user except a named self-service surface.

     Write now belongs to Training &amp; Certification Manager; plain internal users keep read.
     Loaded BEFORE ir.model.access.csv so the CSV can reference the group. -->
<odoo>
    <record id="privilege_training" model="res.groups.privilege">
        <field name="name">Learning &amp; Certification</field>
        <field name="description">1000FiX A09 — Learning &amp; Certification.</field>
        <field name="sequence">63</field>
    </record>

    <record id="group_training" model="res.groups">
        <field name="name">Training &amp; Certification Manager</field>
        <field name="privilege_id" ref="privilege_training"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Grants competencies and certifications and maintains the device taxonomy.</field>
        <!-- the back office keeps working: the administrator holds the role -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- A09 workflow audit M22-F3/F4/F6 (build brief §6.11): the operational
         role prepared AND decided certifications, waivers and ISO evidence.
         The deciders are separate roles. Holders are a business decision
         (A09 report §7.1): superuser and administrator only until appointed;
         the engine never routes a decision to its requester, its preparer or
         the technician it is about. -->
    <record id="group_certification_verifier" model="res.groups">
        <field name="name">Certification &amp; Evidence Verifier</field>
        <field name="privilege_id" ref="privilege_training"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Decides routed certification grants (BRU-LMS-04/06), reinstates suspended certificates and accepts ISO / brand audit evidence. Never for their own or for what they prepared.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_dispatch_override" model="res.groups">
        <field name="name">Certification Override Approver</field>
        <field name="privilege_id" ref="privilege_training"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Decides routed certification waivers: one technician on one job, with a reason (BRU-LMS-02, FR-LMS-040). The spec's Operations Director authority.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- an HR Manager inherits the role, so existing manager accounts are
         unaffected by the tightening -->
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('cd_competency.group_training'))]"/>
    </record>
</odoo>
