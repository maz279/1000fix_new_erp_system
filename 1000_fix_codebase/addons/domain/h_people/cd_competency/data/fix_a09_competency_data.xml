<?xml version="1.0" encoding="utf-8"?>
<!-- A09 audit M22-08 / report C5: no ir.cron existed for any M22 model, so no
     expiry alert, no renewal task and no lapse ever ran. -->
<odoo>
    <record id="ir_cron_certification_expiry" model="ir.cron">
        <field name="name">M22: lapse expired certifications and raise expiry alerts</field>
        <field name="model_id" ref="model_fix_certification"/>
        <field name="state">code</field>
        <field name="code">model._cron_certification_expiry()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <data noupdate="1">
        <record id="seq_fix_certification_waiver" model="ir.sequence">
            <field name="name">Certification Waiver</field>
            <field name="code">fix.certification.waiver</field>
            <field name="prefix">CWV/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
