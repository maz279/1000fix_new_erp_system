<?xml version="1.0" encoding="utf-8"?>
<!-- cd_attendance privilege model (RAP X-02, A09 zero-trust re-audit 2026-10-30).

     Every transactional model of this module granted write+create to
     base.group_user, so any internal user could write the records that other
     controls depend on. RAP X-02's target is that no A09 model is writable by
     base.group_user except a named self-service surface.

     Write now belongs to Attendance Supervisor; plain internal users keep read.
     Loaded BEFORE ir.model.access.csv so the CSV can reference the group. -->
<odoo>
    <record id="privilege_attendance_supervisor" model="res.groups.privilege">
        <field name="name">Time &amp; Attendance</field>
        <field name="description">1000FiX A09 — Time &amp; Attendance.</field>
        <field name="sequence">62</field>
    </record>

    <record id="group_attendance_supervisor" model="res.groups">
        <field name="name">Attendance Supervisor</field>
        <field name="privilege_id" ref="privilege_attendance_supervisor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Maintains rosters, shift templates, holidays, on-call and biometric terminals.</field>
        <!-- the back office keeps working: the administrator holds the role -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- SOD-28 (A09 audit M55-6/M55-9): the supervisor who maintains rosters and
         devices and locks the month does not also re-open it. Re-opening a
         locked period is this separate role's, with a reason, and never once
         payroll has taken the period. Holders are a business decision: the
         administrator only. -->
    <record id="group_attendance_lock_manager" model="res.groups">
        <field name="name">Attendance Lock Manager</field>
        <field name="privilege_id" ref="privilege_attendance_supervisor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Re-opens a locked attendance period, with a reason, before payroll has taken it.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- an HR Manager inherits the role, so existing manager accounts are
         unaffected by the tightening -->
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('cd_attendance.group_attendance_supervisor'))]"/>
    </record>
</odoo>
