<?xml version="1.0" encoding="utf-8"?>
<!-- A09 audit M55-13 / C5: 0 crons on the M55 models. -->
<odoo>
    <!-- AUT-WFM-05: every pending attendance record reaches a decider's inbox
         (idempotent; the M63 engine's own cron escalates overdue tasks) -->
    <record id="cron_route_pending_attendance" model="ir.cron">
        <field name="name">M55: route pending attendance for a decision</field>
        <field name="model_id" ref="model_fix_attendance_record"/>
        <field name="state">code</field>
        <field name="code">model.cron_route_pending_attendance()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <!-- upgrade: payable overtime is the APPROVED part (BRU-WFM-02), valued per
         employee-day; records in locked periods keep their figures -->
    <function model="fix.attendance.record" name="_fix_revalue_open_periods"/>
</odoo>
