        <!-- X-F10: M24 archival of what payroll issues -->
        <record id="consumer_payslips_published_archive" model="fix.event.consumer">
            <field name="name">M56: published payslips are archived as employee documents (M24)</field>
            <field name="event_type">payroll.payslips_published</field>
            <field name="model">fix.statutory.pack</field>
            <field name="method">consume_payslips_published</field>
            <field name="module">cd_payroll_bd</field>
        </record>
        <record id="consumer_certificate_issued_archive" model="fix.event.consumer">
            <field name="name">M56: issued salary/tax certificates are archived as employee documents (M24)</field>
            <field name="event_type">payroll.certificate_issued</field>
            <field name="model">fix.statutory.pack</field>
            <field name="method">consume_certificate_issued</field>
            <field name="module">cd_payroll_bd</field>
        </record>
    </data>
</odoo>
