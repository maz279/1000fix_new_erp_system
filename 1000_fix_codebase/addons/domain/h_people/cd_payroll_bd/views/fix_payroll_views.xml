                            <field name="payroll_pf_payable_account_id"/>
                            <field name="payroll_wppf_expense_account_id"/>
                            <field name="payroll_wppf_payable_account_id"/>
                        </group>
                        <group string="Off-Cycle / Bonus Originating Account">
                            <field name="payroll_beftn_account_no"/>
                            <field name="payroll_beftn_routing_no"/>
                        </group>
                        <group string="Statutory Decisions (A09 report 7.3 / 7.4)">
