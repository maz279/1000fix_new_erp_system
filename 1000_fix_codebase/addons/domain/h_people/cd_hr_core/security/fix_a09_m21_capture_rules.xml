<?xml version="1.0" encoding="utf-8"?>
<!-- M21 capture audit 2026-11-17: company isolation (AS-03) for the two
     records the audit added. Neither carries an operating unit: the
     acknowledgement and the exit interview follow their employee.
       * fix.hr.notice.ack - the employment privacy-notice acknowledgement
       * fix.hr.exit.interview - the structured exit interview -->
<odoo>
    <record id="rule_fix_hr_notice_ack_company" model="ir.rule">
        <field name="name">fix.hr.notice.ack: allowed companies</field>
        <field name="model_id" ref="model_fix_hr_notice_ack"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_hr_exit_interview_company" model="ir.rule">
        <field name="name">fix.hr.exit.interview: allowed companies</field>
        <field name="model_id" ref="model_fix_hr_exit_interview"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
