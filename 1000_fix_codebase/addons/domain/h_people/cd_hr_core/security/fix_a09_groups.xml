<?xml version="1.0" encoding="utf-8"?>
<!-- cd_hr_core privilege model (RAP X-02, A09 zero-trust re-audit 2026-10-30).

     Every transactional model of this module granted write+create to
     base.group_user, so any internal user could write the records that other
     controls depend on. RAP X-02's target is that no A09 model is writable by
     base.group_user except a named self-service surface.

     Write now belongs to HR Officer; plain internal users keep read.
     Loaded BEFORE ir.model.access.csv so the CSV can reference the group. -->
<odoo>
    <record id="privilege_hr_officer" model="res.groups.privilege">
        <field name="name">Core HR &amp; Lifecycle</field>
        <field name="description">1000FiX A09 — Core HR &amp; Lifecycle.</field>
        <field name="sequence">61</field>
    </record>

    <record id="group_hr_officer" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="privilege_id" ref="privilege_hr_officer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Maintains positions, transfers, exits, employee documents and leave policy.</field>
        <!-- the back office keeps working: the administrator holds the role -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- an HR Manager inherits the role, so existing manager accounts are
         unaffected by the tightening -->
    <record id="hr.group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('cd_hr_core.group_hr_officer'))]"/>
    </record>
</odoo>
