<?xml version="1.0" encoding="utf-8"?>
<!-- M58 automation (A09 workflow audit C5 / P10: 0 crons on any talent model).
     Each method is idempotent and runs as superuser. The settings below are
     business decisions (A09 report section 7): their values keep today's
     behaviour or come from the M58 specification, and are listed as
     decisions in the build report. -->
<odoo>
    <data noupdate="1">
        <!-- AUT-TAO-11: "7 days before start date" (M58 spec). -->
        <record id="param_readiness_lead_days" model="ir.config_parameter">
            <field name="key">cd_talent.readiness_lead_days</field>
            <field name="value">7</field>
        </record>
        <!-- BRU-TAO-14 / T-03: the retention period is "configurable" and no
             repository source states it. 0 = no automatic erasure, which is
             what the code did before this change. -->
        <record id="param_candidate_retention_days" model="ir.config_parameter">
            <field name="key">cd_talent.candidate_retention_days</field>
            <field name="value">0</field>
        </record>
        <!-- BRU-TAO-17 / BLA 2006 s.2(63) and s.34: no child (under 14) is
             employed. Whether 1000FiX hires adolescents (14-18) at all is for
             labour counsel. -->
        <record id="param_minimum_hiring_age" model="ir.config_parameter">
            <field name="key">cd_talent.minimum_hiring_age</field>
            <field name="value">14</field>
        </record>
        <!-- BRU-TAO-01 (round 2): 0 = a requisition whose scope has no approved
             headcount budget is not blocked (today's behaviour; budgets are
             new). 1 = no budget, no requisition. A budget that exists is
             always enforced. -->
        <record id="param_require_headcount_budget" model="ir.config_parameter">
            <field name="key">cd_talent.require_headcount_budget</field>
            <field name="value">0</field>
        </record>
        <!-- M58-F15: how many days an offer stays open for acceptance - the
             default validity of a new offer. No repository source states the
             figure (OWNER decision). 0 = no default: the validity date is
             entered on each offer, and an offer without one cannot be issued
             (an undated offer never lapsed and blocked the candidate). -->
        <record id="param_offer_validity_days" model="ir.config_parameter">
            <field name="key">cd_talent.offer_validity_days</field>
            <field name="value">0</field>
        </record>
    </data>

    <!-- the identity hash key shared with M21 (created once, never replaced) -->
    <function model="fix.candidate" name="_fix_ensure_identity_hash_key"/>

    <record id="cron_talent_identity_move" model="ir.cron">
        <field name="name">M58: Move clear candidate identifiers into the residency store</field>
        <field name="model_id" ref="model_fix_candidate"/>
        <field name="state">code</field>
        <field name="code">model.cron_identity_move_clear_values()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_talent_day_one_readiness" model="ir.cron">
        <field name="name">M58: Escalate day-one readiness before the start date</field>
        <field name="model_id" ref="model_fix_onboarding_plan"/>
        <field name="state">code</field>
        <field name="code">model.cron_escalate_day_one_readiness()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <!-- AUT-TAO-13 (round 2): owner on the due date, hiring manager / HR once overdue -->
    <record id="cron_talent_onboarding_task_alerts" model="ir.cron">
        <field name="name">M58: Notify and escalate onboarding tasks at and past their due date</field>
        <field name="model_id" ref="model_fix_onboarding_task"/>
        <field name="state">code</field>
        <field name="code">model.cron_notify_due_tasks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_talent_expire_offers" model="ir.cron">
        <field name="name">M58: Expire issued offers past their validity</field>
        <field name="model_id" ref="model_fix_talent_offer"/>
        <field name="state">code</field>
        <field name="code">model.cron_expire_offers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_talent_erase_candidates" model="ir.cron">
        <field name="name">M58: Anonymise candidates past their retention date</field>
        <field name="model_id" ref="model_fix_candidate"/>
        <field name="state">code</field>
        <field name="code">model.cron_erase_expired_candidates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
