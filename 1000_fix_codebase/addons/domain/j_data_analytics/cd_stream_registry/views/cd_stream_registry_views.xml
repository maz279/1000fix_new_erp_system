    <record id="view_fix_iot_telemetry_list" model="ir.ui.view">
        <field name="name">fix.iot.telemetry.list</field>
        <field name="model">fix.iot.telemetry</field>
        <field name="arch" type="xml">
            <list><field name="company_id"/></list>
        </field>
    </record>
    <record id="action_fix_iot_telemetry" model="ir.actions.act_window">
        <field name="name">Iot Telemetry</field>
        <field name="res_model">fix.iot.telemetry</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_fix_iot_alert_list" model="ir.ui.view">
