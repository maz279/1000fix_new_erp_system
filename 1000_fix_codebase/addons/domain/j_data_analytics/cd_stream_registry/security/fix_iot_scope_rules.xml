<?xml version="1.0" encoding="utf-8"?>
<!-- A07 P1 (2026-11-04) M48-9: six M48 models (streams, adapters, rules,
     downsampling policies, prescriptive actions, consents) had no company and
     no record rule, so any internal user in any company read and edited every
     consent, rule and action (BRU-IOT-17). Each now carries a company (its
     own, or its parent's) and is fenced to the user's allowed companies, as
     the generated fix_isolation_rules.xml does for the other four. The new
     platform records (gaps, aggregates, retention changes) are fenced too.
     An adapter with no company is shared protocol configuration. -->
<odoo>
    <record id="rule_fix_iot_stream_company" model="ir.rule">
        <field name="name">fix.iot.stream: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_stream"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_adapter_company" model="ir.rule">
        <field name="name">fix.iot.adapter: allowed companies (or shared)</field>
        <field name="model_id" ref="model_fix_iot_adapter"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_rule_company" model="ir.rule">
        <field name="name">fix.iot.rule: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_downsample_company" model="ir.rule">
        <field name="name">fix.iot.downsample: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_downsample"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_action_company" model="ir.rule">
        <field name="name">fix.iot.action: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_action"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_consent_company" model="ir.rule">
        <field name="name">fix.iot.consent: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_consent"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_retention_change_company" model="ir.rule">
        <field name="name">fix.iot.retention.change: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_retention_change"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_gap_company" model="ir.rule">
        <field name="name">fix.iot.gap: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_gap"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_telemetry_rollup_company" model="ir.rule">
        <field name="name">fix.iot.telemetry.rollup: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_telemetry_rollup"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!-- M48 capture audit (2026-11-17): the new registers carry a company
         (their own, or their parent's) and are fenced like the rest. -->
    <record id="rule_fix_iot_signal_company" model="ir.rule">
        <field name="name">fix.iot.signal: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_signal"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_monitoring_scope_company" model="ir.rule">
        <field name="name">fix.iot.monitoring.scope: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_monitoring_scope"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_health_company" model="ir.rule">
        <field name="name">fix.iot.health: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_health"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_file_batch_company" model="ir.rule">
        <field name="name">fix.iot.file.batch: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_file_batch"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_maintenance_window_company" model="ir.rule">
        <field name="name">fix.iot.maintenance.window: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_maintenance_window"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_iot_action_part_company" model="ir.rule">
        <field name="name">fix.iot.action.part: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_action_part"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!-- A07 ERP audit (2026-11-20) D17(b): the hourly / daily tiers. -->
    <record id="rule_fix_iot_telemetry_aggregate_company" model="ir.rule">
        <field name="name">fix.iot.telemetry.aggregate: allowed companies</field>
        <field name="model_id" ref="model_fix_iot_telemetry_aggregate"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!-- M48-23 / BRU-IOT-18: a location series is a person's whereabouts. Global
         rule (ANDed with the company/OU rules): only the IoT roles read it. -->
    <record id="rule_fix_iot_telemetry_location" model="ir.rule">
        <field name="name">fix.iot.telemetry: location readings for the IoT roles only</field>
        <field name="model_id" ref="model_fix_iot_telemetry"/>
        <field name="domain_force">[(1, '=', 1)] if (user.has_group('cd_stream_registry.group_iot_operator') or user.has_group('cd_stream_registry.group_iot_consent_officer')) else [('is_location', '=', False)]</field>
    </record>
</odoo>
