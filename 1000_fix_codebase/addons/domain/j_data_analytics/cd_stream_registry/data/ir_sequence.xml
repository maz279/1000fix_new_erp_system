            <field name="prefix">ICNS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_iot_alert" model="ir.sequence">
            <field name="name">IoT Alert</field>
            <field name="code">fix.iot.alert</field>
            <field name="prefix">IOT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
