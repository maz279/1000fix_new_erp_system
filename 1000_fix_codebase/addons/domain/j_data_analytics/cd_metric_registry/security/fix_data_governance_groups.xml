<?xml version="1.0" encoding="utf-8"?>
<!--
  M62 governance owner (A11 audit G1-G6, findings M62-1..M62-9).

  The catalogue, lineage, quality rules, contracts, metric versions and
  retention policies were writable by every internal user: anyone cut a
  retention period 84 -> 1 month, rewrote an active data contract in place,
  downgraded a residency classification and closed their own incident.

  - Data Governance Officer: the only role that writes the governance rule
    book (entities, lineage, quality rules, contracts, metric definitions,
    versions, retention policies, declassification authorisations) and the
    deciding group the approval engine routes data-contract activations,
    metric publications, retention shortenings and declassification
    authorisations to. Everyone else keeps read access.

  Who governs the data estate is a business decision (A11 report section 7).
  The group therefore carries only the development admin so the workspace
  keeps working on development databases; production appoints its members.
-->
<odoo>
    <data noupdate="1">

        <record id="privilege_fix_data_governance" model="res.groups.privilege">
            <field name="name">Data Governance</field>
            <field name="description">Who may govern the data estate (M62).</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_data_governance_officer" model="res.groups">
            <field name="name">Data Governance Officer</field>
            <field name="privilege_id" ref="privilege_fix_data_governance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Owns the M62 rule book: the data catalogue and its classifications, lineage, quality rules, data contracts (co-signature with the producer), metric definitions and versions, retention policies and declassification authorisations. Runs dispositions and closes incidents. Members are appointed by the business.</field>
        </record>

    </data>
</odoo>
