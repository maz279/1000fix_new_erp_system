<?xml version="1.0" encoding="utf-8"?>
<!--
  M15 Spare Parts & Inventory + M41 Warehouse roles (A06 audit 2026-11-03,
  M15-2 and M41-8; remediation S1).

  Both addons shipped only base.group_user ACL rows, so every employee was the
  store keeper, the warehouse operative, the inventory manager and the CFO.
  The groups live here (cd_wms_structure loads before cd_inventory) so both
  addons can grant them.

  - Storekeeper: receives goods (inspection gate), issues and returns parts,
    raises transfers, counts, van reconciliations, quarantines, RTVs,
    ownership-class change requests, and maintains reorder rules.
  - Warehouse Operator: runs the M41 floor: put-away, wave release / pick /
    pack / stage / ship, cartons, staging, RF tasks, floor counts, docks and
    bin blocking.
  - Inventory Controller: implies both and is the second person on every
    inventory approval: count variances outside tolerance, write-offs and
    scrap, van variances, transfers, ownership-class changes, RTVs, standard
    cost and part status changes, and bin unblocking. The code refuses a
    controller who requested, counted, quarantined or blocked the record.

  The two operational groups carry the development admin so the workspace
  keeps working; segregation of duties still applies to it. The Inventory
  Controller group ships EMPTY: who approves is a business appointment.
-->
<odoo>
    <data noupdate="1">

        <record id="privilege_fix_inventory" model="res.groups.privilege">
            <field name="name">Spare Parts, Inventory &amp; Warehouse</field>
            <field name="description">Store, warehouse-floor and approval roles of the M15 and M41 modules.</field>
            <field name="sequence">42</field>
        </record>

        <record id="group_storekeeper" model="res.groups">
            <field name="name">Storekeeper</field>
            <field name="privilege_id" ref="privilege_fix_inventory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Receives and inspects goods, issues and returns parts, raises transfers, counts, van reconciliations, quarantines, RTVs and ownership-class change requests, and maintains reorder rules. Cannot approve what they raised or counted.</field>
        </record>

        <record id="group_warehouse_operator" model="res.groups">
            <field name="name">Warehouse Operator</field>
            <field name="privilege_id" ref="privilege_fix_inventory"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Runs the warehouse floor: put-away of received stock, wave release, pick, pack, stage and ship, cartons, staging, RF tasks, floor counts, dock appointments and bin blocking.</field>
        </record>

        <record id="group_inventory_controller" model="res.groups">
            <field name="name">Inventory Controller</field>
            <field name="privilege_id" ref="privilege_fix_inventory"/>
            <field name="implied_ids" eval="[(4, ref('group_storekeeper')), (4, ref('group_warehouse_operator'))]"/>
            <field name="comment">Approves count variances outside tolerance, write-offs and scrap, van variances, transfers, ownership-class changes, RTVs, standard-cost and part-status changes, and unblocks bins. Never on a record they requested, counted, quarantined or blocked.</field>
        </record>

    </data>
</odoo>
