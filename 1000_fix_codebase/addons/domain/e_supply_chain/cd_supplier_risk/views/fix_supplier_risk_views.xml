<?xml version="1.0" encoding="utf-8"?>
<!-- cd_supplier_risk views — supplier risk assessments. -->
<odoo>

    <record id="view_fix_supplier_risk_list" model="ir.ui.view">
        <field name="name">fix.supplier.risk.list</field>
        <field name="model">fix.supplier.risk</field>
        <field name="arch" type="xml">
            <list>
                <field name="profile_id"/>
                <field name="assessed_at"/>
                <field name="overall_tier" widget="badge"/>
                <field name="single_source_critical"/>
                <field name="next_assessment_due"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fix_supplier_risk_form" model="ir.ui.view">
        <field name="name">fix.supplier.risk.form</field>
        <field name="model">fix.supplier.risk</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state not in ('draft')"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state not in ('submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="assessed_at"/>
                            <field name="financial"/>
                            <field name="operational"/>
                            <field name="geographic"/>
                            <field name="compliance"/>
                            <field name="counterfeit"/>
                            <field name="continuity"/>
                        </group>
                        <group>
                            <field name="overall_tier"/>
                            <field name="next_assessment_due"/>
                            <field name="single_source_critical"/>
                            <field name="alternate_profile_id"/>
                            <field name="assessor_id"/>
                            <field name="company_id"/>
                            <field name="operating_unit_id"/>
                        </group>
                    </group>
                    <separator string="Mitigations"/>
                    <field name="mitigations" nolabel="1"/>
                    <separator string="Single-Source Exception"/>
                    <field name="exception_note" nolabel="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_supplier_risk" model="ir.actions.act_window">
        <field name="name">Risk Assessments</field>
        <field name="res_model">fix.supplier.risk</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_supplier_risk" name="Risk Assessments"
              parent="cd_vendor_ext.menu_ws_supplier_relationship"
              action="action_fix_supplier_risk" sequence="310"/>

</odoo>
