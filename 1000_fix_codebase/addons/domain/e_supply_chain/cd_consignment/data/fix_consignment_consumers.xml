<?xml version="1.0" encoding="utf-8"?>
<!-- R8 consumer of consignment.tamper_detected (A02 audit B2): a seal or
     weight mismatch at hub intake puts the consignment on hold; this puts the
     hold in the logistics managers' activity queue, where it is released. -->
<odoo>
    <data noupdate="1">

        <record id="consumer_consignment_tamper_detected" model="fix.event.consumer">
            <field name="name">M03: a tamper hold reaches the logistics managers</field>
            <field name="event_type">consignment.tamper_detected</field>
            <field name="model">fix.consignment</field>
            <field name="method">consume_tamper_detected</field>
            <field name="module">cd_consignment</field>
        </record>

    </data>
</odoo>
