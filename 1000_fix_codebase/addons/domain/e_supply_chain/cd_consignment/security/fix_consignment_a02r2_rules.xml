<?xml version="1.0" encoding="utf-8"?>
<!--
  A02 ERP audit pass 2 (20 Nov 2026).
  M03-05: the pick & drop tariff is a company's own table.
  M03-09 (a rider changes only his own legs) is enforced in
  fix.consignment.write: a group rule would be OR-ed with the internal-user
  operating-unit rule and restrict nothing.
-->
<odoo>
    <record id="rule_fix_logistics_tariff_company" model="ir.rule">
        <field name="name">fix.logistics.tariff: allowed companies</field>
        <field name="model_id" ref="model_fix_logistics_tariff"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
