<?xml version="1.0" encoding="utf-8"?>
<!-- cd_consignment views — logistics under the procurement workspace. -->
<odoo>

    <record id="view_fix_consignment_tree" model="ir.ui.view">
        <field name="name">fix.consignment.tree</field>
        <field name="model">fix.consignment</field>
        <field name="arch" type="xml">
            <tree decoration-danger="chain_broken or state == 'lost'" decoration-success="state in ('delivered', 'returned')">
                <field name="name"/>
                <field name="scheduled_date"/>
                <field name="consignment_type"/>
                <field name="rider_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="chain_broken" string="Chain" widget="boolean_toggle"/>
                <field name="custody_summary" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_fix_consignment_form" model="ir.ui.view">
        <field name="name">fix.consignment.form</field>
        <field name="model">fix.consignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="confirmed,in_transit,delivered,returned"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="consignment_type"/>
                            <field name="scheduled_date"/>
                            <field name="rider_id"/>
                            <field name="service_order_id" optional="show"/>
                            <field name="purchase_order_id" optional="hide"/>
                        </group>
                        <group>
                            <field name="origin_branch_id"/>
                            <field name="dest_branch_id"/>
                            <field name="chain_broken"/>
                            <field name="custody_summary"/>
                        </group>
                    </group>
                    <field name="custody_ids">
                        <tree editable="bottom">
                            <field name="scanned_at"/>
                            <field name="step"/>
                            <field name="scanned_by"/>
                            <field name="location_branch_id" optional="show"/>
                            <field name="device_serial" optional="show"/>
                            <field name="exception_reason"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_consignment" model="ir.actions.act_window">
        <field name="name">Consignments</field>
        <field name="res_model">fix.consignment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_fix_consignment" name="Consignments"
              parent="cd_requisition.menu_ws_procurement"
              action="action_fix_consignment" sequence="30"/>

</odoo>
