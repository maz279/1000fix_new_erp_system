<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The PO-reference sequence fix.purchase.order.create() has always
         called. Without it every PO of a day was 'PO/<today>' - the po_ref the
         vendor portal and the M52 matcher key on was not unique. -->
    <data noupdate="1">
        <record id="seq_fix_purchase_order" model="ir.sequence">
            <field name="name">Purchase Order</field>
            <field name="code">fix.purchase.order</field>
            <field name="prefix">PO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_procurement_rfq" model="ir.sequence">
            <field name="name">RFQ Event</field>
            <field name="code">fix.procurement.rfq</field>
            <field name="prefix">RFQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_procurement_bid" model="ir.sequence">
            <field name="name">Supplier Bid</field>
            <field name="code">fix.procurement.bid</field>
            <field name="prefix">BID/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_procurement_award" model="ir.sequence">
            <field name="name">Award Decision</field>
            <field name="code">fix.procurement.award</field>
            <field name="prefix">AWRD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_procurement_blanket" model="ir.sequence">
            <field name="name">Blanket Agreement</field>
            <field name="code">fix.procurement.blanket</field>
            <field name="prefix">BLKT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_procurement_expedite" model="ir.sequence">
            <field name="name">Expediting Case</field>
            <field name="code">fix.procurement.expedite</field>
            <field name="prefix">EXPD/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_procurement_inspection" model="ir.sequence">
            <field name="name">Goods Inspection</field>
            <field name="code">fix.procurement.inspection</field>
            <field name="prefix">INSP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
