<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The PO-reference sequence fix.purchase.order.create() has always
         called. Without it every PO of a day was 'PO/<today>' - the po_ref the
         vendor portal and the M52 matcher key on was not unique. -->
    <data noupdate="1">
        <record id="seq_fix_purchase_order" model="ir.sequence">
            <field name="name">Purchase Order</field>
            <field name="code">fix.purchase.order</field>
            <field name="prefix">PO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
