<?xml version="1.0" encoding="utf-8"?>
<!-- cd_demand_plan views (P09). The demand plan is the forecast carrier;
     planner overrides apply onto it without replacing the statistical value. -->
<odoo>
    <record id="view_fix_demand_plan_list" model="ir.ui.view">
        <field name="name">fix.demand.plan.list</field>
        <field name="model">fix.demand.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="forecast_quantity"/>
                <field name="final_quantity"/>
                <field name="recommended_order"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_fix_demand_plan_form" model="ir.ui.view">
        <field name="name">fix.demand.plan.form</field>
        <field name="model">fix.demand.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Demand Plan"/></h1></div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="current_stock"/>
                            <field name="reorder_point"/>
                        </group>
                        <group>
                            <field name="forecast_quantity"/>
                            <field name="override_quantity" readonly="1"/>
                            <field name="final_quantity"/>
                            <field name="recommended_order"/>
                        </group>
                    </group>
                    <field name="override_ids" readonly="1">
                        <list>
                            <field name="original_value"/>
                            <field name="override_value"/>
                            <field name="driver_type"/>
                            <field name="planner_id"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_fix_demand_plan" model="ir.actions.act_window">
        <field name="name">Demand Plan</field>
        <field name="res_model">fix.demand.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_demand_plan" name="Demand Plans"
              parent="cd_p03_portal.menu_p03_ws_demand_plan_s1"
              action="action_fix_demand_plan" sequence="10"/>
</odoo>
