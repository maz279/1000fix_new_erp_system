<?xml version="1.0" encoding="utf-8"?>
<!-- cd_demand_plan capture views (CD-M43-01). One list + form + action per
     M43 capture model; menus sit under the P03 workspace sections
     Forecasting / Policies / Execution / Simulation. -->
<odoo>

    <!-- fix.demand.adjustment -->
    <record id="view_fix_demand_adjustment_list" model="ir.ui.view">
        <field name="name">fix.demand.adjustment.list</field>
        <field name="model">fix.demand.adjustment</field>
        <field name="arch" type="xml">
            <list>
                <field name="spare_part_id"/>
                <field name="location_id"/>
                <field name="demand_stream"/>
                <field name="period"/>
                <field name="adjustment_type"/>
                <field name="original_value"/>
                <field name="adjusted_value"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_fix_demand_adjustment_form" model="ir.ui.view">
        <field name="name">fix.demand.adjustment.form</field>
        <field name="model">fix.demand.adjustment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply" type="object" string="Apply" class="oe_highlight" invisible="not (state == 'draft')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="not (state == 'draft')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,applied"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="spare_part_id"/>
                            <field name="location_id"/>
                            <field name="demand_stream"/>
                            <field name="period"/>
                        </group>
                        <group>
                            <field name="adjustment_type"/>
                            <field name="treatment"/>
                            <field name="target_stream"/>
                            <field name="original_value"/>
                            <field name="adjusted_value"/>
                        </group>
                    </group>
                    <group string="Computed &amp; Audit">
                        <field name="actor_id"/>
                        <field name="applied_at"/>
                    </group>
                    <group string="Reason"><field name="reason" nolabel="1" colspan="2"/></group>
                    <group string="Reason (Bengali)"><field name="reason_bn" nolabel="1" colspan="2"/></group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_fix_demand_adjustment" model="ir.actions.act_window">
        <field name="name">History Adjustments</field>
        <field name="res_model">fix.demand.adjustment</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fix_demand_adjustment" name="History Adjustments" parent="cd_p03_portal.menu_p03_ws_demand_plan_s1"
              action="action_fix_demand_adjustment" sequence="15"/>

    <!-- fix.planning.run -->
    <record id="view_fix_planning_run_list" model="ir.ui.view">
        <field name="name">fix.planning.run.list</field>
        <field name="model">fix.planning.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="run_type"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="horizon_months"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_fix_planning_run_form" model="ir.ui.view">
        <field name="name">fix.planning.run.form</field>
        <field name="model">fix.planning.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start Cycle" class="oe_highlight" invisible="not (state == 'draft')"/>
                    <button name="action_to_review" type="object" string="Move to Review" class="oe_highlight" invisible="not (state == 'running')"/>
                    <button name="action_sign_procurement" type="object" string="Sign: Procurement" invisible="not (state == 'review')"/>
                    <button name="action_sign_operations" type="object" string="Sign: Operations" invisible="not (state == 'review')"/>
                    <button name="action_sign_finance" type="object" string="Sign: Finance" invisible="not (state == 'review')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="not (state in ('draft','running','review'))"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,review,signed_off"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Review Cycle"/></h1></div>
                    <group>
                        <group>
                            <field name="name_bn"/>
                            <field name="run_type"/>
                            <field name="scope"/>
                            <field name="horizon_months"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="started_at"/>
                            <field name="completed_at"/>
                        </group>
                    </group>
                    <group string="Computed &amp; Audit">
                        <field name="parts_processed"/>
                        <field name="forecasts_generated"/>
                        <field name="degraded_count"/>
                        <field name="procurement_signoff_id"/>
                        <field name="operations_signoff_id"/>
                        <field name="finance_signoff_id"/>
                    </group>
                    <group string="Review Notes"><field name="notes" nolabel="1" colspan="2"/></group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_fix_planning_run" model="ir.actions.act_window">
        <field name="name">Review Cycles</field>
        <field name="res_model">fix.planning.run</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_fix_planning_run" name="Review Cycles" parent="cd_p03_portal.menu_p03_ws_demand_plan_s1"
              action="action_fix_planning_run" sequence="20"/>

