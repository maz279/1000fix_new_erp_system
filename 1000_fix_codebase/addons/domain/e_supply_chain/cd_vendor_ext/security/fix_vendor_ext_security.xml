<?xml version="1.0" encoding="utf-8"?>
<!--
  cd_vendor_ext — M42 Supplier Relationship function groups (spec §13).

  FUNCTION groups (the Odoo mechanism), mirroring cd_rbac_ext: the R-nn rows
  of the role register link to them via fix.role.group_id — role codes are
  never invented here. Mapping (spec §13):

    Viewer               R17 Inventory Mgr, R05 Ops Director, R06 Branch Mgr,
                         R15 Logistics Coordinator — read
    Procurement Officer  R19 — capture profiles, qualifications, documents,
                         agreements, price-change requests, CARs, risk,
                         screening, reviews
    Quality Manager      R32 — + qualification approval, CAR verification,
                         brand-authorisation evidence
    Procurement Manager  R19 elevated grant — + activation / suspension,
                         segmentation, price-change approval, agreement
                         execution, risk approval, screening clearance
    Finance Manager      R26 — bank details (the only non-CFO role that sees
                         them, 05-04 §5) and bank-change approval
    CFO                  R03 — everything above + permanent block

  Segregation of duties (§13) is enforced in the models on top of these
  groups: the requester / proposer / scorer / raiser / assessor never
  approves or verifies their own record.
-->
<odoo>

    <record id="privilege_fix_supplier_relationship" model="res.groups.privilege">
        <field name="name">Supplier Relationship (M42)</field>
        <field name="description">M42 supplier register, qualification, performance and risk (spec §13).</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_m42_viewer" model="res.groups">
        <field name="name">Supplier Relationship: Viewer</field>
        <field name="privilege_id" ref="privilege_fix_supplier_relationship"/>
        <field name="implied_ids" eval="[(4, ref('cd_rbac_ext.group_fix_portal_user'))]"/>
        <field name="comment">Read supplier profiles, performance, lead times and risk (R17, R05, R06, R15).</field>
    </record>

    <record id="group_m42_officer" model="res.groups">
        <field name="name">Supplier Relationship: Procurement Officer</field>
        <field name="privilege_id" ref="privilege_fix_supplier_relationship"/>
        <field name="implied_ids" eval="[(4, ref('group_m42_viewer'))]"/>
        <field name="comment">Capture supplier profiles, qualifications, documents, agreements, price-change requests, CARs, risk assessments, screenings and reviews (R19).</field>
    </record>

    <record id="group_m42_quality" model="res.groups">
        <field name="name">Supplier Relationship: Quality Manager</field>
        <field name="privilege_id" ref="privilege_fix_supplier_relationship"/>
        <field name="implied_ids" eval="[(4, ref('group_m42_officer'))]"/>
        <field name="comment">Approve qualifications, verify corrective actions and brand-authorisation evidence (R32).</field>
    </record>

    <record id="group_m42_manager" model="res.groups">
        <field name="name">Supplier Relationship: Procurement Manager</field>
        <field name="privilege_id" ref="privilege_fix_supplier_relationship"/>
        <field name="implied_ids" eval="[(4, ref('group_m42_quality'))]"/>
        <field name="comment">Activate and suspend suppliers, approve segmentation, price changes and risk assessments, execute agreements, clear screenings, configure questionnaires (R19 elevated grant).</field>
    </record>

    <record id="group_m42_finance" model="res.groups">
        <field name="name">Supplier Relationship: Finance Manager</field>
        <field name="privilege_id" ref="privilege_fix_supplier_relationship"/>
        <field name="implied_ids" eval="[(4, ref('group_m42_viewer')), (4, ref('base.group_partner_manager'))]"/>
        <field name="comment">See and change supplier bank details; approve bank-detail changes (R26).</field>
    </record>

    <record id="group_m42_cfo" model="res.groups">
        <field name="name">Supplier Relationship: CFO</field>
        <field name="privilege_id" ref="privilege_fix_supplier_relationship"/>
        <field name="implied_ids" eval="[(4, ref('group_m42_manager')), (4, ref('group_m42_finance'))]"/>
        <field name="comment">All M42 rights; sole authority to block a supplier permanently (R03).</field>
    </record>

</odoo>
