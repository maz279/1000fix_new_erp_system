<?xml version="1.0" encoding="utf-8"?>
<!--
  M44 child-record isolation (A06 audit M44-11): the ten child models had no
  company or operating-unit field and no rule, so an OU-B user who could not
  see an OU-A order edited its LC amount and Bill of Entry values. Every child
  now carries the order's company and unit (stored related fields) and the
  same two rules the generated file gives the order. Hand-written, so
  tooling/generators/generate-isolation-rules.py leaves these models alone.
-->
<odoo>
    <record id="rule_fix_import_order_line_company" model="ir.rule">
        <field name="name">fix.import.order.line: allowed companies</field>
        <field name="model_id" ref="model_fix_import_order_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
