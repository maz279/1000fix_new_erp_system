<?xml version="1.0" encoding="utf-8"?>
<!-- cd_supplier_qualification views — questionnaires, qualifications, integrity screening. -->
<odoo>

    <record id="view_fix_supplier_qualification_list" model="ir.ui.view">
        <field name="name">fix.supplier.qualification.list</field>
        <field name="model">fix.supplier.qualification</field>
        <field name="arch" type="xml">
            <list>
                <field name="profile_id"/>
                <field name="category_id"/>
                <field name="version"/>
                <field name="score"/>
                <field name="result" widget="badge"/>
                <field name="valid_until"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fix_supplier_qualification_form" model="ir.ui.view">
        <field name="name">fix.supplier.qualification.form</field>
        <field name="model">fix.supplier.qualification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit for Approval" class="oe_highlight" invisible="state not in ('draft')"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state not in ('submitted')"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state not in ('submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="category_id"/>
                            <field name="questionnaire_id"/>
                            <field name="version"/>
                            <field name="anti_bribery_declared"/>
                            <field name="code_of_conduct_version"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="threshold"/>
                            <field name="result"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                            <field name="scored_by"/>
                            <field name="approved_by"/>
                            <field name="approved_at"/>
                            <field name="company_id"/>
                            <field name="operating_unit_id"/>
                        </group>
                    </group>
                    <separator string="Questionnaire Responses"/>
                    <field name="responses" nolabel="1"/>
                    <separator string="Evidence Provided"/>
                    <field name="evidence_note" nolabel="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_supplier_qualification" model="ir.actions.act_window">
        <field name="name">Qualifications</field>
        <field name="res_model">fix.supplier.qualification</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fix_qualification_questionnaire_list" model="ir.ui.view">
        <field name="name">fix.qualification.questionnaire.list</field>
        <field name="model">fix.qualification.questionnaire</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_id"/>
                <field name="risk_tier"/>
                <field name="pass_threshold"/>
                <field name="version"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fix_qualification_questionnaire_form" model="ir.ui.view">
        <field name="name">fix.qualification.questionnaire.form</field>
        <field name="model">fix.qualification.questionnaire</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="risk_tier"/>
                        </group>
                        <group>
                            <field name="pass_threshold"/>
                            <field name="validity_days"/>
                            <field name="version"/>
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="operating_unit_id"/>
                        </group>
                    </group>
                    <separator string="Questions"/>
                    <field name="question_ids" nolabel="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_qualification_questionnaire" model="ir.actions.act_window">
        <field name="name">Questionnaires</field>
        <field name="res_model">fix.qualification.questionnaire</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fix_supplier_screening_list" model="ir.ui.view">
        <field name="name">fix.supplier.screening.list</field>
        <field name="model">fix.supplier.screening</field>
        <field name="arch" type="xml">
            <list>
                <field name="profile_id"/>
                <field name="screened_on"/>
                <field name="sanctions_result"/>
                <field name="coi_declared"/>
                <field name="outcome" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fix_supplier_screening_form" model="ir.ui.view">
        <field name="name">fix.supplier.screening.form</field>
        <field name="model">fix.supplier.screening</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state not in ('draft')"/>
                    <button name="action_clear" type="object" string="Clear Screening" invisible="state not in ('submitted')"/>
                    <button name="action_escalate" type="object" string="Escalate" invisible="state not in ('submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,cleared"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="screened_on"/>
                            <field name="sanctions_result"/>
                            <field name="sanctions_source"/>
                            <field name="coi_declared"/>
                            <field name="related_party"/>
                        </group>
                        <group>
                            <field name="anti_bribery_declared"/>
                            <field name="code_of_conduct_accepted"/>
                            <field name="code_of_conduct_version"/>
                            <field name="outcome"/>
                            <field name="reviewed_by"/>
                            <field name="company_id"/>
                            <field name="operating_unit_id"/>
                        </group>
                    </group>
                    <separator string="Conflict of Interest Details"/>
                    <field name="coi_details" nolabel="1"/>
                    <separator string="Review Note"/>
                    <field name="review_note" nolabel="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_supplier_screening" model="ir.actions.act_window">
        <field name="name">Integrity Screening</field>
        <field name="res_model">fix.supplier.screening</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_supplier_qualification" name="Qualifications"
              parent="cd_vendor_ext.menu_ws_supplier_relationship"
              action="action_fix_supplier_qualification" sequence="110"/>
    <menuitem id="menu_fix_qualification_questionnaire" name="Questionnaires"
              parent="cd_vendor_ext.menu_ws_supplier_relationship"
              action="action_fix_qualification_questionnaire" sequence="120"/>
    <menuitem id="menu_fix_supplier_screening" name="Integrity Screening"
              parent="cd_vendor_ext.menu_ws_supplier_relationship"
              action="action_fix_supplier_screening" sequence="130"/>

</odoo>
