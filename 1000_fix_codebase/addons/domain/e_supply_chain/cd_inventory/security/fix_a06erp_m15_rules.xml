<?xml version="1.0" encoding="utf-8"?>
<!-- A06 ERP audit (20 Nov 2026), M15 stream: company / operating-unit isolation
     of the movement ledger (A20) and the van count lines (A11). -->
<odoo>
    <record id="rule_fix_stock_move_log_company" model="ir.rule">
        <field name="name">fix.stock.move.log: allowed companies</field>
        <field name="model_id" ref="model_fix_stock_move_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_stock_move_log_operating_unit" model="ir.rule">
        <field name="name">fix.stock.move.log: allowed operating units (internal users)</field>
        <field name="model_id" ref="model_fix_stock_move_log"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('operating_unit_id', '=', False), ('operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
    <!-- A38: a transfer carries the SENDER's operating unit, so the generated
         OU rule (fix_isolation_rules.xml, do-not-edit) hid it from the
         receiving branch that must receive it. Rules of one group are OR-ed:
         this one adds the transfers addressed to a location of the user's
         operating units (the location's own OU, else its branch's). -->
    <record id="rule_fix_stock_transfer_receiving_operating_unit" model="ir.rule">
        <field name="name">fix.stock.transfer: receiving operating unit (internal users)</field>
        <field name="model_id" ref="model_fix_stock_transfer"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('to_location_id.operating_unit_id', 'in', operating_unit_ids), ('to_location_id.branch_id.operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
    <record id="rule_fix_stock_van_recon_line_company" model="ir.rule">
        <field name="name">fix.stock.van.recon.line: allowed companies</field>
        <field name="model_id" ref="model_fix_stock_van_recon_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
