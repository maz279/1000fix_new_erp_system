<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-written isolation rules (A06 audit M15-14), alongside the generated
  fix_isolation_rules.xml: the new ownership-class change document, and an
  operating-unit rule for the M15 documents that carry no operating unit of
  their own (lots, quarantine, RTV, van reconciliation): they follow their
  location's operating unit.
-->
<odoo>
    <record id="rule_fix_stock_class_change_company" model="ir.rule">
        <field name="name">fix.stock.class.change: allowed companies</field>
        <field name="model_id" ref="model_fix_stock_class_change"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_stock_class_change_operating_unit" model="ir.rule">
        <field name="name">fix.stock.class.change: location operating units (internal users)</field>
        <field name="model_id" ref="model_fix_stock_class_change"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('location_id.operating_unit_id', '=', False), ('location_id.operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
    <record id="rule_fix_stock_lot_operating_unit" model="ir.rule">
        <field name="name">fix.stock.lot: location operating units (internal users)</field>
        <field name="model_id" ref="model_fix_stock_lot"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', '|', ('location_id', '=', False), ('location_id.operating_unit_id', '=', False), ('location_id.operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
    <record id="rule_fix_stock_quarantine_operating_unit" model="ir.rule">
        <field name="name">fix.stock.quarantine: location operating units (internal users)</field>
        <field name="model_id" ref="model_fix_stock_quarantine"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('location_id.operating_unit_id', '=', False), ('location_id.operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
    <record id="rule_fix_stock_rtv_operating_unit" model="ir.rule">
        <field name="name">fix.stock.rtv: location operating units (internal users)</field>
        <field name="model_id" ref="model_fix_stock_rtv"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('location_id.operating_unit_id', '=', False), ('location_id.operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
    <record id="rule_fix_stock_van_recon_operating_unit" model="ir.rule">
        <field name="name">fix.stock.van.recon: location operating units (internal users)</field>
        <field name="model_id" ref="model_fix_stock_van_recon"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('location_id.operating_unit_id', '=', False), ('location_id.operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
</odoo>
