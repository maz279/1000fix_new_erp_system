<?xml version="1.0" encoding="utf-8"?>
<!--
  M15 capture pass 2 (19 Nov 2026): sequences for the reservation, backorder,
  recall and brand consignment statement, the reservation validity
  (BRU-INV-18) and the expiry sweep (FR-INV-021).
-->
<odoo>
    <data noupdate="1">
        <record id="seq_fix_stock_reservation" model="ir.sequence">
            <field name="name">Stock Reservation</field>
            <field name="code">fix.stock.reservation</field>
            <field name="prefix">RSV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_stock_backorder" model="ir.sequence">
            <field name="name">Stock Backorder</field>
            <field name="code">fix.stock.backorder</field>
            <field name="prefix">BKO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_stock_recall" model="ir.sequence">
            <field name="name">Stock Recall</field>
            <field name="code">fix.stock.recall</field>
            <field name="prefix">RCL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_consignment_reconciliation" model="ir.sequence">
            <field name="name">Brand Consignment Statement</field>
            <field name="code">fix.consignment.reconciliation</field>
            <field name="prefix">CSR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="param_reservation_validity_hours" model="ir.config_parameter">
            <field name="key">cd_inventory.reservation_validity_hours</field>
            <field name="value">72</field>
        </record>
        <record id="ir_cron_reservation_expiry" model="ir.cron">
            <field name="name">M15: expire unissued stock reservations</field>
            <field name="model_id" ref="model_fix_stock_reservation"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
