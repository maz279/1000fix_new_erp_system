<?xml version="1.0" encoding="utf-8"?>
<!--
  M15 inventory control parameters (A06 remediation S9). Business decisions
  (report section 7), shipped at the conservative default 0:
    count_variance_tolerance_pct  - % of the expected quantity a count may differ
                                    by and post without approval (0 = every
                                    variance is recounted, then approved)
    van_variance_tolerance_pct    - the same for a van reconciliation
    writeoff_approval_threshold   - BDT value above which a scrap / write-off
                                    needs Inventory Controller approval (0 = all)
    transfer_approval_threshold   - BDT value above which a transfer needs
                                    approval (0 = all)
  noupdate: once Finance sets a value, an upgrade does not reset it.
  A06 ERP audit 20 Nov 2026, owner decision D8: the values a NEW database starts
  with are the owner's limits (count 2%, van 1%, transfer BDT 50,000, write-off
  BDT 5,000); an existing database keeps its value until the lead sets it.
-->
<odoo>
    <data noupdate="1">
        <record id="param_count_variance_tolerance_pct" model="ir.config_parameter">
            <field name="key">cd_inventory.count_variance_tolerance_pct</field>
            <field name="value">2</field>
        </record>
        <record id="param_van_variance_tolerance_pct" model="ir.config_parameter">
            <field name="key">cd_inventory.van_variance_tolerance_pct</field>
            <field name="value">1</field>
        </record>
        <record id="param_writeoff_approval_threshold" model="ir.config_parameter">
            <field name="key">cd_inventory.writeoff_approval_threshold</field>
            <field name="value">5000</field>
        </record>
        <record id="param_transfer_approval_threshold" model="ir.config_parameter">
            <field name="key">cd_inventory.transfer_approval_threshold</field>
            <field name="value">50000</field>
        </record>
    </data>
</odoo>
