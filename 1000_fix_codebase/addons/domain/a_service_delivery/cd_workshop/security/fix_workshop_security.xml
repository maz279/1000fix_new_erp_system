<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- M31 Workshop & Depot Repair Security Groups (Odoo 19 privilege-based) -->
    <record id="privilege_fix_workshop" model="res.groups.privilege">
        <field name="name">1000FiX Workshop Operations</field>
        <field name="description">Workshop and Depot repair operations access (M31, Wave 2).</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_fix_workshop_user" model="res.groups">
        <field name="name">Workshop Technician / Bench Operator</field>
        <field name="privilege_id" ref="privilege_fix_workshop"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Technicians operating on L1/L2/L3 benches, executing repairs, logging parts and evidence.</field>
    </record>

    <record id="group_fix_workshop_manager" model="res.groups">
        <field name="name">Workshop Supervisor / Depot Manager</field>
        <field name="privilege_id" ref="privilege_fix_workshop"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_workshop_user'))]"/>
        <field name="comment">Depot and workshop supervisors managing bench allocation, capacity, burn-in, and quality control.</field>
    </record>

    <!-- Multi-Company Record Rules (AS-03) -->
    <record id="rule_fix_workshop_company" model="ir.rule">
        <field name="name">Workshop Multi-Company Rule</field>
        <field name="model_id" ref="model_fix_workshop"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_fix_workshop_bench_company" model="ir.rule">
        <field name="name">Workshop Bench Multi-Company Rule</field>
        <field name="model_id" ref="model_fix_workshop_bench"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_fix_workshop_job_company" model="ir.rule">
        <field name="name">Workshop Job Multi-Company Rule</field>
        <field name="model_id" ref="model_fix_workshop_job"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
