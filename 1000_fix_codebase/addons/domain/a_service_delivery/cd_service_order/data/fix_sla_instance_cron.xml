<?xml version="1.0" encoding="utf-8"?>
<!--
  M01 scheduled jobs: SLA breach and near-breach detection (S9).

  A cron METHOD with no ir.cron record never runs, and passes its unit tests
  anyway because a test calls it directly. Every scheduled job this area's
  gap-closure build relies on is declared here.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sla_breaches" model="ir.cron">
            <field name="name">M01 S9: flag SLA breaches and near-breaches</field>
            <field name="model_id" ref="model_fix_sla_kpi_instance"/>
            <field name="state">code</field>
            <field name="code">model.cron_flag_breaches()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
