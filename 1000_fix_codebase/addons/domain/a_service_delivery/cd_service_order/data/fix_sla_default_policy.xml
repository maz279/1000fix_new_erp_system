<?xml version="1.0" encoding="utf-8"?>
<!-- A02 audit B3: the default M01 SLA policy.

     _fix_start_sla looked for a policy matching the order's channel and
     priority and silently skipped the clock when none matched: 0 of 930
     orders had a deadline. An order with no matching policy now runs on
     this one. noupdate: the targets are a business decision (report §7.6);
     change them here in the data, not by an upgrade. -->
<odoo>
    <data noupdate="1">
        <record id="sla_policy_m01_default" model="fix.sla.policy">
            <field name="code">M01-DEFAULT</field>
            <field name="name">M01 default service-order SLA (no specific policy matched)</field>
            <field name="service_type">walk_in</field>
            <field name="priority">normal</field>
            <field name="response_hours">8</field>
            <field name="resolution_hours">72</field>
        </record>
    </data>
</odoo>
