<?xml version="1.0" encoding="utf-8"?>
<!-- cd_service_order — the estimate form (M01; the M36 quotation lifecycle
     in cd_quotation extends THIS view — one estimate concept, AS-01). -->
<odoo>

    <record id="view_fix_estimate_form" model="ir.ui.view">
        <field name="name">fix.estimate.form</field>
        <field name="model">fix.estimate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,approved,rejected,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="order_id" readonly="1"/> — v<field name="version" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="parts_total"/>
                            <field name="labour_total"/>
                            <field name="discount"/>
                        </group>
                        <group>
                            <field name="vat_rate"/>
                            <field name="vat_amount"/>
                            <field name="grand_total"/>
                            <field name="customer_approval_ref"
                                   placeholder="SMS/OTP ref or signature id (BRU-SRM-07)"/>
                            <field name="manager_approval_uid" readonly="1"
                                   groups="base.group_user"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="line_total" sum="Total"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_estimate" model="ir.actions.act_window">
        <field name="name">Estimates</field>
        <field name="res_model">fix.estimate</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_estimate" name="Estimates"
              parent="menu_ws_service_orders"
              action="action_fix_estimate" sequence="60"/>

</odoo>
