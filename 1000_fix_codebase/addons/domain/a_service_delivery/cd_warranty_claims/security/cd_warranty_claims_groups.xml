<?xml version="1.0" encoding="utf-8"?>
<!-- M09 warranty claim roles (A04 workflow audit 2026-11-03, M09-1/-2/-8/-9, §7.1;
     C2-C13 build 2026-11-04).

     Every internal user could write a claim's state, amount and decision, and
     the submitter recorded the OEM's approval himself. Plain internal users
     now READ claims; the work goes to two roles:

     - Warranty Claims Clerk: raises claims from closed warranty jobs,
       assembles the evidence pack, submits it, raises appeals, transfer and
       recall records, and requests the decision approval.
     - Claim Decision Officer (§7.1 "claim decision officer"): records the
       OEM's decision from the approval inbox (four eyes: never the submitter,
       the requester or the claim's creator), decides appeals and transfers,
       closes recalls and accepts remittances.

     The officer implies the clerk. The dev admin is a member of both so the
     work keeps running; segregation of duties still applies to him. Who holds
     the officer role is a business appointment. -->
<odoo>
    <record id="privilege_warranty_claims" model="res.groups.privilege">
        <field name="name">1000FiX Warranty Claims</field>
        <field name="description">OEM warranty claims, evidence, decisions, appeals, transfers and recalls (M09).</field>
        <field name="sequence">59</field>
    </record>

    <record id="group_warranty_claims_clerk" model="res.groups">
        <field name="name">Warranty Claims Clerk</field>
        <field name="privilege_id" ref="privilege_warranty_claims"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Raises OEM claims from closed warranty jobs, assembles and submits the evidence pack, raises appeals, warranty transfers and recall records.</field>
    </record>

    <record id="group_warranty_claims_officer" model="res.groups">
        <field name="name">Claim Decision Officer</field>
        <field name="privilege_id" ref="privilege_warranty_claims"/>
        <field name="implied_ids" eval="[(4, ref('group_warranty_claims_clerk'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Records the OEM decision (approve, partial, reject) from the approval inbox, never on a claim he submitted or requested; decides appeals and transfers, accepts remittances and closes recalls.</field>
    </record>
</odoo>
