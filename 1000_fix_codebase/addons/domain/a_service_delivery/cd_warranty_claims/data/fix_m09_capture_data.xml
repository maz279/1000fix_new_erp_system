<?xml version="1.0" encoding="utf-8"?>
<!-- M09 capture audit, second pass (2026-11-18): numbering for the records
     the M09 pages capture, and the job that expires protection policies
     past their term and releases their reserve (BRU-WTY-15). -->
<odoo>
    <data noupdate="1">
        <record id="seq_fix_warranty_void" model="ir.sequence">
            <field name="name">Warranty Void Condition</field>
            <field name="code">fix.warranty.void</field>
            <field name="prefix">WVD/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_protection_policy" model="ir.sequence">
            <field name="name">Protection Policy</field>
            <field name="code">fix.protection.policy</field>
            <field name="prefix">PPL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_protection_claim" model="ir.sequence">
            <field name="name">Protection Claim</field>
            <field name="code">fix.protection.claim</field>
            <field name="prefix">PCL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_warranty_claim_info_request" model="ir.sequence">
            <field name="name">Brand Information Request</field>
            <field name="code">fix.warranty.claim.info.request</field>
            <field name="prefix">RFI/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_brand_remittance" model="ir.sequence">
            <field name="name">Brand Remittance</field>
            <field name="code">fix.brand.remittance</field>
            <field name="prefix">BRM/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_brand_reconciliation" model="ir.sequence">
            <field name="name">Brand Reconciliation</field>
            <field name="code">fix.brand.reconciliation</field>
            <field name="prefix">BRC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_claim_writeoff" model="ir.sequence">
            <field name="name">Claim Write-off</field>
            <field name="code">fix.claim.writeoff</field>
            <field name="prefix">CWO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_defective_return" model="ir.sequence">
            <field name="name">Defective Part Return</field>
            <field name="code">fix.defective.return</field>
            <field name="prefix">DPR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_warranty_fraud_review" model="ir.sequence">
            <field name="name">Warranty Fraud Review</field>
            <field name="code">fix.warranty.fraud.review</field>
            <field name="prefix">FRV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="ir_cron_protection_policy_expiry" model="ir.cron">
            <field name="name">Warranty: expire protection policies past their term</field>
            <field name="model_id" ref="model_fix_protection_policy"/>
            <field name="state">code</field>
            <field name="code">model.cron_expire_policies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
