<?xml version="1.0" encoding="utf-8"?>
<!-- A04 C10 (2026-11-04): a claim still unsubmitted past its 72h window
     (G4-01) is escalated once to the person who raised it. The overdue flag
     is computed at read time (it used to be stored and froze). -->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_warranty_claim_overdue" model="ir.cron">
            <field name="name">Warranty: escalate overdue claims (72h submission window)</field>
            <field name="model_id" ref="model_fix_warranty_claim"/>
            <field name="state">code</field>
            <field name="code">model.cron_claim_overdue_escalation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
