<?xml version="1.0" encoding="utf-8"?>
<!-- cd_msp_contract views — M05 (P08-M07) + iteration-2 engines (runbooks,
     patching, SLA credits, on-call, maintenance windows, problem & change). -->
<odoo>
    <!-- ======================= fix.msp.alert ======================= -->
    <record id="view_fix_msp_alert_list" model="ir.ui.view">
        <field name="name">fix.msp.alert.list</field>
        <field name="model">fix.msp.alert</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Raised"/>
                <field name="msp_contract_id"/>
                <field name="asset_id"/>
                <field name="severity"/>
                <field name="message"/>
                <field name="state"/>
                <field name="escalated" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="resolved_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fix_msp_alert_form" model="ir.ui.view">
        <field name="name">fix.msp.alert.form</field>
        <field name="model">fix.msp.alert</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_acknowledge" type="object"
                            string="Acknowledge" invisible="state != 'new'"/>
                    <button name="action_to_ticket" type="object"
                            string="Create Ticket" class="btn-primary"
                            invisible="state not in ('new', 'acked')"/>
                    <button name="action_resolve" type="object"
                            string="Resolve" class="btn-primary"
                            invisible="state == 'resolved'"/>
                    <button name="action_escalate" type="object"
                            string="Escalate" invisible="state == 'resolved' or escalated"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="msp_contract_id"/>
                            <field name="asset_id"/>
                            <field name="severity"/>
                            <field name="escalated" readonly="1"/>
                            <field name="escalated_at" readonly="1" invisible="not escalated"/>
                        </group>
                        <group>
                            <field name="message"/>
                            <field name="order_id"/>
                            <field name="resolved_at" readonly="1"/>
                            <field name="resolution_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_alert" model="ir.actions.act_window">
        <field name="name">MSP Alerts</field>
        <field name="res_model">fix.msp.alert</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== fix.monitored.asset ==================== -->
    <record id="view_fix_monitored_asset_list" model="ir.ui.view">
        <field name="name">fix.monitored.asset.list</field>
        <field name="model">fix.monitored.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="agent_id"/>
                <field name="hostname"/>
                <field name="device_id" optional="show"/>
                <field name="health"/>
                <field name="health_score" optional="show"/>
                <field name="open_alert_count" optional="show"/>
                <field name="last_seen"/>
                <field name="msp_contract_id"/>
            </list>
        </field>
    </record>

    <record id="view_fix_monitored_asset_form" model="ir.ui.view">
        <field name="name">fix.monitored.asset.form</field>
        <field name="model">fix.monitored.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="msp_contract_id"/>
                            <field name="agent_id"/>
                            <field name="hostname"/>
                            <field name="device_id"/>
                        </group>
                        <group>
                            <field name="health"/>
                            <field name="health_score"/>
                            <field name="open_alert_count"/>
                            <field name="last_seen" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Alerts">
                            <field name="alert_ids" readonly="1">
                                <list>
                                    <field name="create_date" string="Raised"/>
                                    <field name="severity"/>
                                    <field name="message"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_monitored_asset" model="ir.actions.act_window">
        <field name="name">Monitored Assets</field>
        <field name="res_model">fix.monitored.asset</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ====================== fix.msp.contract ===================== -->
    <record id="view_fix_msp_contract_list" model="ir.ui.view">
        <field name="name">fix.msp.contract.list</field>
        <field name="model">fix.msp.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="contract_id"/>
                <field name="device_count"/>
                <field name="monitoring_scope"/>
                <field name="per_device_monthly"/>
                <field name="monthly_value"/>
                <field name="sla_target_pct" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_fix_msp_contract_form" model="ir.ui.view">
        <field name="name">fix.msp.contract.form</field>
        <field name="model">fix.msp.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_monthly_report" type="object"
                            string="Generate Report" class="btn-primary"/>
                    <button name="action_compute_sla_credits" type="object"
                            string="Compute SLA Credits"
                            help="Draft credits for periods below the SLA target"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="contract_id"/>
                            <field name="monitoring_scope"/>
                        </group>
                        <group>
                            <field name="device_count"/>
                            <field name="per_device_monthly"/>
                            <field name="monthly_value"/>
                            <field name="sla_target_pct"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Monitored Assets">
                            <field name="asset_ids"/>
                        </page>
                        <page string="Reports">
                            <field name="report_ids"/>
                        </page>
                        <page string="SLA Credits">
                            <field name="credit_ids">
                                <list>
                                    <field name="period_label"/>
                                    <field name="attainment_pct"/>
                                    <field name="target_pct"/>
                                    <field name="credit_amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_contract" model="ir.actions.act_window">
        <field name="name">MSP Contracts</field>
        <field name="res_model">fix.msp.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== fix.remote.session ==================== -->
    <record id="view_fix_remote_session_list" model="ir.ui.view">
        <field name="name">fix.remote.session.list</field>
        <field name="model">fix.remote.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="started_at"/>
                <field name="msp_contract_id"/>
                <field name="asset_id"/>
                <field name="technician_id"/>
                <field name="tool"/>
                <field name="consent_captured"/>
                <field name="started"/>
                <field name="ended_at"/>
            </list>
        </field>
    </record>

    <record id="view_fix_remote_session_form" model="ir.ui.view">
        <field name="name">fix.remote.session.form</field>
        <field name="model">fix.remote.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_request_consent" type="object" string="Request Consent"
                            invisible="consent_captured or started or ended_at"/>
                    <button name="action_start" type="object" string="Start Session"
                            class="btn-primary" invisible="not consent_captured or started or ended_at"/>
                    <button name="action_end" type="object" string="End Session"
                            invisible="not started or ended_at"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="msp_contract_id"/>
                            <field name="asset_id"/>
                            <field name="technician_id"/>
                            <field name="tool"/>
                        </group>
                        <group>
                            <field name="consent_partner_id"/>
                            <field name="consent_captured"/>
                            <field name="consent_token_ref"/>
                            <field name="recording_url"/>
                            <field name="started" readonly="1"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_remote_session" model="ir.actions.act_window">
        <field name="name">Remote Sessions</field>
        <field name="res_model">fix.remote.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =================== fix.msp.service.report ================== -->
    <record id="view_fix_msp_service_report_list" model="ir.ui.view">
        <field name="name">fix.msp.service.report.list</field>
        <field name="model">fix.msp.service.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="period_label"/>
                <field name="msp_contract_id"/>
                <field name="alert_count"/>
                <field name="resolved_count"/>
                <field name="sla_attainment_pct" string="SLA Attainment %"/>
            </list>
        </field>
    </record>

    <record id="view_fix_msp_service_report_form" model="ir.ui.view">
        <field name="name">fix.msp.service.report.form</field>
        <field name="model">fix.msp.service.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_bilingual_report" type="object"
                            string="Regenerate Bilingual Summary" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="msp_contract_id"/>
                            <field name="period_label"/>
                            <field name="sla_attainment_pct" string="SLA Attainment %"/>
                        </group>
                        <group>
                            <field name="alert_count"/>
                            <field name="resolved_count"/>
                        </group>
                    </group>
                    <group string="Summary (English)">
                        <field name="summary_en" nolabel="1"/>
                    </group>
                    <group string="সারসংক্ষেপ (Bengali)">
                        <field name="summary_bn" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_service_report" model="ir.actions.act_window">
        <field name="name">Monthly Reports</field>
        <field name="res_model">fix.msp.service.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ======================= fix.msp.runbook ===================== -->
    <record id="view_fix_msp_runbook_list" model="ir.ui.view">
        <field name="name">fix.msp.runbook.list</field>
        <field name="model">fix.msp.runbook</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="trigger"/>
                <field name="scope_contract_id" optional="show"/>
                <field name="auto_run"/>
                <field name="run_count"/>
                <field name="last_run_at"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_fix_msp_runbook_form" model="ir.ui.view">
        <field name="name">fix.msp.runbook.form</field>
        <field name="model">fix.msp.runbook</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_execute" type="object" string="Log Execution"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="trigger"/>
                            <field name="scope_contract_id"/>
                        </group>
                        <group>
                            <field name="auto_run"/>
                            <field name="auto_resolve_alert"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="script" placeholder="The remediation steps, in order…"/>
                    <notebook>
                        <page string="Executions">
                            <field name="run_ids" readonly="1">
                                <list>
                                    <field name="started_at"/>
                                    <field name="asset_id"/>
                                    <field name="state"/>
                                    <field name="output_note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_runbook" model="ir.actions.act_window">
        <field name="name">Runbooks</field>
        <field name="res_model">fix.msp.runbook</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fix_msp_runbook_run_list" model="ir.ui.view">
        <field name="name">fix.msp.runbook.run.list</field>
        <field name="model">fix.msp.runbook.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="started_at"/>
                <field name="runbook_id"/>
                <field name="asset_id"/>
                <field name="alert_id" optional="show"/>
                <field name="state"/>
                <field name="finished_at"/>
                <field name="output_note"/>
            </list>
        </field>
    </record>

    <record id="action_fix_msp_runbook_run" model="ir.actions.act_window">
        <field name="name">Runbook Executions</field>
        <field name="res_model">fix.msp.runbook.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== fix.msp.patch.policy =================== -->
    <record id="view_fix_msp_patch_policy_list" model="ir.ui.view">
        <field name="name">fix.msp.patch.policy.list</field>
        <field name="model">fix.msp.patch.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="msp_contract_id" optional="show"/>
                <field name="auto_approve"/>
                <field name="max_defer_days"/>
            </list>
        </field>
    </record>

    <record id="view_fix_msp_patch_policy_form" model="ir.ui.view">
        <field name="name">fix.msp.patch.policy.form</field>
        <field name="model">fix.msp.patch.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="msp_contract_id"/>
                        </group>
                        <group>
                            <field name="auto_approve"/>
                            <field name="max_defer_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_patch_policy" model="ir.actions.act_window">
        <field name="name">Patch Policies</field>
        <field name="res_model">fix.msp.patch.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== fix.msp.patch.update =================== -->
    <record id="view_fix_msp_patch_update_list" model="ir.ui.view">
        <field name="name">fix.msp.patch.update.list</field>
        <field name="model">fix.msp.patch.update</field>
        <field name="arch" type="xml">
            <list>
                <field name="identifier" optional="show"/>
                <field name="title"/>
                <field name="asset_id"/>
                <field name="msp_contract_id" optional="show"/>
                <field name="category"/>
                <field name="severity"/>
                <field name="state"/>
                <field name="installed_at" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fix_msp_patch_update_form" model="ir.ui.view">
        <field name="name">fix.msp.patch.update.form</field>
        <field name="model">fix.msp.patch.update</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state not in ('missing', 'deferred', 'failed')"/>
                    <button name="action_install" type="object" string="Mark Installed"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_defer" type="object" string="Defer 7 Days"
                            invisible="state == 'installed'"/>
                    <button name="action_fail" type="object" string="Mark Failed"
                            invisible="state == 'installed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="missing,approved,installed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="msp_contract_id"/>
                            <field name="asset_id"/>
                            <field name="identifier"/>
                            <field name="title"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="severity"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="installed_at" readonly="1"/>
                            <field name="deferred_until"/>
                            <field name="fail_note"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_patch_update" model="ir.actions.act_window">
        <field name="name">Patch Updates</field>
        <field name="res_model">fix.msp.patch.update</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== fix.msp.sla.credit ===================== -->
    <record id="view_fix_msp_sla_credit_list" model="ir.ui.view">
        <field name="name">fix.msp.sla.credit.list</field>
        <field name="model">fix.msp.sla.credit</field>
        <field name="arch" type="xml">
            <list>
                <field name="msp_contract_id"/>
                <field name="period_label"/>
                <field name="attainment_pct"/>
                <field name="target_pct"/>
                <field name="breach_count" optional="show"/>
                <field name="credit_amount" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_fix_msp_sla_credit_form" model="ir.ui.view">
        <field name="name">fix.msp.sla.credit.form</field>
        <field name="model">fix.msp.sla.credit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- A02 audit B1: decided from the M63 approval inbox -->
                    <button name="action_request_approval" type="object" string="Request Approval"
                            class="btn-primary"
                            invisible="state != 'draft' or approval_state == 'pending'"/>
                    <field name="approval_state" invisible="1"/>
                    <button name="action_apply" type="object" string="Apply to Billing"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="msp_contract_id"/>
                            <field name="service_report_id"/>
                            <field name="period_label"/>
                            <field name="reason"/>
                            <field name="manual_amount"/>
                            <field name="dofa_justification" invisible="not manual_amount"/>
                        </group>
                        <group>
                            <field name="attainment_pct"/>
                            <field name="target_pct"/>
                            <field name="breach_count"/>
                            <field name="computed_amount"/>
                            <field name="credit_amount"/>
                            <field name="approved_by_id"/>
                            <field name="approved_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_sla_credit" model="ir.actions.act_window">
        <field name="name">SLA Credits</field>
        <field name="res_model">fix.msp.sla.credit</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- =================== fix.msp.oncall.shift ==================== -->
    <record id="view_fix_msp_oncall_shift_list" model="ir.ui.view">
        <field name="name">fix.msp.oncall.shift.list</field>
        <field name="model">fix.msp.oncall.shift</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="technician_id"/>
                <field name="level"/>
                <field name="start_at"/>
                <field name="end_at"/>
                <field name="state"/>
            </list>
        </field>
