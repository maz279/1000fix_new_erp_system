                            <field name="name"/>
                            <field name="technician_id"/>
                        </group>
                        <group>
                            <field name="level"/>
                            <field name="start_at"/>
                            <field name="end_at"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_oncall_shift" model="ir.actions.act_window">
        <field name="name">On-Call Rota</field>
        <field name="res_model">fix.msp.oncall.shift</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================ fix.msp.maintenance.window ================ -->
    <record id="view_fix_msp_maintenance_window_list" model="ir.ui.view">
        <field name="name">fix.msp.maintenance.window.list</field>
        <field name="model">fix.msp.maintenance.window</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="msp_contract_id" optional="show"/>
                <field name="purpose" optional="show"/>
                <field name="start_at"/>
                <field name="end_at"/>
                <field name="suppress_alerts"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_fix_msp_maintenance_window_form" model="ir.ui.view">
        <field name="name">fix.msp.maintenance.window.form</field>
        <field name="model">fix.msp.maintenance.window</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve Window"
                            class="btn-primary" invisible="approved_at or state == 'closed'"/>
                    <button name="action_close" type="object" string="Close Window"
                            invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="purpose"/>
                            <field name="msp_contract_id"/>
                        </group>
                        <group>
                            <field name="start_at"/>
                            <field name="end_at"/>
                            <field name="suppress_alerts"/>
                            <field name="approved_by_id"/>
                            <field name="approved_at"/>
                            <field name="closed_at" invisible="not closed_at"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_maintenance_window" model="ir.actions.act_window">
        <field name="name">Maintenance Windows</field>
        <field name="res_model">fix.msp.maintenance.window</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================== fix.msp.change.record ==================== -->
    <record id="view_fix_msp_change_list" model="ir.ui.view">
        <field name="name">fix.msp.change.record.list</field>
        <field name="model">fix.msp.change.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="kind"/>
                <field name="change_type"/>
                <field name="risk"/>
                <field name="msp_contract_id" optional="show"/>
                <field name="asset_id" optional="show"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_fix_msp_change_form" model="ir.ui.view">
        <field name="name">fix.msp.change.record.form</field>
        <field name="model">fix.msp.change.record</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- A02 audit B1: CAB / change manager decide from the M63 inbox -->
                    <button name="action_request_approval" type="object" string="Request CAB Approval"
                            class="btn-primary"
                            invisible="state != 'draft' or approval_state == 'pending'"/>
                    <field name="approval_state" invisible="1"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('draft', 'approved')"/>
                    <button name="action_implement" type="object" string="Mark Implemented"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state not in ('implemented', 'rejected')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="change_type" invisible="kind != 'change'"/>
                            <field name="risk"/>
                        </group>
                        <group>
                            <field name="msp_contract_id"/>
                            <field name="asset_id"/>
                            <field name="requested_by"/>
                            <field name="implemented_at" readonly="1"/>
                            <field name="resolution_note" readonly="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What changes, why, and the rollback plan…"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_msp_change" model="ir.actions.act_window">
        <field name="name">Problems &amp; Changes</field>
        <field name="res_model">fix.msp.change.record</field>
        <field name="view_mode">list,form</field>
    </record>

