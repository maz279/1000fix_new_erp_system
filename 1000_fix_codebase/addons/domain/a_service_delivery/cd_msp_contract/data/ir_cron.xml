<?xml version="1.0" encoding="utf-8"?>
<!--
  M05 scheduled jobs (A02 audit B4).

  The monthly service report and the SLA credit computation were buttons
  only, so no credit was ever computed unless someone remembered; and a
  maintenance window's state is derived, so nothing announced when alert
  suppression began or ended. Both jobs are idempotent: the report runs
  daily and acts once per contract and month; a window boundary is
  published once.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_msp_monthly_service_reports" model="ir.cron">
            <field name="name">M05: monthly service reports and SLA credits</field>
            <field name="model_id" ref="model_fix_msp_contract"/>
            <field name="state">code</field>
            <field name="code">model.cron_monthly_service_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_msp_window_boundaries" model="ir.cron">
            <field name="name">M05: publish maintenance window open / close</field>
            <field name="model_id" ref="model_fix_msp_maintenance_window"/>
            <field name="state">code</field>
            <field name="code">model.cron_window_boundaries()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- BRU-RMS-04: an asset with no agent report for 24 hours is reported
             as a coverage gap within the 24 hours; hourly keeps it inside. -->
        <record id="ir_cron_msp_coverage_gaps" model="ir.cron">
            <field name="name">M05: report monitoring coverage gaps</field>
            <field name="model_id" ref="model_fix_monitored_asset"/>
            <field name="state">code</field>
            <field name="code">model.cron_coverage_gaps()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
