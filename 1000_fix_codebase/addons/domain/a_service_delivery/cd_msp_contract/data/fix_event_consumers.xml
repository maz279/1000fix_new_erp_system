<?xml version="1.0" encoding="utf-8"?>
<!-- R8 consumer of contract.renewed for M05 (A02 audit M05-P2, probe L1):
     after a renewal the MSP layer still pointed at the expired term, so the
     entitlement it checks would refuse every ticket. The renewal re-points it. -->
<odoo>
    <data noupdate="1">

        <record id="consumer_contract_renewed_msp" model="fix.event.consumer">
            <field name="name">M05: MSP contracts follow the renewed M08 term</field>
            <field name="event_type">contract.renewed</field>
            <field name="model">fix.msp.contract</field>
            <field name="method">consume_contract_renewed</field>
            <field name="module">cd_msp_contract</field>
        </record>

    </data>
</odoo>
