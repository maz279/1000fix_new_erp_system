<?xml version="1.0" encoding="utf-8"?>
<!-- M17 capture pass 2 (2026-11-19): the new registers are satellites of a
     device (or, for estate nodes, of an estate) and read where it does. -->
<odoo>
    <record id="rule_fix_device_label_scope" model="ir.rule">
        <field name="name">fix.device.label: follows the device's company and operating unit</field>
        <field name="model_id" ref="model_fix_device_label"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['&amp;', '|', ('device_id.company_id', '=', False), ('device_id.company_id', 'in', company_ids), '|', ('device_id.operating_unit_id', '=', False), ('device_id.operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
