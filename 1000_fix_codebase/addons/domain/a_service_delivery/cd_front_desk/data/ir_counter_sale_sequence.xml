<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_fix_counter_sale" model="ir.sequence">
            <field name="name">Counter Sale</field>
            <field name="code">fix.counter.sale</field>
            <field name="prefix">CS/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <!-- A02 audit M04-P2: the NBR Mushak-6.3 number, issued at confirm -->
        <record id="seq_fix_counter_sale_mushak" model="ir.sequence">
            <field name="name">Counter Sale Mushak-6.3</field>
            <field name="code">fix.counter.sale.mushak</field>
            <field name="prefix">M63/%(year)s/</field>
            <field name="padding">6</field>
        </record>
        <!-- M04 capture audit 2026-11-18: FR-FRD-022 shift handover -->
        <record id="seq_fix_shift_handover" model="ir.sequence">
            <field name="name">Shift Handover</field>
            <field name="code">fix.shift.handover</field>
            <field name="prefix">SHO/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <!-- M04 capture audit 2026-11-18: FR-FRD-019 high-value cash ID check -->
        <record id="seq_fix_cash_id_check" model="ir.sequence">
            <field name="name">High-Value Cash ID Check</field>
            <field name="code">fix.cash.id.check</field>
            <field name="prefix">HVC/%(year)s/</field>
            <field name="padding">5</field>
        </record>
    </data>
</odoo>
