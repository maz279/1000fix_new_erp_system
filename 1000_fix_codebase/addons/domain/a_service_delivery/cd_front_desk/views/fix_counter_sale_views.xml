<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fix_counter_sale_list" model="ir.ui.view">
        <field name="name">fix.counter.sale.list</field>
        <field name="model">fix.counter.sale</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sale_date"/>
                <field name="branch_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="total"/>
                <field name="payment_method"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_fix_counter_sale_form" model="ir.ui.view">
        <field name="name">fix.counter.sale.form</field>
        <field name="model">fix.counter.sale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm Sale" invisible="state != 'draft'"/>
                    <button name="action_refund" type="object" string="Refund" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="shift_id"/>
                            <field name="branch_id"/>
                            <field name="customer_id"/>
                            <field name="sold_by"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="total"/>
                            <field name="payment_method"/>
                            <field name="sale_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fix_counter_sale" model="ir.actions.act_window">
        <field name="name">Counter Sales</field>
        <field name="res_model">fix.counter.sale</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_counter_sale" name="Counter Sales"
              parent="menu_ws_front_desk"
              action="action_fix_counter_sale" sequence="40"/>
</odoo>
