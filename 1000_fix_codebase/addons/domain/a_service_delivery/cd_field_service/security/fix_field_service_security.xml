<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 17+ removed res.groups.category_id; groups are categorised via
         the module's own ir.module.category only. -->
    <record id="module_category_field_service" model="ir.module.category">
        <field name="name">Field Service</field>
        <field name="description">1000FiX Field Service, Dispatch and Geospatial Platform</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_fix_field_service_user" model="res.groups">
        <field name="name">Field Service / Technician</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- A02 audit M02-4/M02-9: dispatch, reassignment, the geofence waiver and
         cancellation in dispatch need this group (fix_field_order.py
         DISPATCHER_GROUP). It is an operational group, so the dev admin is a
         member and keeps working; who else dispatches is a business
         appointment. -->
    <record id="group_fix_field_service_manager" model="res.groups">
        <field name="name">Field Service / Dispatcher &amp; Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_fix_field_service_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company record rules per AS-03 -->
    <record id="rule_fix_field_order_multicompany" model="ir.rule">
        <field name="name">Field Order: Multi-Company</field>
        <field name="model_id" ref="model_fix_field_order"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_fix_field_route_multicompany" model="ir.rule">
        <field name="name">Field Route: Multi-Company</field>
        <field name="model_id" ref="model_fix_field_route"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_fix_field_decline_log_multicompany" model="ir.rule">
        <field name="name">Field Decline Log: Multi-Company</field>
        <field name="model_id" ref="model_fix_field_decline_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_fix_technician_location_multicompany" model="ir.rule">
        <field name="name">Technician Location: Multi-Company</field>
        <field name="model_id" ref="model_fix_technician_location"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
