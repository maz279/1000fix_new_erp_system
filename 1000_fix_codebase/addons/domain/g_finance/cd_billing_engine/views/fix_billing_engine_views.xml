<?xml version="1.0" encoding="utf-8"?>
<!-- cd_billing_engine views — AR invoices, dunning, credit notes (Finance workspace). -->
<odoo>

    <record id="view_fix_ar_invoice_tree" model="ir.ui.view">
        <field name="name">fix.ar.invoice.tree</field>
        <field name="model">fix.ar.invoice</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'paid'" decoration-info="state == 'draft'">
                <field name="invoice_date"/>
                <field name="customer_id"/>
                <field name="branch_id" optional="show"/>
                <field name="taxable_amount"/>
                <field name="vat_amount"/>
                <field name="total_payable"/>
                <field name="state" widget="badge"/>
                <field name="mushak_id" optional="show"/>
                <field name="generation_seconds" optional="hide" string="Gen (s)"/>
            </list>
        </field>
    </record>

    <record id="view_fix_ar_invoice_form" model="ir.ui.view">
        <field name="name">fix.ar.invoice.form</field>
        <field name="model">fix.ar.invoice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued,paid,credited"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="invoice_date" readonly="1"/></h1></div>
                    <group>
                        <group string="Invoice">
                            <field name="customer_id"/>
                            <field name="branch_id"/>
                            <field name="source_model" readonly="1"/>
                            <field name="source_id" readonly="1"/>
                            <field name="mushak_id" readonly="1"/>
                            <field name="generation_seconds" readonly="1"/>
                        </group>
                        <group string="Amounts">
                            <field name="currency_id" invisible="1"/>
                            <field name="taxable_amount"/>
                            <field name="vat_amount"/>
                            <field name="total_payable"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="description"/>
                            <field name="taxable_amount"/>
                            <field name="vat_amount"/>
                            <field name="line_total"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fix_dunning_tree" model="ir.ui.view">
        <field name="name">fix.dunning.tree</field>
        <field name="model">fix.dunning</field>
        <field name="arch" type="xml">
            <list decoration-danger="bucket == 'd90_plus'" decoration-warning="bucket in ('d61_90', 'd31_60')">
                <field name="invoice_id"/>
                <field name="overdue_amount"/>
                <field name="days_overdue"/>
                <field name="bucket"/>
                <field name="step"/>
            </list>
        </field>
    </record>

    <record id="action_fix_ar_invoice" model="ir.actions.act_window">
        <field name="name">AR Invoices</field>
        <field name="res_model">fix.ar.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fix_dunning" model="ir.actions.act_window">
        <field name="name">Collections &amp; Dunning</field>
        <field name="res_model">fix.dunning</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fix_credit_note" model="ir.actions.act_window">
        <field name="name">Credit Notes</field>
        <field name="res_model">fix.credit.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fix_ar_consolidated_bill" model="ir.actions.act_window">
        <field name="name">Consolidated Bills</field>
        <field name="res_model">fix.ar.consolidated.bill</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- A08 M20-F5: the per-reminder delivery evidence (FR-ARB-032,
         AUT-ARB-10) and the M27 call handoff a phone-call level raises. -->
    <record id="view_fix_ar_dunning_action_tree" model="ir.ui.view">
        <field name="name">fix.ar.dunning.action.tree</field>
        <field name="model">fix.ar.dunning.action</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="state == 'failed'"
                  decoration-success="state == 'sent'"
                  decoration-muted="state == 'suppressed'">
                <field name="create_date"/>
                <field name="invoice_id"/>
                <field name="customer_id" optional="show"/>
                <field name="level"/>
                <field name="step"/>
                <field name="channel"/>
                <field name="amount"/>
                <field name="days_overdue"/>
                <field name="recipient_masked"/>
                <field name="state" widget="badge"/>
                <field name="sent_at" optional="hide"/>
                <field name="provider_ref" optional="hide"/>
                <field name="failure_reason" optional="hide"/>
                <field name="retry_count" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fix_ar_dunning_action_form" model="ir.ui.view">
        <field name="name">fix.ar.dunning.action.form</field>
        <field name="model">fix.ar.dunning.action</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_retry_failed" type="object" string="Retry Failed"
                            class="btn-primary" invisible="state != 'failed'"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Reminder">
                            <field name="dunning_id"/>
                            <field name="invoice_id"/>
                            <field name="customer_id"/>
                            <field name="policy_id"/>
                            <field name="level"/>
                            <field name="step"/>
                            <field name="channel"/>
                            <field name="tone"/>
                        </group>
                        <group string="Rendered">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="days_overdue"/>
                            <field name="due_date"/>
                            <field name="recipient_masked"/>
                            <field name="template_name"/>
                            <field name="subject"/>
                        </group>
                    </group>
                    <group string="Delivery">
                        <field name="sent_at"/>
                        <field name="provider_ref"/>
                        <field name="notif_delivery_ref"/>
                        <field name="handoff_id"/>
                        <field name="failure_reason"/>
                        <field name="retry_count"/>
                        <field name="note"/>
                    </group>
                    <field name="body"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_ar_dunning_action" model="ir.actions.act_window">
        <field name="name">Dunning Reminder Evidence</field>
        <field name="res_model">fix.ar.dunning.action</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fix_ar_dunning_handoff_tree" model="ir.ui.view">
        <field name="name">fix.ar.dunning.handoff.tree</field>
        <field name="model">fix.ar.dunning.handoff</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state in ('cancelled', 'done')">
                <field name="create_date"/>
                <field name="invoice_id"/>
                <field name="customer_id"/>
                <field name="phone"/>
                <field name="amount"/>
                <field name="days_overdue"/>
                <field name="priority"/>
                <field name="state" widget="badge"/>
                <field name="m27_reference" optional="hide"/>
                <field name="picked_up_by_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fix_ar_dunning_handoff_form" model="ir.ui.view">
        <field name="name">fix.ar.dunning.handoff.form</field>
        <field name="model">fix.ar.dunning.handoff</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="action_pick_up" type="object" string="Pick Up"
                            invisible="state != 'm27_follow_up'"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Follow-up">
                            <field name="action_id"/>
                            <field name="invoice_id"/>
                            <field name="customer_id"/>
                            <field name="phone"/>
                            <field name="priority"/>
                        </group>
                        <group string="Amounts">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="days_overdue"/>
                        </group>
                    </group>
                    <group string="M27">
                        <field name="m27_reference"/>
                        <field name="picked_up_by_id"/>
                        <field name="picked_up_at"/>
                        <field name="closed_by_id"/>
                        <field name="closed_at"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_ar_dunning_handoff" model="ir.actions.act_window">
        <field name="name">Dunning Call Handoffs (M27)</field>
        <field name="res_model">fix.ar.dunning.handoff</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
