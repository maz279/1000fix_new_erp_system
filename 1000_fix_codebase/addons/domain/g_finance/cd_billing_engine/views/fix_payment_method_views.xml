<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fix_payment_method_list" model="ir.ui.view">
        <field name="name">fix.payment.method.list</field>
        <field name="model">fix.payment.method</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="method_type"/>
                <field name="receipt_method"/>
                <field name="journal_id"/>
                <field name="fee_pct"/>
                <field name="settlement_days"/>
                <field name="for_counter"/>
                <field name="for_field"/>
                <field name="for_portal"/>
                <field name="for_corporate"/>
                <field name="note"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_fix_payment_method" model="ir.actions.act_window">
        <field name="name">Customer Payment Methods</field>
        <field name="res_model">fix.payment.method</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_fix_payment_method"
              name="Customer Payment Methods"
              parent="account.menu_finance_configuration"
              action="action_fix_payment_method"
              sequence="40"/>
</odoo>
