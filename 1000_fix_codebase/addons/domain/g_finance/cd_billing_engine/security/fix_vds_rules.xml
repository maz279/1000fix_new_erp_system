<?xml version="1.0" encoding="utf-8"?>
<!-- cd_billing_engine: company isolation for the Mushak 6.6 received
     certificates (A08 M20). Hand-maintained alongside the generated
     fix_isolation_rules.xml, same rule shape. -->
<odoo>
    <record id="rule_fix_vds_certificate_received_company" model="ir.rule">
        <field name="name">fix.vds.certificate.received: allowed companies</field>
        <field name="model_id" ref="model_fix_vds_certificate_received"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_vds_certificate_received_operating_unit" model="ir.rule">
        <field name="name">fix.vds.certificate.received: allowed operating units (internal users)</field>
        <field name="model_id" ref="model_fix_vds_certificate_received"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('operating_unit_id', '=', False), ('operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
</odoo>
