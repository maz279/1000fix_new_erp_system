<?xml version="1.0" encoding="utf-8"?>
<!-- cd_fixed_asset_ext views — M49 (P08-M08). -->
<odoo>
    <record id="view_fix_fixed_asset_list" model="ir.ui.view">
        <field name="name">fix.fixed.asset.list</field>
        <field name="model">fix.fixed.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="gross"/>
                <field name="life_months"/>
                <field name="monthly_depreciation"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_fix_fixed_asset_form" model="ir.ui.view">
        <field name="name">fix.fixed.asset.form</field>
        <field name="model">fix.fixed.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accrue_month" type="object"
                            string="Accrue Month" invisible="state != 'active'"/>
                    <button name="action_dispose" type="object" string="Dispose"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="seam_id"/>
                        </group>
                        <group>
                            <field name="gross"/>
                            <field name="salvage"/>
                            <field name="life_months"/>
                            <field name="monthly_depreciation"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="budget_reference"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_fixed_asset" model="ir.actions.act_window">
        <field name="name">Fixed Assets</field>
        <field name="res_model">fix.fixed.asset</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fix_cwip_list" model="ir.ui.view">
        <field name="name">fix.cwip.entry.list</field>
        <field name="model">fix.cwip.entry</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="asset_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_fix_cwip" model="ir.actions.act_window">
        <field name="name">CWIP</field>
        <field name="res_model">fix.cwip.entry</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_fixed_assets" name="Fixed Assets"
              parent="cd_gl_ext.menu_ws_finance" action="action_fix_fixed_asset"
              sequence="30"/>
    <menuitem id="menu_fix_cwip" name="CWIP"
              parent="cd_gl_ext.menu_ws_finance" action="action_fix_cwip"
              sequence="40"/>
</odoo>
