<?xml version="1.0" encoding="utf-8"?>
<!-- cd_fixed_asset_ext views — M49 capex, depreciation runs, lifecycle,
     physical verification and IFRS 16 leases. -->
<odoo>
    <!-- ================= Capital budget ================= -->
    <record id="view_fix_capex_budget_list" model="ir.ui.view">
        <field name="name">fix.capex.budget.list</field>
        <field name="model">fix.capex.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fiscal_year"/>
                <field name="operating_unit_id" optional="show"/>
                <field name="amount"/>
                <field name="committed_amount"/>
                <field name="available_amount"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_fix_capex_budget_form" model="ir.ui.view">
        <field name="name">fix.capex.budget.form</field>
        <field name="model">fix.capex.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="fiscal_year"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="operating_unit_id"/>
                            <field name="category_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="committed_amount"/>
                            <field name="actual_amount"/>
                            <field name="available_amount"/>
                            <field name="utilisation_pct"/>
                            <field name="prepared_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="request_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="title"/>
                            <field name="amount"/>
                            <field name="actual_cost"/>
                            <field name="state"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Capex request ================= -->
    <record id="view_fix_capex_request_list" model="ir.ui.view">
        <field name="name">fix.capex.request.list</field>
        <field name="model">fix.capex.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="request_date"/>
                <field name="budget_id"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_fix_capex_request_form" model="ir.ui.view">
        <field name="name">fix.capex.request.form</field>
        <field name="model">fix.capex.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"/>
                    <button name="action_create_cwip" type="object" string="Open CWIP Project"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="request_date"/>
                            <field name="operating_unit_id"/>
                            <field name="category_id"/>
                            <field name="life_months"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="budget_id"/>
                            <field name="amount"/>
                            <field name="actual_cost"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id"/>
                            <field name="approved_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Business Justification">
                        <field name="justification" nolabel="1" colspan="2"/>
                    </group>
                    <group invisible="state != 'rejected'">
                        <field name="rejection_reason"/>
                    </group>
                    <field name="cwip_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="amount"/>
                            <field name="state"/>
                            <field name="asset_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Depreciation run ================= -->
    <record id="view_fix_asset_depreciation_run_list" model="ir.ui.view">
        <field name="name">fix.asset.depreciation.run.list</field>
        <field name="model">fix.asset.depreciation.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="book"/>
                <field name="period_start"/>
                <field name="asset_count"/>
                <field name="total_amount"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_fix_asset_depreciation_run_form" model="ir.ui.view">
        <field name="name">fix.asset.depreciation.run.form</field>
        <field name="model">fix.asset.depreciation.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="oe_highlight" invisible="state == 'posted'"/>
                    <button name="action_post" type="object" string="Post"
                            class="oe_highlight" invisible="state != 'computed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="book" readonly="state != 'draft'"/>
                            <field name="period_start" readonly="state != 'draft'"/>
                            <field name="operating_unit_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="asset_count"/>
                            <field name="total_amount"/>
                            <field name="move_ids" widget="many2many_tags"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="asset_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                    <field name="note"/>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="asset_id"/>
                            <field name="category_id"/>
                            <field name="amount" sum="Total"/>
                            <field name="move_id"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Transfer ================= -->
    <record id="view_fix_asset_transfer_form" model="ir.ui.view">
        <field name="name">fix.asset.transfer.form</field>
        <field name="model">fix.asset.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm Transfer"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="date"/>
                            <field name="operating_unit_id"/>
                            <field name="to_custodian_id"/>
                        </group>
                        <group>
                            <field name="from_operating_unit_id"/>
                            <field name="from_custodian_id"/>
                            <field name="done_by_id"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Reason for the move"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Revaluation / impairment ================= -->
    <record id="view_fix_asset_revaluation_form" model="ir.ui.view">
        <field name="name">fix.asset.revaluation.form</field>
        <field name="model">fix.asset.revaluation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Approve &amp; Post"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="kind"/>
                            <field name="date"/>
                            <field name="new_value"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id"/>
                        </group>
                        <group>
                            <field name="carrying_amount"/>
                            <field name="cost_delta"/>
                            <field name="accum_delta"/>
                            <field name="surplus_amount"/>
                            <field name="pl_amount"/>
                            <field name="move_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="basis" placeholder="Valuer report / impairment indicators and value-in-use basis"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Disposal ================= -->
    <record id="view_fix_asset_disposal_form" model="ir.ui.view">
        <field name="name">fix.asset.disposal.form</field>
        <field name="model">fix.asset.disposal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Post"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'approved')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="kind"/>
                            <field name="date"/>
                            <field name="partner_id" invisible="kind != 'sale'"/>
                            <field name="proceeds" invisible="kind == 'write_off'"/>
                            <field name="proceeds_account_id" invisible="kind == 'write_off'"/>
                            <field name="requested_by_id"/>
                            <field name="approved_by_id"/>
                        </group>
                        <group>
                            <field name="cost"/>
                            <field name="accumulated"/>
                            <field name="nbv"/>
                            <field name="gain_loss"/>
                            <field name="move_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Reason / approval memo"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Physical verification ================= -->
    <record id="view_fix_asset_verification_campaign_form" model="ir.ui.view">
        <field name="name">fix.asset.verification.campaign.form</field>
        <field name="model">fix.asset.verification.campaign</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start Count"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close Campaign"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="operating_unit_id"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="expected_count"/>
                            <field name="found_count"/>
                            <field name="misplaced_count"/>
                            <field name="missing_count"/>
                            <field name="unregistered_count"/>
                            <field name="pending_count"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="asset_id"/>
                            <field name="asset_code"/>
                            <field name="operating_unit_id"/>
                            <field name="scanned_tag"/>
                            <field name="scanned_operating_unit_id"/>
                            <field name="result"/>
                            <field name="note"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ================= Leases (IFRS 16) ================= -->
    <record id="view_fix_lease_form" model="ir.ui.view">
        <field name="name">fix.lease.form</field>
        <field name="model">fix.lease</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate (Commence)"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_post_due" type="object" string="Post Due Months"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <field name="reference" readonly="1"/>
                        <h1><field name="name" placeholder="Branch premises lease"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="operating_unit_id"/>
                            <field name="commencement_date"/>
                            <field name="term_months"/>
                            <field name="end_date"/>
                            <field name="exemption"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="payment_amount"/>
                            <field name="payment_timing"/>
                            <field name="ibr_percent"/>
                            <field name="prepaid_payments"/>
                            <field name="initial_direct_costs"/>
                            <field name="pv_preview"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Accounting">
                        <group>
                            <field name="category_id"/>
                            <field name="liability_account_id"/>
                            <field name="interest_account_id"/>
                            <field name="payment_account_id"/>
                        </group>
                        <group>
                            <field name="initial_liability"/>
                            <field name="rou_amount"/>
                            <field name="liability_balance"/>
                            <field name="interest_to_date"/>
                            <field name="asset_id"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                    <field name="schedule_line_ids" readonly="1">
                        <list>
                            <field name="sequence"/>
                            <field name="period_start"/>
                            <field name="opening"/>
                            <field name="payment" sum="Total"/>
                            <field name="interest" sum="Total"/>
                            <field name="principal" sum="Total"/>
                            <field name="closing"/>
                            <field name="depreciation" sum="Total"/>
                            <field name="state"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fix_lease" model="ir.actions.act_window">
        <field name="name">Leases (IFRS 16)</field>
        <field name="res_model">fix.lease</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
