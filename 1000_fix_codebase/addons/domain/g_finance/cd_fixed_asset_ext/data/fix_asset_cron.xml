<?xml version="1.0" encoding="utf-8"?>
<!-- A08 M49-11: a monthly job PREPARES the depreciation run of each book for a
     person to check and post. It never posts: no journal entry comes from it. -->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_prepare_depreciation_runs" model="ir.cron">
            <field name="name">M49: prepare the month's depreciation runs (never posts)</field>
            <field name="model_id" ref="model_fix_asset_depreciation_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_prepare_monthly_runs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(datetime.now() + relativedelta(months=1)).strftime('%Y-%m-01 00:00:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
