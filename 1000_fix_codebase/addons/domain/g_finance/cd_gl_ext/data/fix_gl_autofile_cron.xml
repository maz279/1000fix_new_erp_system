<?xml version="1.0" encoding="utf-8"?>
<!--
  A10 deep audit (2026-11-23, D-A10-2): the nightly convergence for the M24
  finance auto-file. An invoice posted while the renderer was down (or before
  this bridge shipped) is filed on the next run; the idempotency guard means
  a normal night files nothing.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_gl_autofile_invoices" model="ir.cron">
            <field name="name">M19: file missing invoice documents in the M24 repository</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.cron_autofile_invoices()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
