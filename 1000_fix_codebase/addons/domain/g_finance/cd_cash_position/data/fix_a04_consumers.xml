<?xml version="1.0" encoding="utf-8"?>
<!-- A04 report §6 C7: the storefront refund hand-off. An approved return
     refunds the customer's money back the way it came (a pending M50
     instruction on the order's rail, treasury releases it), or a draft M20
     credit note against the order's invoice when one exists (Mushak 6.7). -->
<odoo>
    <data noupdate="1">

        <record id="consumer_a04_storefront_refund_approved" model="fix.event.consumer">
            <field name="name">M50/M20: an approved storefront refund raises its money-back document</field>
            <field name="event_type">storefront.refund_approved</field>
            <field name="model">fix.a04.storefront.consumers</field>
            <field name="method">consume_storefront_refund_approved</field>
            <field name="module">cd_cash_position</field>
        </record>

    </data>
</odoo>
