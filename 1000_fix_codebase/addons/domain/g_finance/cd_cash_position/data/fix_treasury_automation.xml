<?xml version="1.0" encoding="utf-8"?>
<!--
  A08 M50-18: treasury automation. Without these records the methods never
  ran: payment.requested events (expense claims, advance excesses, vendor
  bills) waited with no consumer, statements were matched only when someone
  pressed Auto-Match, and covenants were tested only by hand.
-->
<odoo>
    <data noupdate="1">

        <record id="consumer_payment_requested_treasury" model="fix.event.consumer">
            <field name="name">M50: payment requests become pinned draft instructions</field>
            <field name="event_type">payment.requested</field>
            <field name="model">fix.payment.execution</field>
            <field name="method">consume_payment_requested</field>
            <field name="module">cd_cash_position</field>
        </record>

        <record id="ir_cron_statement_auto_match" model="ir.cron">
            <field name="name">M50: auto-match imported bank statement lines</field>
            <field name="model_id" ref="model_fix_bank_statement_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_match()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_covenant_tests" model="ir.cron">
            <field name="name">M50: test approved facility covenants</field>
            <field name="model_id" ref="model_fix_facility_covenant"/>
            <field name="state">code</field>
            <field name="code">model._cron_test_covenants()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_unmatched_deposit_incidents" model="ir.cron">
            <field name="name">M50: incidents for cash deposits the bank has not credited</field>
            <field name="model_id" ref="model_fix_cash_deposit"/>
            <field name="state">code</field>
            <field name="code">model._cron_unmatched_deposit_incidents()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_lc_expiry_alerts" model="ir.cron">
            <field name="name">M50: LC / bank guarantee expiry alerts</field>
            <field name="model_id" ref="model_fix_bank_facility"/>
            <field name="state">code</field>
            <field name="code">model._cron_expiry_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- M50 capture audit (2026-11-17) -->
        <record id="ir_cron_settlement_exception_overdue" model="ir.cron">
            <field name="name">M50: settlement exceptions over 7 days (BRU-TRE-10)</field>
            <field name="model_id" ref="model_fix_settlement_exception"/>
            <field name="state">code</field>
            <field name="code">model._cron_overdue()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_forecast_accuracy" model="ir.cron">
            <field name="name">M50: measure saved cash forecast versions against actuals</field>
            <field name="model_id" ref="model_fix_cash_forecast_version"/>
            <field name="state">code</field>
            <field name="code">model._cron_measure()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
