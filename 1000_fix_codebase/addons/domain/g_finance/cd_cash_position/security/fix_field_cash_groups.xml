<?xml version="1.0" encoding="utf-8"?>
<!-- A08 B13 (M50-F5 / FR-TRE-017): the field technician's own cash day.
     Finance verifies through the account groups; a technician needs only
     their own reconciliation. The record rules in fix_field_cash_rules.xml
     keep it to the technician's own day. -->
<odoo>
    <record id="group_field_cash_technician" model="res.groups">
        <field name="name">Field Cash / Technician</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
