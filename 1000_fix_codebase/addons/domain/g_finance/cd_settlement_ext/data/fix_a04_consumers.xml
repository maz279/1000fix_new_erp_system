<?xml version="1.0" encoding="utf-8"?>
<!-- A04 report §6 C7 finance hand-offs (R8 consumers). The emit side landed
     with the C2-C13 controls; these rows are the consume side, so a
     commissioned marketplace order / referral and an approved rebate produce
     their finance document instead of stopping at the outbox (probe K13). -->
<odoo>
    <data noupdate="1">

        <record id="consumer_a04_commission_earned" model="fix.event.consumer">
            <field name="name">M53: commission ledger follows commission.earned (M12/M40)</field>
            <field name="event_type">commission.earned</field>
            <field name="model">fix.a04.finance.consumers</field>
            <field name="method">consume_commission_earned</field>
            <field name="module">cd_settlement_ext</field>
        </record>

        <record id="consumer_a04_partner_rebate_approved" model="fix.event.consumer">
            <field name="name">M50: an approved partner rebate raises its payout instruction</field>
            <field name="event_type">partner.rebate_approved</field>
            <field name="model">fix.a04.finance.consumers</field>
            <field name="method">consume_partner_rebate_approved</field>
            <field name="module">cd_settlement_ext</field>
        </record>

    </data>
</odoo>
