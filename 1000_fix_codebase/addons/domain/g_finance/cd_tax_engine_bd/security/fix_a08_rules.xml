<?xml version="1.0" encoding="utf-8"?>
<!-- A08 M51 (CD-M51-01): company isolation of the statutory master data and
     compliance records; operating-unit isolation of the transactional rows. -->
<odoo>
    <record id="rule_fix_tax_rate_company" model="ir.rule">
        <field name="name">fix.tax.rate: allowed companies</field>
        <field name="model_id" ref="model_fix_tax_rate"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
