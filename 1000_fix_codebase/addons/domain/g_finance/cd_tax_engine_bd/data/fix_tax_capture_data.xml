<?xml version="1.0" encoding="utf-8"?>
<!--
  M51 sub-module capture audit (2026-11-17): sequences of the 9.1 amendment
  and the NBR notice, the notice deadline job, and the high-value cash NID
  threshold as M51 statutory master data (FR-TAX-044, BRU-TAX-01: it used to
  be a hard-coded 50,000 in M20). No marketplace VAT model is seeded: until
  decision D-03 is settled the position is absent, never defaulted
  (BRU-TAX-17).
-->
<odoo noupdate="1">
    <record id="seq_fix_vat_return_amendment" model="ir.sequence">
        <field name="name">Mushak 9.1 Amendment</field>
        <field name="code">fix.vat.return.amendment</field>
        <field name="prefix">VRA/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_fix_tax_notice" model="ir.sequence">
        <field name="name">NBR Notice</field>
        <field name="code">fix.tax.notice</field>
        <field name="prefix">TXN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_tax_notice_deadlines" model="ir.cron">
        <field name="name">M51: NBR notice response deadlines</field>
        <field name="model_id" ref="model_fix_tax_notice"/>
        <field name="state">code</field>
        <field name="code">model._cron_notice_deadlines()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="tax_param_nid_cash" model="fix.tax.parameter">
        <field name="company_id" eval="False"/>
        <field name="key">nid_cash_threshold</field>
        <field name="value">50000</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">The value M20 applied before this row existed (FR-ARB-026, BDT 50,000). The statutory basis was not confirmed against a primary NBR text: confirm with the adviser.</field>
    </record>
</odoo>
