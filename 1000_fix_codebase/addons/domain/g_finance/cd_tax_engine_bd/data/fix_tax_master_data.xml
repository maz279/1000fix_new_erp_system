        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: advisory/consultancy 15% for individuals.</field>
    </record>
    <record id="tax_rate_tds_professional_any" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">tds</field>
        <field name="code">professional_fees</field>
        <field name="name">Advisory / consultancy - payee type unknown (individual rate)</field>
        <field name="section">ITA 2023 s.90</field>
        <field name="payee_type">any</field>
        <field name="rate">15</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Conservative fallback when the vendor tax profile does not state the payee type.</field>
    </record>
    <record id="tax_rate_tds_technical_company" model="fix.tax.rate">
