        <field name="section">ITA 2023 s.109</field>
        <field name="rate">10</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC 10% (raised from 5% in FY2025-26 per secondary sources). The previous engine default was 15%.</field>
    </record>
    <record id="tax_rate_tds_transport" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">tds</field>
        <field name="code">transport</field>
        <field name="name">Transport / carriage</field>
        <field name="section">ITA 2023 (section to confirm)</field>
        <field name="rate">3</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Carried over from the previous engine default (3%). Neither the section nor the rate was found in the research - the adviser must confirm.</field>
    </record>

    <!-- ===================== VDS (VAT at source) ===================== -->
    <record id="tax_rate_vds_rent" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">vds</field>
        <field name="code">S074.00</field>
        <field name="name">Rent of premises (VDS)</field>
        <field name="section">VAT &amp; SD Act 2012 VDS - service code S074.00</field>
        <field name="rate">15</field>
        <field name="non_filer_applies" eval="False"/>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Secondary source: rent service S074.00, VDS 15%. VDS rates for other service codes (2-15%) must be added from the current schedule by the adviser.</field>
    </record>

    <!-- ===================== VAT ===================== -->
    <record id="tax_rate_vat_standard" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">vat</field>
        <field name="code">standard</field>
        <field name="name">Standard VAT rate</field>
        <field name="section">VAT &amp; SD Act 2012</field>
        <field name="rate">15</field>
        <field name="non_filer_applies" eval="False"/>
        <field name="verify_with_adviser" eval="False"/>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC (reviewed 31 Jul 2026): standard rate 15%.</field>
    </record>
    <record id="tax_rate_vat_turnover" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">vat</field>
        <field name="code">turnover_tax</field>
        <field name="name">Turnover tax (enlisted suppliers, BDT 3m-5m)</field>
        <field name="section">VAT &amp; SD Act 2012 - enlistment</field>
        <field name="rate">4</field>
        <field name="non_filer_applies" eval="False"/>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: 4% for BDT 3m-5m turnover. FY2026-27 introduced a simplified fixed-amount turnover tax for small retailers.</field>
    </record>
    <!-- A08 M51-5: the reduced VAT rates the determination accepts were an
         in-code set (5 / 7.5 / 10). They are master rows now, read by
         fix.tax.rate._fix_vat_rates; flagged for the adviser. -->
    <record id="tax_rate_vat_reduced_5" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">vat</field>
        <field name="code">reduced_5</field>
        <field name="name">Reduced VAT rate 5%</field>
        <field name="section">VAT &amp; SD Act 2012 - Third Schedule</field>
        <field name="rate">5</field>
        <field name="non_filer_applies" eval="False"/>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Secondary source: reduced rates 5 / 7.5 / 10% on scheduled supplies. Verify the scheduled supplies with the adviser.</field>
    </record>
    <record id="tax_rate_vat_reduced_7_5" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
