<?xml version="1.0" encoding="utf-8"?>
<!--
  A08 M51 statutory MASTER DATA (CD-M51-01) - seeded defaults, editable.
  Rows carry no company: they are the statutory defaults for every company;
  a company-specific row overrides them.
  Basis: audit_analysis/A08_FINANCE_RESEARCH.md (FY2025-26; PwC tax summaries
  reviewed Jul 2026 plus secondary sources). Rows marked verify_with_adviser
  could not be confirmed against a primary NBR text: the company's VAT/tax
  adviser must confirm or correct them (Finance Act 2026 withholding changes
  were not readable at research time). noupdate: an adviser's correction is
  never overwritten by a module upgrade.
-->
<odoo noupdate="1">

    <!-- ===================== TDS (ITA 2023) ===================== -->
    <record id="tax_rate_tds_service_general" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">tds</field>
        <field name="code">service_general</field>
        <field name="name">Services not specified elsewhere</field>
        <field name="section">ITA 2023 s.90</field>
        <field name="rate">10</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC WHT summary (FY2025-26): other services 10%. Check the Finance Act 2026.</field>
    </record>
    <record id="tax_rate_tds_supply_of_goods" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">tds</field>
        <field name="code">supply_of_goods</field>
        <field name="name">Supply of goods - items not listed in the annexure</field>
        <field name="section">ITA 2023 s.89</field>
        <field name="rate">5</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: s.89 annexure, items not listed 5% (base excludes VAT). One source reports a 3/5/7% slab system instead - conflict.</field>
    </record>
    <record id="tax_rate_tds_service_contractor" model="fix.tax.rate">
