        <field name="payee_type">company</field>
        <field name="rate">10</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: technical services 10% (company) / 15% (individual).</field>
    </record>
    <record id="tax_rate_tds_technical_any" model="fix.tax.rate">
