    </record>
    <record id="tax_rate_vat_reduced_10" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">vat</field>
        <field name="code">reduced_10</field>
        <field name="name">Reduced VAT rate 10%</field>
        <field name="section">VAT &amp; SD Act 2012 - Third Schedule</field>
        <field name="rate">10</field>
        <field name="non_filer_applies" eval="False"/>
        <field name="date_from">2025-07-01</field>
