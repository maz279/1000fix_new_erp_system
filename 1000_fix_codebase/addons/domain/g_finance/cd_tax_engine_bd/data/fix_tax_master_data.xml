        <field name="rate">5</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: manufacturing/construction/engineering 5%. The previous engine default was 7.5%.</field>
    </record>
    <record id="tax_rate_tds_professional_company" model="fix.tax.rate">
