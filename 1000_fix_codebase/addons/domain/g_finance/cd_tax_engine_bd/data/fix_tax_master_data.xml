        <field name="payee_type">company</field>
        <field name="rate">7.5</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: advisory/consultancy 7.5% (company) / 15% (individual).</field>
    </record>
    <record id="tax_rate_tds_professional_individual" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">tds</field>
        <field name="code">professional_fees</field>
