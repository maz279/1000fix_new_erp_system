        <field name="section">ITA 2023 s.90</field>
        <field name="rate">1</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: 10% on commission or 1% on gross.</field>
    </record>
    <record id="tax_rate_tds_commission" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">tds</field>
        <field name="code">commission</field>
        <field name="name">Commission, discount and fees</field>
