    </record>

    <!-- ===================== Statutory parameters ===================== -->
    <record id="tax_param_non_filer" model="fix.tax.parameter">
        <field name="company_id" eval="False"/>
        <field name="key">non_filer_multiplier</field>
        <field name="value">1.5</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: withholding increases by 50% when the payee shows no proof of return submission (PSR). Which sections it applies to: confirm with the adviser.</field>
    </record>
    <record id="tax_param_mushak610" model="fix.tax.parameter">
        <field name="company_id" eval="False"/>
        <field name="key">mushak610_threshold</field>
        <field name="value">200000</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Secondary: Rule 42 - invoices above BDT 200,000 reported on Mushak 6.10.</field>
    </record>
    <record id="tax_param_input_window" model="fix.tax.parameter">
        <field name="company_id" eval="False"/>
        <field name="key">input_credit_window_periods</field>
        <field name="value">4</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Domain knowledge (not confirmed online): input tax is claimed in the invoice period or the following four tax periods.</field>
    </record>
    <record id="tax_param_rtgs_min" model="fix.tax.parameter">
        <field name="company_id" eval="False"/>
        <field name="key">rtgs_min_amount</field>
        <field name="value">100000</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Bangladesh Bank: BD-RTGS customer BDT transfers of BDT 100,000 and above (hours revised 5 Oct 2025).</field>
    </record>

    <!-- ===================== Statutory calendar rules ===================== -->
    <record id="due_rule_vat_91" model="fix.statutory.due.rule">
        <field name="company_id" eval="False"/>
        <field name="obligation">vat_91_return</field>
        <field name="name">Mushak 9.1 return and VAT payment</field>
        <field name="frequency">monthly</field>
        <field name="due_day">15</field>
        <field name="month_offset">1</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">15th of the following month - widely reported (secondary).</field>
    </record>
    <record id="due_rule_tds_deposit" model="fix.statutory.due.rule">
        <field name="company_id" eval="False"/>
        <field name="obligation">tds_deposit</field>
        <field name="name">Deposit of income tax withheld (TDS)</field>
        <field name="frequency">monthly</field>
        <field name="due_day">14</field>
        <field name="month_offset">1</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Deposit timing under the Withholding Tax Rules 2024 is unverified; seeded as two weeks after month end - confirm with the adviser.</field>
    </record>
    <record id="due_rule_vds_deposit" model="fix.statutory.due.rule">
        <field name="company_id" eval="False"/>
        <field name="obligation">vds_deposit</field>
        <field name="name">Deposit of VAT deducted at source (VDS)</field>
        <field name="frequency">monthly</field>
        <field name="due_day">7</field>
        <field name="month_offset">1</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Sources conflict ("within 15 working days" vs "by the 7th of the next period"); the earlier date is seeded - confirm with the adviser.</field>
    </record>
    <record id="due_rule_wht_return" model="fix.statutory.due.rule">
        <field name="company_id" eval="False"/>
        <field name="obligation">wht_return</field>
        <field name="name">Quarterly withholding tax return</field>
        <field name="frequency">quarterly</field>
        <field name="due_day">25</field>
        <field name="month_offset">1</field>
        <field name="verify_with_adviser" eval="False"/>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: quarterly, due on the 25th of the month after quarter end.</field>
    </record>
    <record id="due_rule_company_itr" model="fix.statutory.due.rule">
        <field name="company_id" eval="False"/>
        <field name="obligation">company_itr</field>
        <field name="name">Company income tax return</field>
        <field name="frequency">annual</field>
        <field name="due_day">15</field>
        <field name="month_offset">7</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">Seeded as the 15th day of the seventh month after the 30 June income-year end - confirm with the adviser.</field>
    </record>

</odoo>
