        <field name="source_note">PwC: sharing-economy platform services including repair 2%.</field>
    </record>
    <record id="tax_rate_tds_courier_training_event" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">tds</field>
        <field name="code">courier_training_event</field>
