        <field name="section">ITA 2023 s.90</field>
        <field name="rate">2</field>
        <field name="date_from">2025-07-01</field>
        <field name="source_note">PwC: catering, event, courier and training 2% of gross.</field>
    </record>
    <record id="tax_rate_tds_manpower_gross" model="fix.tax.rate">
        <field name="company_id" eval="False"/>
        <field name="tax_kind">tds</field>
        <field name="code">manpower_gross</field>
