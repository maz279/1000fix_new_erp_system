<?xml version="1.0" encoding="utf-8"?>
<!-- cd_tax_engine_bd return views (P07-M04) — Finance workspace. -->
<odoo>

    <record id="view_fix_vat_return_tree" model="ir.ui.view">
        <field name="name">fix.vat.return.tree</field>
        <field name="model">fix.vat.return</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'filed'" decoration-muted="nil_return == True">
                <field name="period"/>
                <field name="currency_id" invisible="1"/>
                <field name="output_vat"/>
                <field name="input_vat" optional="show"/>
                <field name="opening_credit" optional="hide"/>
                <field name="credit_used" optional="hide"/>
                <field name="net_payable"/>
                <field name="closing_credit" optional="show"/>
                <field name="nil_return" optional="show" string="Nil"/>
                <field name="due_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fix_vat_return_form" model="ir.ui.view">
        <field name="name">fix.vat.return.form</field>
        <field name="model">fix.vat.return</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prepare" type="object" string="Prepare from Registers" invisible="state == 'filed'"/>
                    <button name="action_subledger_reconciliation" type="object" string="Reconcile Sub-Ledger" class="btn-primary" invisible="state == 'filed'"/>
                    <button name="action_file_online" type="object" string="Submit to NBR (INT-038)" class="btn-success" invisible="state == 'filed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,prepared,filed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="period" readonly="state != 'draft'" placeholder="YYYY-MM"/> — Mushak 9.1</h1></div>
                    <group>
                        <group string="Statutory Return Amounts">
                            <field name="currency_id" invisible="1"/>
                            <field name="total_taxable"/>
                            <field name="output_vat"/>
                            <field name="input_vat"/>
                            <field name="opening_credit"/>
                            <field name="credit_used"/>
                            <field name="net_payable"/>
                            <field name="closing_credit"/>
                            <field name="vds_received_credit"/>
                            <field name="net_payable_after_vds"/>
                        </group>
                        <group string="Filing &amp; NBR Status">
                            <field name="nil_return"/>
                            <field name="due_date" readonly="1"/>
                            <field name="filed_at" readonly="1"/>
                            <field name="nbr_confirmation" readonly="1"/>
                        </group>
                    </group>
                    <group string="Mushak 9.1 Lines by Treatment">
                        <field name="treatment_breakdown" readonly="1"/>
                        <field name="classification_notes" readonly="1" invisible="not classification_notes"/>
                    </group>
                    <notebook>
                        <page string="Input Credits Claimed">
                            <field name="input_credit_ids" readonly="1">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="supplier_mushak_no"/>
                                    <field name="invoice_date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="vat_amount" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Challans">
                            <field name="challan_ids" readonly="1">
                                <list>
                                    <field name="challan_no"/>
                                    <field name="challan_date"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Sub-Ledger Reconciliation (GL 210100 &amp; 110500)">
                        <group>
                            <field name="subledger_status" widget="badge"/>
                            <field name="subledger_output_variance"/>
                            <field name="subledger_input_variance"/>
                        </group>
                        <group>
                            <field name="subledger_reconciled_at" readonly="1"/>
                            <field name="subledger_notes" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fix_tds_return_tree" model="ir.ui.view">
        <field name="name">fix.tds.return.tree</field>
        <field name="model">fix.tds.return</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'filed'">
                <field name="quarter"/>
                <field name="fiscal_year"/>
                <field name="currency_id" invisible="1"/>
                <field name="total_withheld"/>
                <field name="deductor_count" optional="show"/>
                <field name="due_date"/>
                <field name="nbr_acknowledgment" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fix_tds_return_form" model="ir.ui.view">
        <field name="name">fix.tds.return.form</field>
        <field name="model">fix.tds.return</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Records a filing done on the NBR portal: the acknowledgment number NBR
                         issued must be entered first (the action refuses without it). -->
                    <button name="action_prepare" type="object" string="Prepare from Deductions" invisible="state == 'filed'"/>
                    <button name="action_file" type="object" string="Record NBR Filing" class="btn-primary" invisible="state == 'filed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,prepared,filed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="quarter" readonly="state != 'draft'" placeholder="2026-Q1 (Jul-Sep 2026)"/> — TDS Quarterly Return</h1></div>
                    <group>
                        <group>
                            <field name="fiscal_year" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_withheld"/>
                            <field name="deductor_count"/>
                        </group>
                        <group>
                            <field name="due_date" readonly="1"/>
                            <field name="filed_at" readonly="1"/>
                            <field name="nbr_acknowledgment" readonly="state == 'filed'"
                                   placeholder="Acknowledgment No. issued by NBR"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Withholding Breakdown Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="vendor_name"/>
                                    <field name="vendor_tin"/>
                                    <field name="vendor_bin"/>
                                    <field name="section_code"/>
                                    <field name="base_amount"/>
                                    <field name="rate_percent"/>
                                    <field name="tds_amount"/>
                                    <field name="challan_no"/>
                                    <field name="challan_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fix_withholding_certificate_tree" model="ir.ui.view">
        <field name="name">fix.withholding.certificate.tree</field>
        <field name="model">fix.withholding.certificate</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'issued'">
                <field name="certificate_no"/>
                <field name="certificate_type"/>
                <field name="supplier_name"/>
                <field name="supplier_bin" optional="show"/>
                <field name="currency_id" invisible="1"/>
                <field name="base_amount"/>
                <field name="withheld_amount"/>
                <field name="issued_at"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fix_withholding_certificate_form" model="ir.ui.view">
        <field name="name">fix.withholding.certificate.form</field>
        <field name="model">fix.withholding.certificate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_issue" type="object" string="Issue Statutory Certificate" class="btn-primary" invisible="state == 'issued'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="certificate_no" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Certificate Info">
                            <field name="certificate_type"/>
                            <field name="supplier_name"/>
                            <field name="supplier_bin" invisible="certificate_type != 'mushak_6_6'"/>
                            <field name="supplier_tin" invisible="certificate_type != 'section_52_income_tax'"/>
                            <field name="supplier_address"/>
                        </group>
                        <group string="Financials &amp; Challan">
                            <field name="currency_id" invisible="1"/>
                            <field name="base_amount"/>
                            <field name="rate_percent"/>
                            <field name="withheld_amount"/>
                            <field name="challan_no"/>
                            <field name="challan_date"/>
                            <field name="bank_branch"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_vat_return" model="ir.actions.act_window">
        <field name="name">VAT Returns</field>
        <field name="res_model">fix.vat.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fix_tds_return" model="ir.actions.act_window">
        <field name="name">TDS Returns</field>
        <field name="res_model">fix.tds.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fix_withholding_certificate" model="ir.actions.act_window">
        <field name="name">Withholding Certificates</field>
        <field name="res_model">fix.withholding.certificate</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
