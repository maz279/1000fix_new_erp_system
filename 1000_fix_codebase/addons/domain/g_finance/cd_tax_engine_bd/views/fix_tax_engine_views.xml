<?xml version="1.0" encoding="utf-8"?>
<!-- cd_tax_engine_bd views — VAT treatments + the Mushak register (Finance workspace). -->
<odoo>

    <record id="view_fix_mushak_register_tree" model="ir.ui.view">
        <field name="name">fix.mushak.register.tree</field>
        <field name="model">fix.mushak.register</field>
        <field name="arch" type="xml">
            <tree>
                <field name="mushak_no"/>
                <field name="invoice_date"/>
                <field name="customer_name"/>
                <field name="taxable_amount"/>
                <field name="vat_amount"/>
                <field name="total_payable"/>
                <field name="posted" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_fix_mushak_register_form" model="ir.ui.view">
        <field name="name">fix.mushak.register.form</field>
        <field name="model">fix.mushak.register</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="mushak_no" readonly="1"/></h1></div>
                    <group>
                        <group string="Invoice">
                            <field name="invoice_ref"/>
                            <field name="invoice_date"/>
                            <field name="source_event_id" readonly="1"/>
                            <field name="posted" readonly="1"/>
                        </group>
                        <group string="Parties">
                            <field name="supplier_name"/>
                            <field name="supplier_bin"/>
                            <field name="customer_name"/>
                            <field name="customer_bin"/>
                        </group>
                        <group string="Amounts">
                            <field name="currency_id" invisible="1"/>
                            <field name="taxable_amount"/>
                            <field name="vat_amount"/>
                            <field name="total_payable"/>
                        </group>
                        <group string="Determination">
                            <field name="treatment_summary"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fix_mushak_register_search" model="ir.ui.view">
        <field name="name">fix.mushak.register.search</field>
        <field name="model">fix.mushak.register</field>
        <field name="arch" type="xml">
            <search>
                <field name="mushak_no"/>
                <field name="invoice_ref"/>
                <field name="customer_name"/>
                <field name="customer_bin"/>
                <filter name="filter_unposted" string="Unposted" domain="[('posted', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_date" string="Invoice Date" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fix_mushak_register" model="ir.actions.act_window">
        <field name="name">Mushak 6.3 Register</field>
        <field name="res_model">fix.mushak.register</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_fix_vat_treatment_tree" model="ir.ui.view">
        <field name="name">fix.vat.treatment.tree</field>
        <field name="model">fix.vat.treatment</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="treatment_type"/>
                <field name="rate"/>
                <field name="truncated_base" optional="hide"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_fix_vat_treatment" model="ir.actions.act_window">
        <field name="name">VAT Treatments</field>
        <field name="res_model">fix.vat.treatment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_fix_mushak_register" name="Mushak 6.3 Register"
              parent="cd_gl_ext.menu_ws_finance" action="action_fix_mushak_register" sequence="30"/>
    <menuitem id="menu_fix_vat_treatment" name="VAT Treatments"
              parent="cd_gl_ext.menu_ws_finance" action="action_fix_vat_treatment" sequence="40"/>

</odoo>
