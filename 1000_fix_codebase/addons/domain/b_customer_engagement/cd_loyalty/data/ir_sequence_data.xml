<?xml version="1.0" encoding="utf-8"?>
<!-- M10 membership numbers. Without this sequence every account was created
     with the placeholder number "NEW". -->
<odoo noupdate="1">
    <record id="seq_fix_loyalty_account" model="ir.sequence">
        <field name="name">Loyalty Membership Number</field>
        <field name="code">fix.loyalty.account</field>
        <field name="prefix">LYL/</field>
        <field name="padding">7</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
