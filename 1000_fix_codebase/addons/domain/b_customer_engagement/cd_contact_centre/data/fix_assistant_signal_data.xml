<?xml version="1.0" encoding="utf-8"?>
<!-- M32 capture pass 3: the safety floor of the handoff signal phrases
     (BRU-CAI-06/07). English only: Bengali phrases are authored by a native
     speaker (T08) and added by the Customer Service Manager on the M32
     Handoff Decision page. noupdate, so the register is theirs once installed. -->
<odoo noupdate="1">
    <record id="signal_phrase_distress_on_fire" model="fix.assistant.signal.phrase">
        <field name="signal">distress</field>
        <field name="phrase">caught fire</field>
        <field name="language">en</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="note">Appliance safety risk</field>
    </record>
