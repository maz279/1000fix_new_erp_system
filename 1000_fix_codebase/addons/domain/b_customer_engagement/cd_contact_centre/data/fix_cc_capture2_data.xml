<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- M27 capture pass 2 (FR-CCE-003): a callback whose promised window
         passed with nobody reached is marked missed, so the callback service
         level counts it. -->
    <record id="ir_cron_cc_callback_missed" model="ir.cron">
        <field name="name">Contact Centre: Mark Missed Callbacks</field>
        <field name="model_id" ref="model_fix_cc_callback"/>
        <field name="state">code</field>
        <field name="code">model._cron_mark_missed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
