<?xml version="1.0" encoding="utf-8"?>
<!-- cd_corporate_portal — P04 W4 slice: the R3 portal's Odoo-side surface. -->
<odoo>

    <!-- group_fix_corporate_portal moved to security/fix_corporate_portal_security.xml
         (loads before ir.model.access.csv, which references the group id) -->

    <!-- EA-05: a corporate user sees only their own contracts -->
    <record id="rule_fix_contract_corporate_self" model="ir.rule">
        <field name="name">P04: corporates see their own contracts</field>
        <field name="model_id" ref="cd_contract_core.model_fix_contract"/>
        <field name="groups" eval="[(4, ref('group_fix_corporate_portal'))]"/>
        <field name="domain_force">[('customer_id.partner_share', '=', True)]</field>
    </record>

    <record id="action_fix_contract_portal" model="ir.actions.act_window">
        <field name="name">My Contracts</field>
        <field name="res_model">fix.contract</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[(4, ref('group_fix_corporate_portal'))]"/>
    </record>

    <record id="action_fix_subscription_portal" model="ir.actions.act_window">
        <field name="name">My Subscriptions</field>
        <field name="res_model">fix.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="group_ids" eval="[(4, ref('group_fix_corporate_portal'))]"/>
    </record>

    <menuitem id="menu_corporate_portal_root" name="Corporate Portal"
              sequence="56" web_icon="cd_corporate_portal,static/description/icon.png"/>
    <menuitem id="menu_corporate_contracts" name="My Contracts"
              parent="menu_corporate_portal_root"
              action="action_fix_contract_portal" sequence="10"/>
    <menuitem id="menu_corporate_subscriptions" name="My Subscriptions"
              parent="menu_corporate_portal_root"
              action="action_fix_subscription_portal" sequence="20"/>

</odoo>
