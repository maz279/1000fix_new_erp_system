<?xml version="1.0" encoding="utf-8"?>
<!-- cd_corporate_portal security: the corporate-portal group + record rules.
     Loaded BEFORE ir.model.access.csv (the CSV references the group id). -->
<odoo>
    <record id="group_fix_corporate_portal" model="res.groups">
        <field name="name">P04 Corporate Portal</field>
        <field name="privilege_id" ref="cd_rbac_ext.privilege_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">P04 access: corporate users see their own contracts, subscriptions and estate (EA-05).</field>
    </record>

    <!-- EA-05: subscriptions and contact-centre conversations are scoped to
         the corporate user's own commercial partner (and its contacts). The
         ACL alone (ir.model.access.csv) let any corporate user read every
         tenant's rows. -->
    <record id="rule_fix_subscription_corporate_self" model="ir.rule">
        <field name="name">P04: corporates see their own subscriptions</field>
        <field name="model_id" ref="cd_subscription.model_fix_subscription"/>
        <field name="groups" eval="[(4, ref('group_fix_corporate_portal'))]"/>
        <field name="domain_force">[('customer_id', 'child_of', [user.commercial_partner_id.id])]</field>
    </record>
    <record id="rule_fix_conversation_corporate_self" model="ir.rule">
        <field name="name">P04: corporates see their own conversations</field>
        <field name="model_id" ref="cd_contact_centre.model_fix_conversation"/>
        <field name="groups" eval="[(4, ref('group_fix_corporate_portal'))]"/>
        <field name="domain_force">[('customer_id', 'child_of', [user.commercial_partner_id.id])]</field>
    </record>
</odoo>
