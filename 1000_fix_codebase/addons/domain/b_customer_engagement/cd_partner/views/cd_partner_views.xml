<?xml version="1.0" encoding="utf-8"?>
<!-- cd_partner views (P10). -->
<odoo>
    <record id="view_fix_partner_list" model="ir.ui.view">
        <field name="name">fix.partner.list</field>
        <field name="model">fix.partner</field>
        <field name="arch" type="xml">
            <list><field name="name"/></list>
        </field>
    </record>
    <record id="action_fix_partner" model="ir.actions.act_window">
        <field name="name">Partner</field>
        <field name="res_model">fix.partner</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_fix_referral_list" model="ir.ui.view">
        <field name="name">fix.referral.list</field>
        <field name="model">fix.referral</field>
        <field name="arch" type="xml">
            <list><field name="name"/></list>
        </field>
    </record>
    <record id="action_fix_referral" model="ir.actions.act_window">
        <field name="name">Referral</field>
        <field name="res_model">fix.referral</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_partner" name="Partner" parent="cd_entity_config.menu_fix_operations_root" action="action_fix_partner" sequence="300"/>
    <menuitem id="menu_fix_referral" name="Referral" parent="cd_entity_config.menu_fix_operations_root" action="action_fix_referral" sequence="310"/>
</odoo>
