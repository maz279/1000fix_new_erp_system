<?xml version="1.0" encoding="utf-8"?>
<!-- cd_storefront views (P10 / M38). -->
<odoo>
    <!-- Cart Views -->
    <record id="view_fix_storefront_cart_list" model="ir.ui.view">
        <field name="name">fix.storefront.cart.list</field>
        <field name="model">fix.storefront.cart</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="state"/>
                <field name="total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fix_storefront_cart_form" model="ir.ui.view">
        <field name="name">fix.storefront.cart.form</field>
        <field name="model">fix.storefront.cart</field>
        <field name="arch" type="xml">
            <form string="Storefront Cart">
                <header>
                    <button name="action_checkout" string="Proceed to Checkout" type="object" class="btn-primary" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,checkout,ordered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="operating_unit_id"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="total"/>
                            <field name="order_id" invisible="not order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="graded_stock_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" readonly="1"/>
                                    <field name="subtotal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_storefront_cart" model="ir.actions.act_window">
        <field name="name">Storefront Carts</field>
        <field name="res_model">fix.storefront.cart</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Cart Line Action -->
    <record id="view_fix_storefront_cart_line_list" model="ir.ui.view">
        <field name="name">fix.storefront.cart.line.list</field>
        <field name="model">fix.storefront.cart.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="cart_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="subtotal"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_fix_storefront_cart_line" model="ir.actions.act_window">
        <field name="name">Storefront Cart Lines</field>
        <field name="res_model">fix.storefront.cart.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Order Views -->
    <record id="view_fix_storefront_order_list" model="ir.ui.view">
        <field name="name">fix.storefront.order.list</field>
        <field name="model">fix.storefront.order</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'paid'" decoration-info="state == 'dispatched'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="order_date"/>
                <field name="payment_rail"/>
                <field name="payment_ref"/>
                <field name="shipping_method"/>
                <field name="total_amount"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fix_storefront_order_form" model="ir.ui.view">
        <field name="name">fix.storefront.order.form</field>
        <field name="model">fix.storefront.order</field>
        <field name="arch" type="xml">
            <form string="Storefront Customer Order">
                <header>
                    <!-- A04 audit M38-2: payment is confirmed by the gateway callback or,
                         from the workspace, against its M20 receipt; never by typing a TrxID here. -->
                    <button name="action_dispatch" string="Dispatch Order" type="object" class="btn-primary" invisible="state != 'paid' and not (state == 'pending_payment' and payment_rail == 'cod')"/>
                    <button name="action_deliver" string="Mark Delivered" type="object" class="btn-success" invisible="state != 'dispatched'"/>
                    <button name="action_cancel" string="Cancel Order" type="object" invisible="state not in ('draft', 'pending_payment', 'paid')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending_payment,paid,dispatched,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Order Information">
                            <field name="customer_id"/>
                            <field name="order_date"/>
                            <field name="cart_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="operating_unit_id"/>
                        </group>
                        <group string="Payment &amp; Fulfillment">
                            <field name="currency_id"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="payment_rail" readonly="1"/>
                            <field name="payment_ref" readonly="1"/>
                            <field name="payment_date" readonly="1"/>
                            <field name="shipping_method"/>
                            <field name="carrier_consignment_id" readonly="1"/>
                            <field name="slot_id" readonly="1"/>
                            <field name="delivered_at" readonly="1"/>
                            <field name="delivery_sla_status"/>
                            <field name="return_deadline"/>
                            <field name="refund_due" readonly="1" invisible="not refund_due"/>
                        </group>
                    </group>
                    <group string="Delivery Address">
                        <field name="shipping_address"/>
                    </group>
                    <notebook>
                        <page string="Items" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="graded_stock_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_storefront_order" model="ir.actions.act_window">
        <field name="name">Storefront Orders</field>
        <field name="res_model">fix.storefront.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Return Views -->
    <record id="view_fix_storefront_return_list" model="ir.ui.view">
        <field name="name">fix.storefront.return.list</field>
        <field name="model">fix.storefront.return</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="order_id"/>
                <field name="customer_id"/>
                <field name="reason"/>
                <field name="refund_amount"/>
                <field name="inspected_condition"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fix_storefront_return_form" model="ir.ui.view">
        <field name="name">fix.storefront.return.form</field>
        <field name="model">fix.storefront.return</field>
        <field name="arch" type="xml">
            <form string="Storefront Return &amp; RMA">
                <header>
                    <!-- A04 audit M38-5: the refund itself is approved from the M63 inbox
                         (Request Refund Approval); inspection and the credit note run from the workspace. -->
                    <button name="action_approve" string="Authorise Return" type="object" class="btn-primary" invisible="state != 'requested'"/>
                    <button name="action_request_approval" string="Request Refund Approval" type="object" class="btn-primary" invisible="state != 'received' or approval_state == 'pending'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('requested', 'approved', 'received')"/>
                    <field name="state" widget="statusbar" statusbar_visible="requested,approved,received,refund_approved,refunded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Originating Order">
                            <field name="order_id"/>
                            <field name="customer_id"/>
                            <field name="cart_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="operating_unit_id"/>
                        </group>
                        <group string="Return Details">
                            <field name="reason"/>
                            <field name="currency_id"/>
                            <field name="refund_amount" readonly="state != 'requested'"/>
                            <field name="carrier_consignment_id"/>
                            <field name="inspected_condition" readonly="1"/>
                            <field name="disposition" readonly="1"/>
                            <field name="approval_state" readonly="1"/>
                            <field name="dofa_tier_required" readonly="1"/>
                            <field name="dofa_justification"/>
                            <field name="credit_note_id" readonly="1"/>
                            <field name="credit_note_ref" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_storefront_return" model="ir.actions.act_window">
        <field name="name">Storefront Returns (RMA)</field>
        <field name="res_model">fix.storefront.return</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_fix_storefront_root" name="Digital Storefront" parent="cd_entity_config.menu_fix_operations_root" sequence="300"/>
    <menuitem id="menu_fix_storefront_order" name="Customer Orders" parent="menu_fix_storefront_root" action="action_fix_storefront_order" sequence="10"/>
    <menuitem id="menu_fix_storefront_cart" name="Active Carts" parent="menu_fix_storefront_root" action="action_fix_storefront_cart" sequence="20"/>
    <menuitem id="menu_fix_storefront_cart_line" name="Cart Lines" parent="menu_fix_storefront_root" action="action_fix_storefront_cart_line" sequence="30"/>
    <menuitem id="menu_fix_storefront_return" name="Returns &amp; Reverse Logistics" parent="menu_fix_storefront_root" action="action_fix_storefront_return" sequence="40"/>
</odoo>
