<?xml version="1.0" encoding="utf-8"?>
<!--
  A04 workflow audit C10 (2026-11-04). Both jobs run as the superuser, are
  idempotent and write through the guard's transition token.
  - The return window: a delivered order whose window has elapsed is closed
    for returns (fix.storefront.order.returns_closed).
  - Abandoned carts: an open cart untouched for the abandonment period is
    published once as storefront.cart_abandoned for the M35 recovery
    journeys (the consumer existed; no module produced the event).
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_storefront_close_return_windows" model="ir.cron">
            <field name="name">Storefront: close the return window of delivered orders</field>
            <field name="model_id" ref="model_fix_storefront_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_close_return_windows()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!-- A04 ERP audit (20 Nov 2026) M38-F7 / AUT-ECM-08: a prepaid order
             the gateway never confirmed is cancelled after the payment
             timeout (cd_storefront.payment_timeout_minutes), releasing what it
             reserved. -->
        <record id="ir_cron_storefront_expire_unpaid" model="ir.cron">
            <field name="name">Storefront: cancel prepaid orders past their payment timeout</field>
            <field name="model_id" ref="model_fix_storefront_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_expire_unpaid_orders()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_storefront_abandoned_carts" model="ir.cron">
            <field name="name">Storefront: publish abandoned carts for recovery</field>
            <field name="model_id" ref="model_fix_storefront_cart"/>
            <field name="state">code</field>
            <field name="code">model.cron_publish_abandoned_carts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
