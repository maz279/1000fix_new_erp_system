<?xml version="1.0" encoding="utf-8"?>
<!-- AS-03 company isolation of the M14 price grid (added by the A05 build;
     the generated fix_isolation_rules.xml predates the model). -->
<odoo>
    <record id="rule_fix_tradein_price_grid_company" model="ir.rule">
        <field name="name">fix.tradein.price.grid: allowed companies</field>
        <field name="model_id" ref="model_fix_tradein_price_grid"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <!-- A05 ERP remediation (20 Nov 2026): the refurbished-stock ledger and
         markdowns, company-isolated like every M14 model. -->
    <record id="rule_fix_refurb_ledger_company" model="ir.rule">
        <field name="name">fix.refurb.ledger: allowed companies</field>
        <field name="model_id" ref="model_fix_refurb_ledger"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_refurb_markdown_company" model="ir.rule">
        <field name="name">fix.refurb.markdown: allowed companies</field>
        <field name="model_id" ref="model_fix_refurb_markdown"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
