<?xml version="1.0" encoding="utf-8"?>
<!-- cd_marketplace security: P07 Marketplace Seller group + cross-tenant record rules (R08-M04-T01, G7-6).
     Loaded BEFORE ir.model.access.csv. -->
<odoo>
    <record id="group_fix_marketplace_seller" model="res.groups">
        <field name="name">P07 Marketplace Seller</field>
        <field name="privilege_id" ref="cd_rbac_ext.privilege_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">P07 access: marketplace sellers see their own profile, quotes, awarded orders, disputes, and scores (EA-05 cross-tenant isolation).</field>
    </record>

    <!-- Cross-tenant isolation rules (R08-M04-T01 / G7-6) -->
    <!-- A04 audit C1 (M12-2): a portal seller READS their profile and
         disputes and CREATES quotes; nothing more (ir.model.access.csv).
         With write on their own profile a seller set kyc_status=verified,
         cfo_approved, tier and payout_hold on themselves. The seller API
         (controllers/seller_api.py) only reads profiles and disputes and
         only creates quotes. -->
    <!-- Seller sees only their own seller profile -->
    <record id="rule_fix_marketplace_seller_self" model="ir.rule">
        <field name="name">P07 Seller: own seller profile only</field>
        <field name="model_id" ref="model_fix_marketplace_seller"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Seller sees only their own quotes -->
    <record id="rule_fix_seller_quote_self" model="ir.rule">
        <field name="name">P07 Seller: own quotes only</field>
        <field name="model_id" ref="model_fix_seller_quote"/>
        <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Seller sees open marketplace orders (to quote), or orders where they are the awarded seller -->
    <record id="rule_fix_marketplace_order_seller" model="ir.rule">
        <field name="name">P07 Seller: open or quoted (still bidding) or awarded orders only</field>
        <field name="model_id" ref="model_fix_marketplace_order"/>
        <field name="domain_force">['|', ('state', 'in', ('open', 'quoted')), ('revealed_seller_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Seller sees only their own performance scorecards -->
    <record id="rule_fix_seller_score_self" model="ir.rule">
        <field name="name">P07 Seller: own performance scorecards only</field>
        <field name="model_id" ref="model_fix_seller_score"/>
        <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Seller sees only their own disputes -->
    <record id="rule_fix_marketplace_dispute_self" model="ir.rule">
        <field name="name">P07 Seller: own disputes only</field>
        <field name="model_id" ref="model_fix_marketplace_dispute"/>
        <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- M12-stock (12 Nov 2026): a seller reports the stock behind their own
         listings (the seller API's /seller/stock) and sees only those
         positions. Who reported it and when are stamped by the server. -->
    <record id="rule_fix_seller_stock_self" model="ir.rule">
        <field name="name">P07 Seller: own stock positions only</field>
        <field name="model_id" ref="model_fix_seller_stock"/>
        <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- M12-training (12 Nov 2026): a seller reads their own certifications;
         compliance records and verifies them. -->
    <record id="rule_fix_seller_certification_self" model="ir.rule">
        <field name="name">P07 Seller: own certifications only</field>
        <field name="model_id" ref="model_fix_seller_certification"/>
        <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- M12 capture audit (13 Nov 2026): a seller reads the consequences
         imposed on them (FR-MKP-056); operators impose and decide them. -->
    <record id="rule_fix_seller_consequence_self" model="ir.rule">
        <field name="name">P07 Seller: own consequences only</field>
        <field name="model_id" ref="model_fix_seller_consequence"/>
        <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- M12 capture audit, second pass (19 Nov 2026): a seller reads the
         evidence of their own jobs and the reviews of their own work
         (FR-MKP-056). Trust & safety reports are not shown to the seller
         under investigation: no portal access right is granted. -->
    <record id="rule_fix_marketplace_job_evidence_self" model="ir.rule">
        <field name="name">P07 Seller: evidence of own jobs only</field>
        <field name="model_id" ref="model_fix_marketplace_job_evidence"/>
        <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_fix_seller_review_self" model="ir.rule">
        <field name="name">P07 Seller: published reviews of own work only</field>
        <field name="model_id" ref="model_fix_seller_review"/>
        <field name="domain_force">[('seller_id.partner_id', '=', user.partner_id.id), ('state', '=', 'published')]</field>
        <field name="groups" eval="[(4, ref('group_fix_marketplace_seller'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
