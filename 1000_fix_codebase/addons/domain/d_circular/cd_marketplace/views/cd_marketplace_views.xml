        <field name="name">Seller Score</field>
        <field name="res_model">fix.seller.score</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_marketplace_seller" name="Marketplace Seller" parent="cd_entity_config.menu_fix_operations_root" action="action_fix_marketplace_seller" sequence="300"/>
    <menuitem id="menu_fix_marketplace_order" name="Marketplace Order" parent="cd_entity_config.menu_fix_operations_root" action="action_fix_marketplace_order" sequence="310"/>
    <menuitem id="menu_fix_seller_quote" name="Seller Quote" parent="cd_entity_config.menu_fix_operations_root" action="action_fix_seller_quote" sequence="320"/>
    <menuitem id="menu_fix_seller_score" name="Seller Score" parent="cd_entity_config.menu_fix_operations_root" action="action_fix_seller_score" sequence="330"/>
