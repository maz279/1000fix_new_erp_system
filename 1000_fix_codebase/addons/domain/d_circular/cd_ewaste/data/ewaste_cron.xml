<?xml version="1.0" encoding="utf-8"?>
<!-- M18 scheduled jobs (A05 audit E12). Every method is safe to re-run. -->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_ewaste_licence_expiry" model="ir.cron">
            <field name="name">M18: expire lapsed recycler licences, Basel consents and DoE registrations</field>
            <field name="model_id" ref="model_fix_ewaste_partner"/>
            <field name="state">code</field>
            <field name="code">model.cron_licence_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_ewaste_storage_clock" model="ir.cron">
            <field name="name">M18: e-waste 180-day (+90) storage clock</field>
            <field name="model_id" ref="model_fix_ewaste_collection"/>
            <field name="state">code</field>
            <field name="code">model.cron_storage_clock()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_ewaste_return_due" model="ir.cron">
            <field name="name">M18: DoE / BTRC return due-date reminder</field>
            <field name="model_id" ref="model_fix_ewaste_return"/>
            <field name="state">code</field>
            <field name="code">model.cron_return_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_esg_metric_recompute" model="ir.cron">
            <field name="name">M18: recompute ESG metrics from the collections</field>
            <field name="model_id" ref="model_fix_esg_metric"/>
            <field name="state">code</field>
            <field name="code">model.cron_recompute()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!-- M18 capture pass 2: AUT-ESG-19 / BRU-ESG-16 -->
        <record id="ir_cron_ewaste_obligation_review" model="ir.cron">
            <field name="name">M18: flag regulatory obligations past their review date</field>
            <field name="model_id" ref="model_fix_ewaste_obligation"/>
            <field name="state">code</field>
            <field name="code">model.cron_review_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
