<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AS-03 isolation for the A05 remediation models (2026-11-20): the same
         company and operating-unit rules as the rental they belong to. -->
    <record id="rule_fix_rental_billing_company" model="ir.rule">
        <field name="name">fix.rental.billing: allowed companies</field>
        <field name="model_id" ref="model_fix_rental_billing"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_rental_billing_operating_unit" model="ir.rule">
        <field name="name">fix.rental.billing: allowed operating units (internal users)</field>
        <field name="model_id" ref="model_fix_rental_billing"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('operating_unit_id', '=', False), ('operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
    <record id="rule_fix_rental_deposit_reduction_company" model="ir.rule">
        <field name="name">fix.rental.deposit.reduction: allowed companies</field>
        <field name="model_id" ref="model_fix_rental_deposit_reduction"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_rental_retirement_company" model="ir.rule">
        <field name="name">fix.rental.retirement: allowed companies</field>
        <field name="model_id" ref="model_fix_rental_retirement"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
