                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_data_backup_plan" model="ir.actions.act_window">
        <field name="name">Backup Plans</field>
        <field name="res_model">fix.data.backup.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= Menus ================= -->
    <menuitem id="menu_fix_data_services" name="Data Services"
              parent="cd_entity_config.menu_fix_operations_root" sequence="200"/>
    <menuitem id="menu_fix_data_recovery_case" name="Recovery Cases" parent="menu_fix_data_services" action="action_fix_data_recovery_case" sequence="10"/>
    <menuitem id="menu_fix_data_attempts" name="Recovery Attempts" parent="menu_fix_data_services" action="action_fix_data_attempt" sequence="15"/>
    <menuitem id="menu_fix_data_media_units" name="Sealed Media Custody" parent="menu_fix_data_services" action="action_fix_data_media_unit" sequence="20"/>
    <menuitem id="menu_fix_data_cleanroom" name="Cleanroom Schedule" parent="menu_fix_data_services" action="action_fix_data_cleanroom" sequence="25"/>
    <menuitem id="menu_fix_data_evaluations" name="Free Evaluations" parent="menu_fix_data_services" action="action_fix_data_evaluation" sequence="30"/>
    <menuitem id="menu_fix_data_quotes" name="Firm Quotations" parent="menu_fix_data_services" action="action_fix_data_quote" sequence="35"/>
