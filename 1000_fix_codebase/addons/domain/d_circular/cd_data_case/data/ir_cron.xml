<?xml version="1.0" encoding="utf-8"?>
<!--
  M06 scheduled jobs (A02 audit B4).

  There was no retention field and no purge job, so recovered customer data
  stayed in Z4 indefinitely; and a backup plan's next restore test was never
  scheduled. The retention job purges only on a verified wipe certificate
  for the case's own media (action_purge keeps the P0 gate), and only when
  cd_data_case.retention_auto_purge is on; otherwise it flags the case once.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_data_case_retention_purge" model="ir.cron">
            <field name="name">M06: retention purge of handed-over cases</field>
            <field name="model_id" ref="model_fix_data_recovery_case"/>
            <field name="state">code</field>
            <field name="code">model.cron_retention_purge()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_data_backup_restore_test_due" model="ir.cron">
            <field name="name">M06: restore tests due on backup plans</field>
            <field name="model_id" ref="model_fix_data_backup_plan"/>
            <field name="state">code</field>
            <field name="code">model.cron_restore_test_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
