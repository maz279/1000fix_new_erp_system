<?xml version="1.0" encoding="utf-8"?>
<!-- cd_data_case sequences — the case/certificate/quote name generators
     (before this file every record was born "DRC/New" / "DWC/New"). -->
<odoo>
    <record id="seq_fix_data_recovery_case" model="ir.sequence">
        <field name="name">Data Recovery Case</field>
        <field name="code">fix.data.recovery.case</field>
        <field name="prefix">DRC/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_fix_data_wipe_certificate" model="ir.sequence">
        <field name="name">Data Wipe Certificate</field>
        <field name="code">fix.data.wipe.certificate</field>
        <field name="prefix">DWC/%(year)s/</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_fix_data_quote" model="ir.sequence">
        <field name="name">Data Recovery Quotation</field>
        <field name="code">fix.data.quote</field>
        <field name="prefix">DRQ/%(year)s/</field>
        <field name="padding">4</field>
    </record>
    <!-- M06 capture pass 2 (2026-11-18): wipe / destruction requests -->
    <record id="seq_fix_data_wipe_request" model="ir.sequence">
        <field name="name">Data Wipe Request</field>
        <field name="code">fix.data.wipe.request</field>
        <field name="prefix">WRQ/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>
