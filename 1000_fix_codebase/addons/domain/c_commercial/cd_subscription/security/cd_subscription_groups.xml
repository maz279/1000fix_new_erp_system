<?xml version="1.0" encoding="utf-8"?>
<!-- M39 subscription role (A04 workflow audit 2026-11-03 §7.1; C2-C13 build 2026-11-04).

     Any internal user created ACTIVE autopay mandates with a hand-typed
     reference, rewrote billed usage and typed proration credits. The work
     now goes to the role:

     - Subscription Officer: records usage readings, raises plan changes
       (prorations) for approval, captures autopay mandates and the
       customer's consent (OTP, or a signed form verified by ANOTHER
       officer), activates and revokes mandates.

     Cycle charges stay with billing (account.group_account_user), as before.
     A proration credit is approved under DOFA from the M63 inbox (tier
     holders); an upgrade by a billing user who did not raise it. Plain
     internal users keep read access. The dev admin is a member so daily work
     keeps running; segregation of duties still applies. -->
<odoo>
    <data noupdate="1">

        <record id="privilege_subscription" model="res.groups.privilege">
            <field name="name">Subscriptions</field>
            <field name="description">Usage metering, plan changes and autopay mandates (M39).</field>
            <field name="sequence">39</field>
        </record>

        <record id="group_subscription_officer" model="res.groups">
            <field name="name">Subscription Officer</field>
            <field name="privilege_id" ref="privilege_subscription"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Records usage, raises plan changes for approval, captures autopay mandates with the customer's consent, verifies signed mandate forms captured by others.</field>
        </record>

    </data>
</odoo>
