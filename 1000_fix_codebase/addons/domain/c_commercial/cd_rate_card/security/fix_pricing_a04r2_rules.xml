        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_price_override_log_company" model="ir.rule">
        <field name="name">fix.price.override.log: allowed companies</field>
        <field name="model_id" ref="model_fix_price_override_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_price_review_company" model="ir.rule">
        <field name="name">fix.price.review: allowed companies</field>
        <field name="model_id" ref="model_fix_price_review"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
