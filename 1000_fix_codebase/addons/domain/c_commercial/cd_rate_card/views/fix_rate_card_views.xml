<?xml version="1.0" encoding="utf-8"?>
<!-- cd_rate_card views — rate cards under the Service Orders workspace
     (pricing is where the estimate lives; NVR-24: one home). -->
<odoo>

    <record id="view_fix_rate_card_tree" model="ir.ui.view">
        <field name="name">fix.rate.card.tree</field>
        <field name="model">fix.rate.card</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_code"/>
                <field name="line_type"/>
                <field name="min_tier"/>
                <field name="contract_no" decoration-info="min_tier == 99"/>
                <field name="currency_id" invisible="1"/>
                <field name="unit_price"/>
                <field name="valid_from" optional="hide"/>
                <field name="valid_to" optional="hide"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_fix_rate_card" model="ir.actions.act_window">
        <field name="name">Rate Cards</field>
        <field name="res_model">fix.rate.card</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_rate_card" name="Rate Cards"
              parent="cd_entity_config.menu_fix_operations_root"
              action="action_fix_rate_card" sequence="40"/>

</odoo>
