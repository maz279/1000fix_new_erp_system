<?xml version="1.0" encoding="utf-8"?>
<!-- cd_contract_core views — the Contract workspace (UX-002 workspace 10, W4 slice). -->
<odoo>

    <record id="view_fix_contract_tree" model="ir.ui.view">
        <field name="name">fix.contract.tree</field>
        <field name="model">fix.contract</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-warning="state == 'expiring'"
                  decoration-muted="state in ('expired', 'terminated')">
                <field name="code"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="family"/>
                <field name="date_end"/>
                <field name="currency_id" invisible="1"/>
                <field name="annual_value"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_fix_contract_form" model="ir.ui.view">
        <field name="name">fix.contract.form</field>
        <field name="model">fix.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- A04 build (2026-11-04) C3: the lifecycle runs by its actions. -->
                    <button name="action_request_approval" type="object" string="Submit for Approval" invisible="state != 'draft'" groups="cd_contract_core.group_contract_officer"/>
                    <button name="action_legal_review" type="object" string="Legal Review" invisible="state != 'pending_approval' or not legal_review_required or legal_reviewed_by" groups="cd_contract_core.group_contract_legal"/>
                    <button name="action_approve_stamp_exemption" type="object" string="Approve Stamp Exemption" invisible="stamp_duty_applicable or stamp_exemption_approved_by" groups="account.group_account_manager"/>
                    <button name="action_activate" type="object" string="Activate" invisible="state != 'pending_signature'" groups="cd_contract_core.group_contract_officer"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state not in ('pending_approval', 'pending_signature')" groups="cd_contract_core.group_contract_officer"/>
                    <button name="action_renew" type="object" string="Renew" invisible="state not in ('active', 'expiring', 'expired')" groups="cd_contract_core.group_contract_officer"/>
                    <button name="action_resume" type="object" string="Resume" invisible="state != 'suspended'" groups="cd_contract_core.group_contract_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_approval,pending_signature,active,expiring,expired,terminated"/>
                    <field name="legal_review_required" invisible="1"/>
                    <field name="legal_reviewed_by" invisible="1"/>
                    <field name="stamp_exemption_approved_by" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="code" readonly="1"/></h1></div>
                    <group>
                        <group string="Terms">
                            <field name="name"/>
                            <field name="family"/>
                            <field name="customer_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Commercial">
                            <field name="currency_id" invisible="1"/>
                            <field name="annual_value"/>
                            <field name="escalation_pct"/>
                            <field name="auto_renew"/>
                            <field name="renewal_lead_days" invisible="not auto_renew"/>
                            <field name="esignature_envelope_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Covered Assets">
                            <field name="covered_device_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="device_model_id"/>
                                    <field name="warranty_status"/>
                                </list>
                            </field>
                        </page>
                        <page string="Entitlements">
                            <field name="entitlement_ids">
                                <list editable="bottom" create="true">
                                    <field name="entitlement_type"/>
                                    <field name="device_id" optional="show"/>
                                    <field name="quantity_included"/>
                                    <field name="quantity_consumed" readonly="1"/>
                                    <field name="quantity_remaining" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contract SLAs">
                            <field name="sla_policy_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fix_pm_visit_tree" model="ir.ui.view">
        <field name="name">fix.contract.pm.visit.tree</field>
        <field name="model">fix.contract.pm.visit</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'completed'" decoration-info="state == 'scheduled'">
                <field name="scheduled_date"/>
                <field name="contract_id"/>
                <field name="device_id"/>
                <field name="service_order_id" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_fix_contract" model="ir.actions.act_window">
        <field name="name">Contracts</field>
        <field name="res_model">fix.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fix_pm_visit" model="ir.actions.act_window">
        <field name="name">PM Schedule</field>
        <field name="res_model">fix.contract.pm.visit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ws_contract" name="Contracts"
              parent="cd_entity_config.menu_fix_operations_root"
              groups="cd_rbac_ext.group_fix_portal_user"
              sequence="100"/>
    <menuitem id="menu_fix_contract" name="All Contracts"
              parent="menu_ws_contract" action="action_fix_contract" sequence="10"/>
    <menuitem id="menu_fix_pm_visit" name="PM Schedule"
              parent="menu_ws_contract" action="action_fix_pm_visit" sequence="20"/>

</odoo>
