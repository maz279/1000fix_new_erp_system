<?xml version="1.0" encoding="utf-8"?>
<!-- M47 settings (A07 operability, 2026-11-07). -->
<odoo>
    <data noupdate="1">
        <!-- A NEW licence must carry its scan. Licences already on the register keep counting
             without one. Set to False only to load a batch whose scans follow later. -->
        <record id="param_require_licence_evidence" model="ir.config_parameter">
            <field name="key">cd_facility.require_licence_evidence</field>
            <field name="value">True</field>
        </record>

        <!-- A07 ERP audit (2026-11-20), owner decision D15: facility work-order SLA in hours
             (response = accepted, restore = completed) per priority. -->
        <record id="param_wo_sla_emergency_response" model="ir.config_parameter">
            <field name="key">cd_facility.wo_sla_emergency_response_hours</field>
            <field name="value">2</field>
        </record>
        <record id="param_wo_sla_emergency_restore" model="ir.config_parameter">
            <field name="key">cd_facility.wo_sla_emergency_restore_hours</field>
            <field name="value">8</field>
        </record>
        <record id="param_wo_sla_high_response" model="ir.config_parameter">
            <field name="key">cd_facility.wo_sla_high_response_hours</field>
            <field name="value">8</field>
        </record>
        <record id="param_wo_sla_high_restore" model="ir.config_parameter">
            <field name="key">cd_facility.wo_sla_high_restore_hours</field>
            <field name="value">48</field>
        </record>
        <record id="param_wo_sla_normal_response" model="ir.config_parameter">
            <field name="key">cd_facility.wo_sla_normal_response_hours</field>
            <field name="value">24</field>
        </record>
        <record id="param_wo_sla_normal_restore" model="ir.config_parameter">
            <field name="key">cd_facility.wo_sla_normal_restore_hours</field>
            <field name="value">120</field>
        </record>
        <record id="param_wo_sla_low_response" model="ir.config_parameter">
            <field name="key">cd_facility.wo_sla_low_response_hours</field>
            <field name="value">72</field>
        </record>
        <record id="param_wo_sla_low_restore" model="ir.config_parameter">
            <field name="key">cd_facility.wo_sla_low_restore_hours</field>
            <field name="value">360</field>
        </record>

        <!-- Owner decision D6: recording / terminating a lease is approved on its total
             commitment: up to this the Operations Director, above it the CFO (Tier 4) ... -->
        <record id="param_lease_approval_opsdir_limit" model="ir.config_parameter">
            <field name="key">cd_facility.lease_approval_opsdir_limit</field>
            <field name="value">1000000</field>
        </record>
        <!-- ... and above this the CEO (DOFA Tier 5). -->
        <record id="param_lease_approval_ceo_floor" model="ir.config_parameter">
            <field name="key">cd_facility.lease_approval_ceo_floor</field>
            <field name="value">10000000</field>
        </record>
    </data>
</odoo>
