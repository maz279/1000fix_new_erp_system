<?xml version="1.0" encoding="utf-8"?>
<!--
  A07 P1 (2026-11-04) M47-14: leases, licences, utilities, conditions, PM,
  safety equipment, incidents, projects, site assets and the new P1/P2
  records carry no company or operating unit of their own, and had no
  record rule: an OU-1 user read the rent and deposit of a site in OU 2 it
  could not even see. Each is now scoped through its site, as the site is
  (fix_isolation_rules.xml): allowed companies for everyone, allowed
  operating units for internal users. Hand-written (the generator only
  covers models with their own company/OU field).
-->
<odoo>
    <record id="rule_fix_site_lease_site_company" model="ir.rule">
        <field name="name">fix.site.lease: site in allowed companies</field>
        <field name="model_id" ref="model_fix_site_lease"/>
        <field name="domain_force">[('site_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_site_lease_site_operating_unit" model="ir.rule">
        <field name="name">fix.site.lease: site in allowed operating units (internal users)</field>
        <field name="model_id" ref="model_fix_site_lease"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('site_id.operating_unit_id', '=', False), ('site_id.operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
