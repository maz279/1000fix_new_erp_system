        <record id="seq_fix_asset_finance_request" model="ir.sequence">
            <field name="name">M49 Capitalisation / Disposal Request</field>
            <field name="code">fix.asset.finance.request</field>
            <field name="prefix">M49REQ/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
