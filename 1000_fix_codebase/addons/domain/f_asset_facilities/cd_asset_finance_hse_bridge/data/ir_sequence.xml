        <record id="seq_fix_asset_cost_entry" model="ir.sequence">
            <field name="name">M52 Asset Cost Entry</field>
            <field name="code">fix.asset.cost.entry</field>
            <field name="prefix">M52COST/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
