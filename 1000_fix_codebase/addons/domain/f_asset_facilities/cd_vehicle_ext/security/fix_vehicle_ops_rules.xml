<?xml version="1.0" encoding="utf-8"?>
<!-- A07 P1 (2026-11-04) M46-15 [probe 60]: 8 of the 10 M46 models had no
     company or operating-unit isolation (only the assignment had rules, in
     the generated fix_isolation_rules.xml, which is not edited by hand).
     The ops models carry no company_id: they are fenced through their
     vehicle (fleet.vehicle.company_id / operating_unit_id), the driver
     through its employee. Same shape as the generated rules: a global
     company rule, and an operating-unit rule for internal users. A vehicle
     with no company or unit is visible to all, as on the assignment. The
     dispatch gate and the reports read as superuser and re-apply the company
     fence themselves (cd_p03_portal a07/m46.py). -->
<odoo>
    <record id="rule_fix_driver_company" model="ir.rule">
        <field name="name">fix.driver: allowed companies</field>
        <field name="model_id" ref="model_fix_driver"/>
        <field name="domain_force">['|', ('employee_id.company_id', '=', False), ('employee_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_vehicle_document_company" model="ir.rule">
        <field name="name">fix.vehicle.document: allowed companies</field>
        <field name="model_id" ref="model_fix_vehicle_document"/>
        <field name="domain_force">['|', ('vehicle_id.company_id', '=', False), ('vehicle_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_vehicle_document_operating_unit" model="ir.rule">
        <field name="name">fix.vehicle.document: allowed operating units (internal users)</field>
        <field name="model_id" ref="model_fix_vehicle_document"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('vehicle_id.operating_unit_id', '=', False), ('vehicle_id.operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
