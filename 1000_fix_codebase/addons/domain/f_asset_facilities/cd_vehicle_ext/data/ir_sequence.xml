        <record id="seq_fix_vehicle_document" model="ir.sequence">
            <field name="name">Vehicle Document</field>
            <field name="code">fix.vehicle.document</field>
            <field name="prefix">VDOC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
