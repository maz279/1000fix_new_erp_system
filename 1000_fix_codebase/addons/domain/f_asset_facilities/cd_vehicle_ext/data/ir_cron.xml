<?xml version="1.0" encoding="utf-8"?>
<!--
  M46 scheduled jobs (A07 P1, 2026-11-04; audit D9 / M46-5, M46-13, M46-14).

  The module had no cron at all: no document or licence ever expired, no
  vehicle went off-road at midnight, no service fell due and no silent
  tracker was noticed. Each job calls an idempotent @api.model cron_* method
  that runs as superuser and writes through the workflow guard.

  The daily jobs run just after midnight Dhaka (18:05 UTC), so a document
  that ends today lapses at the start of tomorrow (FR-FLT-012).
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_vehicle_document_expiry" model="ir.cron">
            <field name="name">M46: expire statutory documents, alert renewals, take lapsed vehicles off-road</field>
            <field name="model_id" ref="model_fix_vehicle_document"/>
            <field name="state">code</field>
            <field name="code">model.cron_document_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="DateTime.utcnow().replace(hour=18, minute=5, second=0, microsecond=0)"/>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_driver_licence_expiry" model="ir.cron">
            <field name="name">M46: driver licence expiry alerts and suspension</field>
            <field name="model_id" ref="model_fix_driver"/>
            <field name="state">code</field>
            <field name="code">model.cron_driver_licence_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="DateTime.utcnow().replace(hour=18, minute=10, second=0, microsecond=0)"/>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_vehicle_pm_due" model="ir.cron">
            <field name="name">M46: vehicle service due / overdue</field>
            <field name="model_id" ref="model_fix_vehicle_pm"/>
            <field name="state">code</field>
            <field name="code">model.cron_pm_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="DateTime.utcnow().replace(hour=18, minute=15, second=0, microsecond=0)"/>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_vehicle_telemetry_silence" model="ir.cron">
            <field name="name">M46: telematics silence detection</field>
            <field name="model_id" ref="model_fix_vehicle_telemetry"/>
            <field name="state">code</field>
            <field name="code">model.cron_telemetry_silence()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
