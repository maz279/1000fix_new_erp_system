<?xml version="1.0" encoding="utf-8"?>
<!--
  A07 P1 (2026-11-04) M45-10 / probe 50: the six ops models had no company_id
  and no record rule, so a plain user read another company's issues. They now
  carry their equipment's company and operating unit (stored related fields),
  and the rules below fence them as the generated isolation rules fence the
  register (same domains as fix_isolation_rules.xml, which is generated and
  not edited by hand). The P2 models (readings, profiles, impact) are fenced
  the same way.
-->
<odoo>
    <record id="rule_fix_equipment_issue_company" model="ir.rule">
        <field name="name">fix.equipment.issue: allowed companies</field>
        <field name="model_id" ref="model_fix_equipment_issue"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_fix_equipment_issue_operating_unit" model="ir.rule">
        <field name="name">fix.equipment.issue: allowed operating units (internal users)</field>
        <field name="model_id" ref="model_fix_equipment_issue"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('operating_unit_id', '=', False), ('operating_unit_id', 'in', operating_unit_ids)]</field>
    </record>
