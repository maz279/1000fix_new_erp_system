<?xml version="1.0" encoding="utf-8"?>
<!--
  M37 scheduled jobs (A04 audit 2026-11-04, C10: the module had no ir.cron,
  so no date-driven rule ever ran).

  - Brand authorisation expiry (BRU-PCM-08): an authorisation past its expiry
    is lapsed, so items that need it stop selling.
  - Discontinued -> Obsolete (spec §8): a discontinued item whose end of
    support has passed becomes Obsolete.
  Both run daily just after midnight Dhaka time (18:15 UTC) and are
  idempotent.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_m37_brand_authorisation_expiry" model="ir.cron">
            <field name="name">M37: lapse expired brand authorisations</field>
            <field name="model_id" ref="model_fix_brand"/>
            <field name="state">code</field>
            <field name="code">model.cron_authorisation_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 18:15:00')"/>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_m37_obsolete_discontinued" model="ir.cron">
            <field name="name">M37: discontinued items past end of support -> obsolete</field>
            <field name="model_id" ref="model_fix_catalogue_item"/>
            <field name="state">code</field>
            <field name="code">model.cron_obsolete_discontinued()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 18:20:00')"/>
            <field name="active" eval="True"/>
        </record>
        <!-- M37 capture audit (2026-11-14): an approved SRT baseline dated in
             the future moves the item's standard time on its effective date. -->
        <record id="ir_cron_m37_apply_srt_baselines" model="ir.cron">
            <field name="name">M37: apply approved SRT baselines that have come into effect</field>
            <field name="model_id" ref="model_fix_srt_baseline"/>
            <field name="state">code</field>
            <field name="code">model.cron_apply_due_baselines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 18:25:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
