<?xml version="1.0" encoding="utf-8"?>
<!--
  The generic service & charge codes (17 Nov 2026): one per charge line type.
  A charge line typed without a code takes its type's generic code, so every
  estimate / quotation / proforma / invoice line carries a code. Rates are 0:
  the price is entered on the line, or set on the code / an M11 rate card by
  the commercial team. Specific codes (e.g. "AC gas refill 1.5 ton") are added
  on the M37 Service & Charge Codes page.
-->
<odoo noupdate="1">
    <record id="charge_code_service" model="fix.charge.code">
        <field name="code">CHG-SERVICE</field>
        <field name="name">Service Charge</field>
        <field name="name_bn">সার্ভিস চার্জ</field>
        <field name="charge_type">service</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="is_generic" eval="True"/>
    </record>
