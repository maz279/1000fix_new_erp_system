<?xml version="1.0" encoding="utf-8"?>
<!--
  cd_catalogue — service kits + device models (P04-M06-T03 catalogue
  workspace completion). Device models are the registry's reference data
  (M17 consumes); service kits define bundle-of-parts+labour services.
-->
<odoo>

    <record id="view_fix_service_kit_tree" model="ir.ui.view">
        <field name="name">fix.service.kit.tree</field>
        <field name="model">fix.service.kit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="name_bn" optional="show"/>
                <field name="catalogue_item_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fix_service_kit_form" model="ir.ui.view">
        <field name="name">fix.service.kit.form</field>
        <field name="model">fix.service.kit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="name_bn"/>
                            <field name="catalogue_item_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="operating_unit_id" groups="operating_unit.group_multi_operating_unit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Components">
                            <field name="component_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_service_kit" model="ir.actions.act_window">
        <field name="name">Service Kits</field>
        <field name="res_model">fix.service.kit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_service_kit" name="Service Kits"
              parent="cd_catalogue.menu_fix_catalogue_root"
              action="action_fix_service_kit" sequence="15"/>

    <record id="view_fix_device_model_tree" model="ir.ui.view">
        <field name="name">fix.device.model.tree</field>
        <field name="model">fix.device.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="brand_id"/>
                <field name="name"/>
                <field name="name_bn" optional="show"/>
                <field name="model_code"/>
                <field name="device_type"/>
                <field name="discontinued" optional="hide"/>
                <field name="parts_available" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_fix_device_model_form" model="ir.ui.view">
        <field name="name">fix.device.model.form</field>
        <field name="model">fix.device.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="brand_id"/>
                            <field name="name_bn"/>
                            <field name="model_code"/>
                            <field name="device_type"/>
                        </group>
                        <group>
                            <field name="release_year"/>
                            <field name="discontinued"/>
                            <field name="parts_available"/>
                            <field name="warranty_months_new"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_device_model" model="ir.actions.act_window">
        <field name="name">Device Models</field>
        <field name="res_model">fix.device.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_device_model" name="Device Models"
              parent="cd_catalogue.menu_fix_catalogue_root"
              action="action_fix_device_model" sequence="25"/>

</odoo>
