<?xml version="1.0" encoding="utf-8"?>
<!--
  cd_rbac_ext - SoD exception approver (FR-SEC-024, BRU-SEC-07; A08 S4, A12 R2).

  A grant that creates an incompatible duty combination is refused unless a
  time-boxed SoD exception with a mitigating control is approved. FR-SEC-024
  names the approver: the CFO or the CTO. This group is that appointment. It
  ships EMPTY (who holds it is a business appointment, not a default), and a
  holder can never approve an exception for themselves or one they requested.
-->
<odoo>
    <data noupdate="1">

        <record id="privilege_fix_sod" model="res.groups.privilege">
            <field name="name">Segregation of Duties</field>
            <field name="description">Approval of time-boxed SoD exceptions (FR-SEC-024).</field>
            <field name="sequence">46</field>
        </record>

        <record id="group_fix_sod_exception_approver" model="res.groups">
            <field name="name">SoD Exception Approver</field>
            <field name="privilege_id" ref="privilege_fix_sod"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The CFO / CTO appointment (FR-SEC-024): approves, rejects and revokes time-boxed SoD exceptions with a mitigating control; never for themselves or for an exception they requested.</field>
        </record>

    </data>
</odoo>
