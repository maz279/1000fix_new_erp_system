<?xml version="1.0" encoding="utf-8"?>
<!--
  cd_rbac_ext — M29 portal role groups (P04-M06-T06).

  The bridge between the 53-role register (fix.role, Keycloak-mapped) and
  Odoo menu/action visibility. NVR-22: workspaces the user cannot enter do
  not appear — that is what groups_id on the workspace menus implements.

  The six groups below are the W1 workspace roles (roadmap P04-M06-T03).
  They are FUNCTION groups (the Odoo mechanism); the R-nn role rows link to
  them via fix.role.group_id when the reconciled register loads (05-04 §1,
  B-09a) — role codes are never invented here.
-->
<odoo>

    <record id="module_category_fix_portal" model="ir.module.category">
        <field name="name">1000FiX Portal Workspaces</field>
        <field name="description">W1 workspace access (P03; roadmap P04-M06-T03). Visibility per UX-002 NVR-22.</field>
        <field name="sequence">45</field>
    </record>

    <!-- Portal base: every P03 user. Implied by each workspace group. -->
    <record id="group_fix_portal_user" model="res.groups">
        <field name="name">Portal User (P03)</field>
        <field name="category_id" ref="module_category_fix_portal"/>
        <field name="comment">Base access to the operations portal shell. Workspace entry is granted per workspace group below.</field>
    </record>

    <record id="group_ws_front_desk" model="res.groups">
        <field name="name">Workspace: Service Intake (Front Desk)</field>
        <field name="category_id" ref="module_category_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">UX-002 workspace 1 — service centre agents. Opens on the token queue; includes walk-in intake and cash shifts.</field>
    </record>

    <record id="group_ws_service_orders" model="res.groups">
        <field name="name">Workspace: Service Orders</field>
        <field name="category_id" ref="module_category_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">Service order lifecycle (workshop console's W1 slice): orders, work orders, estimates, QC; leads and conversion.</field>
    </record>

    <record id="group_ws_party_master" model="res.groups">
        <field name="name">Workspace: Party Master</field>
        <field name="category_id" ref="module_category_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">M33 party kernel stewardship: parties, roles, identity documents, consent, dedup rules.</field>
    </record>

    <record id="group_ws_devices" model="res.groups">
        <field name="name">Workspace: Device Registry</field>
        <field name="category_id" ref="module_category_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">M17 device registry: devices, warranty, ownership and history.</field>
    </record>

    <record id="group_ws_catalogue" model="res.groups">
        <field name="name">Workspace: Catalogue</field>
        <field name="category_id" ref="module_category_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">M37 catalogue: items, service kits, rental SKUs, refurb grades, brands, device models.</field>
    </record>

    <record id="group_ws_administration" model="res.groups">
        <field name="name">Workspace: Administration</field>
        <field name="category_id" ref="module_category_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">UX-002 workspace 14 (System console) W1 slice: entities, branches, zones, calendars, feature flags, notification configuration, country packs, roles, SoD, isolation tiers.</field>
    </record>

</odoo>
