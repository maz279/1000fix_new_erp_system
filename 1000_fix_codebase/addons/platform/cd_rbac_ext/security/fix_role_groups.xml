<?xml version="1.0" encoding="utf-8"?>
<!--
  cd_rbac_ext — M29 portal role groups (P04-M06-T06).

  The bridge between the 53-role register (fix.role, Keycloak-mapped) and
  Odoo menu/action visibility. NVR-22: workspaces the user cannot enter do
  not appear — that is what groups_id on the workspace menus implements.

  The six groups below are the W1 workspace roles (roadmap P04-M06-T03).
  They are FUNCTION groups (the Odoo mechanism); the R-nn role rows link to
  them via fix.role.group_id when the reconciled register loads (05-04 §1,
  B-09a) — role codes are never invented here.
-->
<odoo>

    <!-- Odoo 19: res.groups.category_id is gone; groups categorise via
         res.groups.privilege (live-install finding). -->
    <record id="privilege_fix_portal" model="res.groups.privilege">
        <field name="name">1000FiX Portal Workspaces</field>
        <field name="description">W1 workspace access (P03; roadmap P04-M06-T03). Visibility per UX-002 NVR-22.</field>
        <field name="sequence">45</field>
    </record>

    <!-- Portal base: every P03 user. Implied by each workspace group. -->
    <record id="group_fix_portal_user" model="res.groups">
        <field name="name">Portal User (P03)</field>
        <field name="privilege_id" ref="privilege_fix_portal"/>
        <field name="comment">Base access to the operations portal shell. Workspace entry is granted per workspace group below.</field>
    </record>

    <record id="group_ws_front_desk" model="res.groups">
        <field name="name">Workspace: Service Intake (Front Desk)</field>
        <field name="privilege_id" ref="privilege_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">UX-002 workspace 1 — service centre agents. Opens on the token queue; includes walk-in intake and cash shifts.</field>
    </record>

    <record id="group_ws_service_orders" model="res.groups">
        <field name="name">Workspace: Service Orders</field>
        <field name="privilege_id" ref="privilege_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">Service order lifecycle (workshop console's W1 slice): orders, work orders, estimates, QC; leads and conversion.</field>
    </record>

    <record id="group_ws_party_master" model="res.groups">
        <field name="name">Workspace: Party Master</field>
        <field name="privilege_id" ref="privilege_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">M33 party kernel stewardship: parties, roles, identity documents, consent, dedup rules.</field>
    </record>

    <record id="group_ws_devices" model="res.groups">
        <field name="name">Workspace: Device Registry</field>
        <field name="privilege_id" ref="privilege_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">M17 device registry: devices, warranty, ownership and history.</field>
    </record>

    <record id="group_ws_catalogue" model="res.groups">
        <field name="name">Workspace: Catalogue</field>
        <field name="privilege_id" ref="privilege_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">M37 catalogue: items, service kits, rental SKUs, refurb grades, brands, device models.</field>
    </record>

    <record id="group_ws_administration" model="res.groups">
        <field name="name">Workspace: Administration</field>
        <field name="privilege_id" ref="privilege_fix_portal"/>
        <field name="implied_ids" eval="[(4, ref('group_fix_portal_user'))]"/>
        <field name="comment">UX-002 workspace 14 (System console) W1 slice: entities, branches, zones, calendars, feature flags, notification configuration, country packs, roles, SoD, isolation tiers.</field>
    </record>

    <!-- A12 X1 (M29-2): the access-approval authority. DELIBERATELY EMPTY —
         who may approve access (and for which role class) is a business
         appointment (report §7). Until someone is appointed, only the
         requester's manager can approve, and nobody can approve their own
         or their beneficiary's request. Do NOT add base.group_system as an
         implied group: the approver group must not itself carry rights. -->
    <record id="privilege_fix_security_authority" model="res.groups.privilege">
        <field name="name">1000FiX Security Authority</field>
        <field name="description">Access approval and key custody (A12 X1/R5). Appointments are business decisions (report §7).</field>
        <field name="sequence">46</field>
    </record>

    <record id="group_access_approver" model="res.groups">
        <field name="name">Access Approver (M29)</field>
        <field name="privilege_id" ref="privilege_fix_security_authority"/>
        <field name="comment">May approve or reject access requests and apply JML events. Ships EMPTY: appointing members is a business decision. Never the requester or the beneficiary of the request.</field>
    </record>

    <!-- A12 R5 (M29-8): encryption-key custody. DELIBERATELY EMPTY — only a
         custodian may rotate keys or re-point a vault reference. -->
    <record id="group_key_custodian" model="res.groups">
        <field name="name">Key Custodian (M29)</field>
        <field name="privilege_id" ref="privilege_fix_security_authority"/>
        <field name="comment">May write the encryption-key register and rotate keys. Ships EMPTY: appointing custodians is a business decision.</field>
    </record>

    <!-- A12 finish E16: who handles security incidents and reads their breach assessment.
         Anyone may report one. Appointments are a business decision (BD4). -->
    <record id="group_security_officer" model="res.groups">
        <field name="name">Security Officer (M29)</field>
        <field name="privilege_id" ref="privilege_fix_security_authority"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Handles security incidents: contain, close, propose and confirm severity (two different officers). Reads every incident; anyone else reads the ones they reported. Ships EMPTY.</field>
    </record>

    <!-- A12 finish E28: exempt from hidden and masked fields on the P03 screens. -->
    <record id="group_sensitive_data_clearance" model="res.groups">
        <field name="name">Sensitive Data Clearance (M29)</field>
        <field name="privilege_id" ref="privilege_fix_security_authority"/>
        <field name="comment">Sees fields that field rules hide or mask, and classified fields in clear, on the P03 screens. Ships EMPTY: clearance is a business decision.</field>
    </record>

</odoo>
