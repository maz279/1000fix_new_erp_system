<?xml version="1.0" encoding="utf-8"?>
<!-- cd_rbac_ext security: T0-T5 isolation tier record rules (P03-M02-T03).
     The actual ir.rule records enforce the six data isolation tiers. -->
<odoo>
    <!-- T1: Internal — all employees can read -->
    <record id="rule_fix_tier_t1_internal" model="ir.rule">
        <field name="name">Isolation Tier T1: Internal (all employees read)</field>
        <field ref="base.group_user" name="groups"/>
        <field name="model_id" ref="model_fix_isolation_tier"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
    </record>

    <!-- T5: Residency-classified — only fix_admin can manage -->
    <record id="rule_fix_tier_t5_admin_only" model="ir.rule">
        <field name="name">Isolation Tier T5: Residency-classified (admin write only)</field>
        <field ref="base.group_system" name="groups"/>
        <field name="model_id" ref="model_fix_isolation_tier"/>
        <field name="domain_force">['|', ('code', '!=', 'T5'), ('requires_step_up', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
    </record>

    <!-- SoD controls: only security group can modify -->
    <record id="rule_fix_sod_security_only" model="ir.rule">
        <field name="name">SoD Controls: security group write</field>
        <field ref="base.group_system" name="groups"/>
        <field name="model_id" ref="model_fix_sod_control"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Field rules: only security group can modify -->
    <record id="rule_fix_field_rule_security_only" model="ir.rule">
        <field name="name">Field Rules: security group write</field>
        <field ref="base.group_system" name="groups"/>
        <field name="model_id" ref="model_fix_field_rule"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
