<?xml version="1.0" encoding="utf-8"?>
<!-- A12 finish E16: a reporter reads what they reported; a Security Officer reads all. -->
<odoo>
    <record id="rule_fix_security_incident_reporter" model="ir.rule">
        <field name="name">Security incident: own reports</field>
        <field name="model_id" ref="model_fix_security_incident"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('detected_by_id', '=', user.id)]</field>
    </record>
    <record id="rule_fix_security_incident_officer" model="ir.rule">
        <field name="name">Security incident: Security Officer sees all</field>
        <field name="model_id" ref="model_fix_security_incident"/>
        <field name="groups" eval="[(4, ref('group_security_officer')), (4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
