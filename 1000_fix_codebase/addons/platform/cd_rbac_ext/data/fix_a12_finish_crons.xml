<?xml version="1.0" encoding="utf-8"?>
<!--
  A12 finish E21: the SoD register measured on a schedule. Results were stale since
  they were last run by hand, and most controls had never been measured.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sod_tests_weekly" model="ir.cron">
            <field name="name">M29: measure the SoD controls</field>
            <field name="model_id" ref="model_fix_sod_test"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_sod_tests()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
        <!-- M29 capture audit 2026-11-14 (BRU-SEC-21): escalate critical
             vulnerabilities open past their due date; reopen lapsed risk acceptances. -->
        <record id="ir_cron_vulnerability_escalation" model="ir.cron">
            <field name="name">M29: escalate overdue critical vulnerabilities</field>
            <field name="model_id" ref="model_fix_vulnerability"/>
            <field name="state">code</field>
            <field name="code">model._cron_escalate_critical()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!-- New User form "Access Valid Until": deprovision expired logins daily. -->
        <record id="ir_cron_access_expiry" model="ir.cron">
            <field name="name">M29: deactivate logins past their access end date</field>
            <field name="model_id" ref="model_fix_jml_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_expire_access()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
