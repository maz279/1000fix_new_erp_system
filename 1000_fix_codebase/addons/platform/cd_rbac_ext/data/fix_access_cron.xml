<?xml version="1.0" encoding="utf-8"?>
<!--
  cd_rbac_ext — the access expiry clock (A10 P1-3, M60-5).

  A SoD waiver or temporary elevation is only as real as its expiry: this
  daily cron revokes granted access requests past their valid_until, taking
  the Odoo group with them. The chatter message is the audit log.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_access_revoke_expired" model="ir.cron">
            <field name="name">M29: revoke expired access grants and waivers</field>
            <field name="model_id" ref="model_fix_access_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_revoke_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
