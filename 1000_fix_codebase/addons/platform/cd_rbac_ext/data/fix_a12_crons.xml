<?xml version="1.0" encoding="utf-8"?>
<!--
  A12 R3 (M29-6): the three M29 crons. Before them nothing ever expired:
  an elevation that had lapsed 5 days earlier was granted as a permanent
  group, a privileged session stayed open forever, and unconfirmed access
  was never revoked (FR-SEC-026). Tunables:
    fix_rbac_ext.privileged_session_timeout_minutes (default 240)
    fix_rbac_ext.certification_grace_days (default 14)
-->
<odoo>
    <data noupdate="1">

        <record id="ir_cron_access_elevation_expiry" model="ir.cron">
            <field name="name">M29: expire lapsed access elevations</field>
            <field name="model_id" ref="model_fix_access_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_expire_elevations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_certification_closeout" model="ir.cron">
            <field name="name">M29: revoke unconfirmed access (certification close-out)</field>
            <field name="model_id" ref="model_fix_access_certification"/>
            <field name="state">code</field>
            <field name="code">model.cron_close_certifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_privileged_session_timeout" model="ir.cron">
            <field name="name">M29: force-close stale privileged sessions</field>
            <field name="model_id" ref="model_fix_privileged_session"/>
            <field name="state">code</field>
            <field name="code">model.cron_close_stale_sessions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
