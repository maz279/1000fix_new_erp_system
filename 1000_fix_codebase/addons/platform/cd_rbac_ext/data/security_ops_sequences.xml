<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_fix_jml_event" model="ir.sequence">
            <field name="name">JML Event</field>
            <field name="code">fix.jml.event</field>
            <field name="prefix">JML/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_access_certification" model="ir.sequence">
            <field name="name">Access Certification</field>
            <field name="code">fix.access.certification</field>
            <field name="prefix">CERT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_security_incident" model="ir.sequence">
            <field name="name">Security Incident</field>
            <field name="code">fix.security.incident</field>
            <field name="prefix">SEC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <!-- M29 capture pass 2 (2026-11-19) -->
        <record id="seq_fix_service_account" model="ir.sequence">
            <field name="name">Service Account</field>
            <field name="code">fix.service.account</field>
            <field name="prefix">SVC/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_security_pentest" model="ir.sequence">
            <field name="name">Penetration Test</field>
            <field name="code">fix.security.pentest</field>
            <field name="prefix">PT/%(year)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_vulnerability" model="ir.sequence">
            <field name="name">Vulnerability</field>
            <field name="code">fix.vulnerability</field>
            <field name="prefix">VULN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
