<?xml version="1.0" encoding="utf-8"?>
<!--
  A10 D2 (2026-11-05): the daily retention sweep (M24-7). Without a cron
  nothing ever moved a document to 'expired': a document five years past its
  three-year class stayed active forever, and expiry was instead a field any
  user could type. Eligibility is now computed, announced on the outbox and
  reviewed on the register — never typed.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_document_retention" model="ir.cron">
            <field name="name">M24: enforce document retention (expiry sweep)</field>
            <field name="model_id" ref="model_fix_document"/>
            <field name="state">code</field>
            <field name="code">model.cron_retention_enforcement()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
