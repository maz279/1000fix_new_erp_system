<?xml version="1.0" encoding="utf-8"?>
<!-- A12 finish audit E5: any internal user could rewrite another user's draft
     payload. A plain user edits only the requests they raised; a domain steward
     works every request. Reading stays open: a request is not confidential. -->
<odoo>
    <record id="rule_fix_mdm_change_request_owner" model="ir.rule">
        <field name="name">fix.mdm.change.request: a user edits their own requests</field>
        <field name="model_id" ref="model_fix_mdm_change_request"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="rule_fix_mdm_change_request_steward" model="ir.rule">
        <field name="name">fix.mdm.change.request: a steward works every request</field>
        <field name="model_id" ref="model_fix_mdm_change_request"/>
        <field name="groups" eval="[(4, ref('cd_entity_config.group_mdm_domain_steward'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- M64 capture audit (2026-11-18): the same own-or-steward edit rule for the
