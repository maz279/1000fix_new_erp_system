        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cd_p03_portal.report_a02_field_service</field>
        <field name="report_file">cd_p03_portal.report_a02_field_service</field>
        <field name="print_report_name">'Field Service Report %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_a02_a4"/>
        <field name="binding_model_id" search="[('model', '=', 'fix.field.order')]"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_a02_consignment_note" model="ir.actions.report">
        <field name="name">Delivery Note / Waybill</field>
        <field name="model">fix.consignment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cd_p03_portal.report_a02_consignment_note</field>
        <field name="report_file">cd_p03_portal.report_a02_consignment_note</field>
        <field name="print_report_name">'Waybill %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_a02_a4"/>
        <field name="binding_model_id" search="[('model', '=', 'fix.consignment')]"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_a02_workshop_job" model="ir.actions.report">
        <field name="name">Workshop Job Card / Repair Report</field>
        <field name="model">fix.workshop.job</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cd_p03_portal.report_a02_workshop_job</field>
        <field name="report_file">cd_p03_portal.report_a02_workshop_job</field>
        <field name="print_report_name">'Job Card %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_a02_a4"/>
        <field name="binding_model_id" search="[('model', '=', 'fix.workshop.job')]"/>
        <field name="binding_type">report</field>
    </record>

    <!-- A02 pass 2 M06-10 -->
    <record id="action_report_a02_data_case" model="ir.actions.report">
        <field name="name">Data Recovery Case File</field>
        <field name="model">fix.data.recovery.case</field>
        <field name="report_type">qweb-pdf</field>
