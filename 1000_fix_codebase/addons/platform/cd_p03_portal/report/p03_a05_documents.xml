    <record id="action_report_a05_refurb_job_card" model="ir.actions.report">
        <field name="name">Refurbishment Job Card</field>
        <field name="model">fix.refurbishment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cd_p03_portal.report_a05_refurb_job_card</field>
        <field name="report_file">cd_p03_portal.report_a05_refurb_job_card</field>
        <field name="print_report_name">'Refurb Job Card %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_a02_a4"/>
        <field name="binding_model_id" search="[('model', '=', 'fix.refurbishment')]"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_a05_resale_warranty" model="ir.actions.report">
        <field name="name">Resale Warranty Card &amp; Buyer Disclosure</field>
        <field name="model">fix.tradein.warranty</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cd_p03_portal.report_a05_resale_warranty</field>
        <field name="report_file">cd_p03_portal.report_a05_resale_warranty</field>
        <field name="print_report_name">'Warranty Card %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_a02_a4"/>
        <field name="binding_model_id" search="[('model', '=', 'fix.tradein.warranty')]"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============================ M18 e-waste ============================ -->
    <record id="action_report_a05_ewaste_manifest" model="ir.actions.report">
        <field name="name">E-Waste Transfer Manifest (Form-1)</field>
        <field name="model">fix.ewaste.manifest</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cd_p03_portal.report_a05_ewaste_manifest</field>
        <field name="report_file">cd_p03_portal.report_a05_ewaste_manifest</field>
        <field name="print_report_name">'Manifest %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_a02_a4"/>
        <field name="binding_model_id" search="[('model', '=', 'fix.ewaste.manifest')]"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_a05_disposal_certificate" model="ir.actions.report">
        <field name="name">E-Waste Disposal Certificate</field>
        <field name="model">fix.ewaste.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cd_p03_portal.report_a05_disposal_certificate</field>
        <field name="report_file">cd_p03_portal.report_a05_disposal_certificate</field>
        <field name="print_report_name">'Disposal Certificate %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_a02_a4"/>
        <field name="binding_model_id" search="[('model', '=', 'fix.ewaste.certificate')]"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_a05_doe_return" model="ir.actions.report">
        <field name="name">E-Waste Statutory Return (DoE)</field>
        <field name="model">fix.ewaste.return</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cd_p03_portal.report_a05_doe_return</field>
