<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1000FiX Enterprise Split-Screen Login Layout (Prototype Parity) -->
    <template id="p03_login_layout" inherit_id="web.login_layout" name="1000FiX Enterprise Split-Screen Login Layout">
        <!-- Replace default container with full viewport split-screen -->
        <xpath expr="//div[hasclass('container')]" position="replace">
            <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&amp;family=Inter:wght@400;500;600&amp;display=swap" rel="stylesheet"/>
            
            <style>
                /* Reset Odoo page defaults for full-bleed split-screen */
                html, body {
                    height: 100% !important;
                    margin: 0 !important;
                    padding: 0 !important;
                    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
                    background: #FFFFFF !important;
                    overflow-x: hidden !important;
                }
                #wrapwrap {
                    height: 100% !important;
                    display: flex !important;
                    flex-direction: column !important;
                    background: #FFFFFF !important;
                }
                main {
                    flex: 1 0 auto !important;
                    padding: 0 !important;
                    display: flex !important;
                }
                .login-split {
                    display: grid;
                    grid-template-columns: minmax(400px, 46%) 1fr;
                    min-height: 100vh;
                    width: 100%;
                }
                @media (max-width: 960px) {
                    .login-split {
                        grid-template-columns: 1fr;
                    }
                    .login-brand {
                        display: none !important;
                    }
                }

                /* Left Brand Panel: Deep Emerald Gradient */
                .login-brand {
                    background: linear-gradient(160deg, #04211E 0%, #0E7A6E 130%);
                    color: #E6F7F4;
                    padding: 56px 48px;
                    display: flex;
                    flex-direction: column;
                    justify-content: space-between;
                    position: relative;
                    overflow: hidden;
                }
                .login-brand::after {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: radial-gradient(600px 300px at 85% 90%, rgba(232,89,12,0.18), transparent 60%);
                    pointer-events: none;
                }
                .login-brand > * {
                    position: relative;
                    z-index: 2;
                }
                .lb-logo {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                }
                .lb-logo .mark {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: linear-gradient(135deg, #0E7A6E, #059669);
                    color: #FFFFFF;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 22px;
                    font-weight: 800;
                    font-family: 'Sora', sans-serif;
                    box-shadow: 0 4px 12px rgba(4,33,30,0.3);
                }
                .brand-title {
                    display: block;
                    font-size: 19px;
                    font-weight: 800;
                    letter-spacing: -0.02em;
                    color: #FFFFFF;
                    line-height: 1.1;
                }
                .brand-sub {
                    display: block;
                    font-size: 10.5px;
                    font-weight: 600;
                    color: #A7F3D0;
                    letter-spacing: 0.06em;
                    text-transform: uppercase;
                    margin-top: 2px;
                }
                .lb-badge {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    background: rgba(16, 185, 129, 0.15);
                    border: 1px solid rgba(16, 185, 129, 0.35);
                    color: #A7F3D0;
                    padding: 4px 12px;
                    border-radius: 999px;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 0.04em;
                    margin-bottom: 20px;
                }
                .badge-dot {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: #34D399;
                }
                .login-brand h2 {
                    font-family: 'Sora', sans-serif;
                    font-size: 34px;
                    font-weight: 800;
                    line-height: 1.18;
                    letter-spacing: -0.02em;
                    color: #FFFFFF;
                    margin: 0 0 14px 0;
                }
                .lb-desc {
                    color: rgba(230,247,244,0.82);
                    font-size: 14px;
                    line-height: 1.6;
                    max-width: 380px;
                    margin: 0 0 36px 0;
                }
                .lb-facts {
                    display: flex;
                    gap: 36px;
                }
                .fact-item b {
                    display: block;
                    font-family: 'Sora', sans-serif;
                    font-size: 26px;
                    font-weight: 800;
                    color: #FED7AA;
                    line-height: 1.1;
                }
                .fact-item span {
                    font-size: 12px;
                    color: rgba(230,247,244,0.7);
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                }
                .lb-foot p {
                    font-size: 11px;
                    color: rgba(230,247,244,0.6);
                    line-height: 1.5;
                    margin: 0;
                }

                /* Right Form Panel */
                .login-form-side {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 48px 32px;
                    background: #FFFFFF;
                    overflow-y: auto;
                }
                .login-card {
                    width: 100%;
                    max-width: 420px;
                }
                .login-card h1 {
                    font-family: 'Sora', sans-serif;
                    font-size: 26px;
                    font-weight: 700;
                    color: #0F172A;
                    margin: 0 0 4px 0;
                    letter-spacing: -0.02em;
                }
                .login-card .sub {
                    color: #64748B;
                    font-size: 13.5px;
                    margin: 0 0 20px 0;
                }

                /* Odoo Form Inputs Overrides */
                .oe_login_form .form-label {
                    font-size: 13px !important;
                    font-weight: 600 !important;
                    color: #334155 !important;
                    margin-bottom: 6px !important;
                }
                .oe_login_form .form-control {
                    height: 42px !important;
                    border-radius: 7px !important;
                    border: 1px solid #CBD5E1 !important;
                    padding: 0 14px !important;
                    font-size: 14px !important;
                    transition: all 0.15s ease !important;
                }
                .oe_login_form .form-control:focus {
                    border-color: #0E7A6E !important;
                    box-shadow: 0 0 0 3px rgba(14, 122, 110, 0.15) !important;
                    outline: none !important;
                }

                /* Submit Button Styling: Sunset Orange */
                .oe_login_form button[type="submit"] {
                    height: 44px !important;
                    background: #E8590C !important;
                    border: 1px solid #E8590C !important;
                    color: #FFFFFF !important;
                    font-weight: 700 !important;
                    font-size: 14px !important;
                    border-radius: 8px !important;
                    box-shadow: 0 4px 14px rgba(232, 89, 12, 0.35) !important;
                    transition: all 0.15s ease !important;
                    display: flex !important;
                    align-items: center !important;
                    justify-content: center !important;
                    gap: 6px !important;
                }
                .oe_login_form button[type="submit"]:hover {
                    background: #D94E07 !important;
                    border-color: #D94E07 !important;
                    transform: translateY(-1px) !important;
                    box-shadow: 0 6px 18px rgba(232, 89, 12, 0.45) !important;
                }

                /* SSO Buttons */
                .sso-row {
                    display: flex;
                    gap: 10px;
                    margin-top: 16px;
                }
                .btn-sso {
                    flex: 1;
                    height: 40px;
                    background: #F8FAFC;
                    border: 1px solid #E2E8F0;
                    border-radius: 7px;
                    font-size: 12.5px;
                    font-weight: 600;
                    color: #334155;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                    cursor: pointer;
                    transition: all 0.15s ease;
                }
                .btn-sso:hover {
                    background: #F1F5F9;
                    border-color: #CBD5E1;
                }

                /* Portals and Legal Footer Strip */
                .login-portals-strip {
                    margin-top: 28px;
                    padding-top: 20px;
                    border-top: 1px solid #E2E8F0;
                    text-align: center;
                }
                .portal-links {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                    font-size: 11.5px;
                    margin-bottom: 8px;
                }
                .portal-link {
                    color: #0E7A6E;
                    text-decoration: none;
                    font-weight: 600;
                }
                .portal-link:hover {
                    text-decoration: underline;
                }
                .portal-sep {
                    color: #94A3B8;
                }
                .helpline-link {
                    font-size: 11.5px;
                    color: #475569;
                    font-weight: 600;
                    margin-bottom: 8px;
                }
                .db-link {
                    color: #64748B;
                    text-decoration: none;
                }
                .db-link:hover {
                    text-decoration: underline;
                }
                .legal-line {
                    font-size: 10.5px;
                    color: #94A3B8;
                }
            </style>

            <div class="login-split">
                <!-- Left Brand Hero Panel -->
                <aside class="login-brand" role="complementary" aria-label="1000FiX Enterprise Information">
                    <div class="lb-logo">
                        <span class="mark">F</span>
                        <div>
                            <span class="brand-title">1000 FiX ERP</span>
                            <span class="brand-sub">SERVICE OPERATIONS PLATFORM</span>
                        </div>
                    </div>

                    <div class="lb-content">
                        <div class="lb-badge">
                            <span class="badge-dot"></span>
                            <span>✓ ISO 9001:2015 CERTIFIED</span>
                        </div>
                        <h2>One platform,<br/>every service moment.</h2>
                        <p class="lb-desc">
                            Hotline 16743 to workshop bench, brand claim to Mushak 9.1 — 67 modules, 12 portals, one golden record per customer and device.
                        </p>
                        <div class="lb-facts">
                            <div class="fact-item">
                                <b>823</b>
                                <span>screens</span>
                            </div>
                            <div class="fact-item">
                                <b>346</b>
                                <span>reports</span>
                            </div>
                            <div class="fact-item">
                                <b>12</b>
                                <span>portals</span>
                            </div>
                        </div>
                    </div>

                    <div class="lb-foot">
                        <p>ISO 9001:2015 · 51+ centres · 8 divisions<br/>© 2026 1000 FiX Services Ltd. All rights reserved.</p>
                    </div>
                </aside>

                <!-- Right Authentication Form Panel -->
                <main class="login-form-side" role="main" aria-label="User Sign In">
                    <div class="login-card">
                        <h1>Sign in</h1>
                        <p class="sub">Use your 1000 FiX credentials — SSO (M29) with MFA.</p>

                        <!-- Odoo Authentication Form -->
                        <div class="o_login_form_container">
                            <t t-out="0"/>
                        </div>

                        <!-- Helpline & Admin Strip -->
                        <div class="login-portals-strip">
                            <div class="helpline-link">
                                <span>📞 24/7 Helpline: 16743</span>
                                <span class="portal-sep">·</span>
                                <a href="/web/database/manager" class="db-link">Database Manager</a>
                            </div>
                            <div class="legal-line">
                                Forgot password · Terms · PDPA 2026 privacy notice
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </xpath>
    </template>

    <!-- Enhance the Login Button inside web.login -->
    <template id="p03_login_form_style" inherit_id="web.login" name="1000FiX Login Form Button Enhancement">
        <xpath expr="//button[@type='submit'][hasclass('btn-primary')]" position="replace">
            <button type="submit" class="btn btn-primary w-100">
                <span>Continue ▸</span>
            </button>
        </xpath>
    </template>

</odoo>
