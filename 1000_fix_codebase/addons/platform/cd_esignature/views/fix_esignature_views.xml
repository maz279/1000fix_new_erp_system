<?xml version="1.0" encoding="utf-8"?>
<!-- cd_esignature views — envelopes under Party/Docs administration. -->
<odoo>

    <record id="view_fix_esignature_envelope_form" model="ir.ui.view">
        <field name="name">fix.esignature.envelope.form</field>
        <field name="model">fix.esignature.envelope</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" string="Send for Signature" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_check_complete" string="Check Complete" type="object"
                            invisible="state not in ('sent', 'partially_signed')"/>
                    <button name="action_void" string="Void" type="object"
                            invisible="state not in ('draft', 'sent', 'partially_signed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,partially_signed,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="state != 'draft'"/></h1></div>
                    <group>
                        <group>
                            <field name="document_id" readonly="state != 'draft'"/>
                            <field name="evidence_hash" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                            <field name="deadline" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                            <field name="decline_reason" readonly="1" invisible="state != 'declined'"/>
                            <field name="void_reason" readonly="1" invisible="state != 'voided'"/>
                        </group>
                        <group>
                            <field name="completion_certificate_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="signer_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" readonly="envelope_id.state != 'draft'"/>
                            <field name="partner_id" readonly="envelope_id.state != 'draft'"/>
                            <field name="role_label"/>
                            <field name="signed_at" readonly="1"/>
                            <field name="signature_provider" readonly="1" optional="show"/>
                            <field name="auth_method" readonly="1" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fix_esignature_envelope_tree" model="ir.ui.view">
        <field name="name">fix.esignature.envelope.tree</field>
        <field name="model">fix.esignature.envelope</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="document_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="deadline" optional="show"/>
                <field name="completed_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_fix_esignature_envelope" model="ir.actions.act_window">
        <field name="name">E-Signature Envelopes</field>
        <field name="res_model">fix.esignature.envelope</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_esignature" name="E-Signatures"
              parent="cd_document_core.menu_fix_document_root"
              action="action_fix_esignature_envelope" sequence="50"/>

</odoo>
