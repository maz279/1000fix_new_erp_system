<?xml version="1.0" encoding="utf-8"?>
<!--
  The commercial document print standard (17 Nov 2026): the blocks every
  customer document prints - tax invoice (Mushak 6.3), local proforma
  invoice, quotation and repair estimate. Each block reads one payload
  dict `p` built in Python (models/fix_doc_print.py), never computes money.

    commercial_head       title band, Bill To, document details, service item
    commercial_lines      SL / item code / description / qty / unit / unit
                          price / discount / amount [/ VAT % / VAT / total]
    commercial_footer     amount in words + the totals box
    commercial_notes      notes, bank accounts, policy
    commercial_sign       signature boxes
-->
<odoo>


    <!-- every printed label as a translatable text node (generated from
         scratch gen_labels.py; Bengali in i18n/bn_BD.po) -->
    <template id="commercial_label">
        <t t-if="k == 'Invoice No.'">Invoice No.</t>
        <t t-elif="k == 'Invoice Date'">Invoice Date</t>
        <t t-elif="k == 'Due Date'">Due Date</t>
        <t t-elif="k == 'Mushak 6.3 No.'">Mushak 6.3 No.</t>
        <t t-elif="k == 'Customer PO / Ref'">Customer PO / Ref</t>
        <t t-elif="k == 'Service Order'">Service Order</t>
        <t t-elif="k == 'Delivery Challan'">Delivery Challan</t>
        <t t-elif="k == 'Sales Person'">Sales Person</t>
        <t t-elif="k == 'Branch'">Branch</t>
        <t t-elif="k == 'Payment Method'">Payment Method</t>
        <t t-elif="k == 'Proforma No.'">Proforma No.</t>
        <t t-elif="k == 'Date'">Date</t>
        <t t-elif="k == 'Valid Until'">Valid Until</t>
        <t t-elif="k == 'Quotation Ref.'">Quotation Ref.</t>
        <t t-elif="k == 'Payment Terms'">Payment Terms</t>
        <t t-elif="k == 'Quotation No.'">Quotation No.</t>
        <t t-elif="k == 'Version'">Version</t>
        <t t-elif="k == 'Type'">Type</t>
        <t t-elif="k == 'Estimate Ref.'">Estimate Ref.</t>
        <t t-elif="k == 'Unit'">Unit</t>
        <t t-elif="k == 'Device'">Device</t>
        <t t-elif="k == 'Serial'">Serial</t>
        <t t-elif="k == 'Prepared By'">Prepared By</t>
        <t t-elif="k == 'Total Items / Qty'">Total Items / Qty</t>
        <t t-elif="k == 'Subtotal (before discount)'">Subtotal (before discount)</t>
        <t t-elif="k == 'Less: Discount'">Less: Discount</t>
        <t t-elif="k == 'Taxable Value'">Taxable Value</t>
        <t t-elif="k == 'VAT'">VAT</t>
        <t t-elif="k == 'Less: Loyalty Redemption'">Less: Loyalty Redemption</t>
        <t t-elif="k == 'Grand Total (BDT)'">Grand Total (BDT)</t>
        <t t-elif="k == 'Paid'">Paid</t>
        <t t-elif="k == 'Balance Due'">Balance Due</t>
        <t t-elif="k == 'Advance Payable Now'">Advance Payable Now</t>
        <t t-elif="k == 'Advance with Order'">Advance with Order</t>
        <t t-elif="k == 'Amount (excl. VAT)'">Amount (excl. VAT)</t>
        <t t-elif="k == 'Total Payable (incl. VAT)'">Total Payable (incl. VAT)</t>
        <t t-elif="k == 'Parts &amp; Products'">Parts &amp; Products</t>
        <t t-elif="k == 'Service &amp; Labour'">Service &amp; Labour</t>
        <t t-elif="k == 'Diagnostic'">Diagnostic</t>
        <t t-elif="k == 'Transport &amp; Other Charges'">Transport &amp; Other Charges</t>
        <t t-elif="k == 'TAX INVOICE'">TAX INVOICE</t>
        <t t-elif="k == 'CASH MEMO / TAX INVOICE'">CASH MEMO / TAX INVOICE</t>
        <t t-elif="k == 'SALES / SERVICE INVOICE'">SALES / SERVICE INVOICE</t>
        <t t-elif="k == 'PROFORMA INVOICE'">PROFORMA INVOICE</t>
        <t t-elif="k == 'QUOTATION'">QUOTATION</t>
        <t t-elif="k == 'REPAIR / SERVICE ESTIMATE'">REPAIR / SERVICE ESTIMATE</t>
        <t t-elif="k == 'Received in good condition by (Customer)'">Received in good condition by (Customer)</t>
        <t t-elif="k == 'Prepared by'">Prepared by</t>
        <t t-elif="k == 'Authorised Signature &amp; Company Seal'">Authorised Signature &amp; Company Seal</t>
        <t t-elif="k == 'Accepted by (Customer) — name, signature &amp; date'">Accepted by (Customer) — name, signature &amp; date</t>
        <t t-elif="k == 'For 1000FiX Services Ltd. — Authorised Signature'">For 1000FiX Services Ltd. — Authorised Signature</t>
        <t t-elif="k == 'Customer Approval — signature &amp; date'">Customer Approval — signature &amp; date</t>
        <t t-elif="k == 'For 1000FiX Services Ltd. — Service Manager'">For 1000FiX Services Ltd. — Service Manager</t>
        <t t-else="" t-esc="k"/>
    </template>

    <template id="commercial_head">
        <div class="cds-watermark" t-if="p.get('watermark')" t-esc="p['watermark']"/>
        <div class="cds-title-band cds-title-split">
            <table class="cds-title-tbl"><tr>
                <td>
                    <h1><t t-call="cd_doc_suite.commercial_label"><t t-set="k" t-value="p['title']"/></t> <span class="cds-chip" t-if="p.get('chip')" t-esc="p['chip']"/></h1>
                    <div class="cds-title-sub" t-if="p.get('mushak')">Tax invoice under Rule 40, VAT &amp; SD Rules 2016</div>
                </td>
                <td class="cds-title-right">
                    <div t-if="p.get('mushak')" class="cds-mushak-tag">MUSHAK - 6.3</div>
                    <div class="cds-seller-name" t-esc="p['company'].get('name')"/>
                    <div class="cds-title-sub" t-if="p['company'].get('address')" t-esc="p['company']['address']"/>
                    <div class="cds-title-sub" t-if="p['company'].get('bin')">Seller BIN: <b t-esc="p['company']['bin']"/></div>
                </td>
            </tr></table>
        </div>
        <table class="cds-parties">
            <tr>
                <td>
                    <div class="cds-party-label">Bill To <span t-if="p['bill_to'].get('category')" class="cds-cat" t-esc="p['bill_to']['category']"/></div>
                    <div class="cds-party-name"><t t-esc="p['bill_to']['name']"/><span t-if="p['bill_to'].get('code')" class="cds-code"> [<t t-esc="p['bill_to']['code']"/>]</span></div>
                    <div t-if="p['bill_to'].get('address')" t-esc="p['bill_to']['address']"/>
                    <div t-if="p['bill_to'].get('phone') or p['bill_to'].get('email')">
                        <t t-if="p['bill_to'].get('phone')">Phone: <t t-esc="p['bill_to']['phone']"/></t>
                        <t t-if="p['bill_to'].get('phone') and p['bill_to'].get('email')"> · </t>
                        <t t-if="p['bill_to'].get('email')"><t t-esc="p['bill_to']['email']"/></t>
                    </div>
                    <div t-if="p['bill_to'].get('bin')">Buyer BIN / e-TIN: <b t-esc="p['bill_to']['bin']"/></div>
                </td>
                <td>
                    <table class="cds-meta">
                        <tr t-foreach="p['meta']" t-as="m"><td class="cds-meta-label"><t t-call="cd_doc_suite.commercial_label"><t t-set="k" t-value="m[0]"/></t></td><td t-esc="m[1]"/></tr>
                    </table>
                </td>
            </tr>
        </table>
        <table class="cds-meta cds-extra" t-if="p.get('service_item') or p.get('delivery_address') or p.get('vehicle')">
            <tr t-if="p.get('service_item')"><td class="cds-meta-label">Service Item</td><td t-esc="p['service_item']"/></tr>
            <tr t-if="p.get('delivery_address')"><td class="cds-meta-label">Delivery / Service Address</td><td t-esc="p['delivery_address']"/></tr>
            <tr t-if="p.get('vehicle')"><td class="cds-meta-label">Vehicle No.</td><td t-esc="p['vehicle']"/></tr>
        </table>
    </template>

    <template id="commercial_lines">
        <t t-set="ncols" t-value="12 if p.get('vat_columns') else 9"/>
        <table class="cds-table cds-lines">
            <thead>
                <tr>
                    <th class="cds-ctr" style="width: 4%;">SL</th>
                    <th style="width: 12%;">Item Code</th>
                    <th>Description</th>
                    <th class="cds-num" style="width: 6%;">Qty</th>
                    <th style="width: 6%;">Unit</th>
                    <th class="cds-num" style="width: 10%;">Unit Price</th>
                    <th class="cds-num" style="width: 9%;">Discount</th>
                    <th class="cds-num" style="width: 11%;">Amount<t t-if="p.get('vat_columns')"> (Taxable)</t></th>
                    <t t-if="p.get('vat_columns')">
                        <th class="cds-num" style="width: 5%;">VAT %</th>
                        <th class="cds-num" style="width: 8%;">VAT</th>
                        <th class="cds-num" style="width: 11%;">Total</th>
                    </t>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="p['lines']" t-as="ln">
                    <tr t-if="'sl' not in ln" t-att-class="'cds-section' if ln.get('section') else 'cds-note-row'">
                        <td t-att-colspan="ncols" t-esc="ln.get('text')"/>
                    </tr>
                    <tr t-else="">
                        <td class="cds-ctr" t-esc="ln['sl']"/>
                        <td class="cds-code-cell"><b t-esc="ln['code'] or '—'"/></td>
                        <td>
                            <t t-esc="ln['description']"/>
                            <div class="cds-sub"><t t-esc="ln['type']"/><t t-if="ln.get('serial')"> · S/N: <t t-esc="ln['serial']"/></t></div>
                        </td>
                        <td class="cds-num" t-esc="ln['qty']"/>
                        <td t-esc="ln['uom']"/>
                        <td class="cds-num" t-esc="ln['price']"/>
                        <td class="cds-num"><t t-esc="ln['disc'] or '—'"/><div class="cds-sub" t-if="ln.get('disc_pct')" t-esc="ln['disc_pct']"/></td>
                        <td class="cds-num" t-esc="ln['amount']"/>
                        <t t-if="p.get('vat_columns')">
                            <td class="cds-num" t-esc="ln['vat_rate']"/>
                            <td class="cds-num" t-esc="ln['vat']"/>
                            <td class="cds-num"><b t-esc="ln['total']"/></td>
                        </t>
                    </tr>
                </t>
                <tr t-if="not p['lines']">
                    <td t-att-colspan="ncols" style="text-align:center;color:#777;">No lines recorded.</td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="commercial_footer">
        <table class="cds-foot">
            <tr>
                <td class="cds-foot-left">
                    <div class="cds-words" t-if="p.get('words')">
                        <span class="cds-words-label">In Words:</span>
                        <span t-esc="p['words']"/>
                    </div>
                </td>
                <td class="cds-foot-right">
                    <table class="cds-totals">
                        <tr t-foreach="p['totals']" t-as="tt" t-att-class="'cds-grand' if tt[2] == 'grand' else ('cds-due' if tt[2] == 'due' else '')">
                            <td class="cds-tot-label"><t t-call="cd_doc_suite.commercial_label"><t t-set="k" t-value="tt[0]"/></t><t t-if="len(tt) &gt; 3 and tt[3]"> (<t t-esc="tt[3]"/>)</t></td>
                            <td class="cds-tot-value" t-esc="tt[1]"/>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </template>

    <template id="commercial_notes">
        <div class="cds-notes" t-if="p.get('notes') or p['company'].get('banks')">
            <div t-foreach="p.get('notes') or []" t-as="note" t-esc="note"/>
            <div t-if="p['company'].get('banks')"><b>Bank accounts:</b> <t t-esc="'; '.join(p['company']['banks'])"/>.</div>
            <div>Payable to <b t-esc="p['company']['name']"/> · Hotline 16743 · info@1000fix.com · https://1000fix.com</div>
        </div>
        <div class="cds-notes cds-policy" t-if="p.get('policy')" t-esc="p['policy']"/>
    </template>

    <template id="commercial_sign">
        <table class="cds-sign cds-sign3">
            <tr>
                <td t-foreach="p.get('sign') or []" t-as="who" class="cds-sign-pad"><t t-call="cd_doc_suite.commercial_label"><t t-set="k" t-value="who"/></t></td>
            </tr>
        </table>
        <div class="cds-computer">This is a computer-generated document from the 1000FiX ERP.</div>
    </template>

    <!-- the whole body, for documents with no block of their own -->
    <template id="commercial_body">
        <t t-call="cd_doc_suite.commercial_head"/>
        <t t-call="cd_doc_suite.commercial_lines"/>
        <t t-call="cd_doc_suite.commercial_footer"/>
        <t t-call="cd_doc_suite.commercial_notes"/>
        <t t-call="cd_doc_suite.commercial_sign"/>
    </template>

</odoo>
