<?xml version="1.0" encoding="utf-8"?>
<!--
  A12 audit (2026-11-04) P1-2: the data-quality rule register had no
  evaluator. cron_evaluate_dq_rules runs every active fix.mdm.dq.rule
  against its model, records the violations it finds and feeds the MDM
  data-quality report (M64), nightly.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_mdm_dq_evaluation" model="ir.cron">
            <field name="name">M64: evaluate master-data quality rules</field>
            <field name="model_id" ref="model_fix_mdm_dq_rule"/>
            <field name="state">code</field>
            <field name="code">model.cron_evaluate_dq_rules()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!-- A bulk DOFA proposal of 78 ladders sent 78 emails to one
             countersigner. Proposals now post a chatter note immediately and
             this digest sends ONE email per countersigner per window. -->
        <record id="ir_cron_dofa_ruling_digest" model="ir.cron">
            <field name="name">A12: send DOFA countersignature digests</field>
            <field name="model_id" ref="model_fix_dofa_ladder"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_dofa_digest()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
