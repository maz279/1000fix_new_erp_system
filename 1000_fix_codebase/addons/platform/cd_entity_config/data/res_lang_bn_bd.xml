<?xml version="1.0" encoding="utf-8"?>
<!--
  cd_entity_config — the Bengali (Bangladesh) language, bn_BD (AS-12: Bengali
  is the first-class locale).

  Odoo 19 ships Bengali only as bn_IN, so the estate-wide i18n/bn_BD.po files
  never loaded at runtime. With this record, Odoo's loader reads, per module,
  i18n/bn.po (Odoo's own Bengali, the base) and then i18n/bn_BD.po (ours,
  overriding) — get_base_langs('bn_BD') == ['bn', 'bn_BD'].

  Bangladesh conventions: lakh / crore digit grouping (12,34,56,789.00),
  dd/mm/yyyy dates, 12-hour time, the week starting on Saturday.

  Created inactive, then activated through action_unarchive, which also
  loads the translations of every module installed before this one. Modules
  installed afterwards load bn_BD at their own install, like any active
  language. On upgrade the language is already active and nothing reloads.
-->
<odoo noupdate="1">
    <record id="lang_bn_BD" model="res.lang">
        <field name="name">Bengali (Bangladesh) / বাংলা</field>
        <field name="code">bn_BD</field>
        <field name="iso_code">bn_BD</field>
        <field name="url_code">bn_BD</field>
        <field name="direction">ltr</field>
        <field name="grouping">[3,2,0]</field>
        <field name="decimal_point">.</field>
        <field name="thousands_sep">,</field>
        <field name="date_format">%d/%m/%Y</field>
        <field name="time_format">%I:%M:%S %p</field>
        <field name="week_start">6</field>
        <field name="active" eval="False"/>
    </record>
    <function model="res.lang" name="action_unarchive" eval="[[ref('lang_bn_BD')]]"/>
</odoo>
