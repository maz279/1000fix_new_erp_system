<?xml version="1.0" encoding="utf-8"?>
<!-- M30 capture audit, second pass (2026-11-19): references for organisation
     changes, maintenance windows and capacity reviews; the jobs that apply due
     organisation changes and revert emergency changes left without a record. -->
<odoo>
    <data noupdate="1">
        <record id="seq_fix_org_change" model="ir.sequence">
            <field name="name">Organisation Change</field>
            <field name="code">fix.org.change</field>
            <field name="prefix">ORG/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_maintenance_window" model="ir.sequence">
            <field name="name">Maintenance Window</field>
            <field name="code">fix.maintenance.window</field>
            <field name="prefix">MW/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_fix_capacity_metric" model="ir.sequence">
            <field name="name">Capacity Review</field>
            <field name="code">fix.capacity.metric</field>
            <field name="prefix">CAP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="ir_cron_org_change_apply" model="ir.cron">
            <field name="name">M30: apply organisation changes that are due</field>
            <field name="model_id" ref="model_fix_org_change"/>
            <field name="state">code</field>
            <field name="code">model.cron_apply_due_changes()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_config_emergency_revert" model="ir.cron">
            <field name="name">M30: revert emergency configuration changes left without a change record</field>
            <field name="model_id" ref="model_fix_config_change"/>
            <field name="state">code</field>
            <field name="code">model.cron_revert_unregularised()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
