<?xml version="1.0" encoding="utf-8"?>
<!-- fix.zone + fix.geofence views (P03-M04-T02) -->
<odoo>
    <record id="view_fix_zone_tree" model="ir.ui.view">
        <field name="name">fix.zone.tree</field>
        <field name="model">fix.zone</field>
        <field name="arch" type="xml">
            <list string="Dispatch Zones">
                <field name="code"/>
                <field name="name"/>
                <field name="name_bn"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_fix_zone_form" model="ir.ui.view">
        <field name="name">fix.zone.form</field>
        <field name="model">fix.zone</field>
        <field name="arch" type="xml">
            <form string="Dispatch Zone">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="name_bn"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Geofences" name="geofences">
                            <field name="geofence_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="geofence_type"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_zone" model="ir.actions.act_window">
        <field name="name">Dispatch Zones</field>
        <field name="res_model">fix.zone</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_zone" name="Dispatch Zones" parent="menu_fix_entity_root"
              action="action_fix_zone" sequence="30"/>
</odoo>
