<?xml version="1.0" encoding="utf-8"?>
<!--
  cd_entity_config — notification configuration + country data pack views
  (P04-M06 administration workspace; models from P04-M05-T06 / P03-M04-T06).

  AS-09: no logic in views. The dispatcher reads fix.notification.config at
  runtime; this screen governs it (quiet-hours windows, caps, SMS routes).
-->
<odoo>

    <record id="view_fix_notification_config_tree" model="ir.ui.view">
        <field name="name">fix.notification.config.tree</field>
        <field name="model">fix.notification.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="consent_class"/>
                <field name="channel"/>
                <field name="send_window"/>
                <field name="frequency_cap"/>
                <field name="sms_route"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_fix_notification_config_form" model="ir.ui.view">
        <field name="name">fix.notification.config.form</field>
        <field name="model">fix.notification.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Scope">
                            <field name="consent_class"/>
                            <field name="channel"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Policy (NT-003)">
                            <field name="send_window"/>
                            <field name="frequency_cap"/>
                            <field name="combined_cap_non_transactional"/>
                            <field name="sms_route"
                                   invisible="channel != 'sms'"/>
                            <field name="stale_discard_hours"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_notification_config" model="ir.actions.act_window">
        <field name="name">Notification Configuration</field>
        <field name="res_model">fix.notification.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_notification_config" name="Notification Configuration"
              parent="menu_fix_entity_root" action="action_fix_notification_config" sequence="60"/>

    <record id="view_fix_country_pack_tree" model="ir.ui.view">
        <field name="name">fix.country.pack.tree</field>
        <field name="model">fix.country.pack</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="kind"/>
                <field name="version"/>
                <field name="loaded_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fix_country_pack_form" model="ir.ui.view">
        <field name="name">fix.country.pack.form</field>
        <field name="model">fix.country.pack</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="kind"/>
                            <field name="version"/>
                            <field name="active"/>
                            <field name="loaded_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="parent_code"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="name_bn"/>
                                    <field name="date_value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_country_pack" model="ir.actions.act_window">
        <field name="name">Country Data Packs</field>
        <field name="res_model">fix.country.pack</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_country_pack" name="Country Data Packs"
              parent="menu_fix_entity_root" action="action_fix_country_pack" sequence="70"/>

</odoo>
