<?xml version="1.0" encoding="utf-8"?>
<!--
  A03 audit R8: the in-process event relay and its age alert. Without these
  records the relay methods never run and every cross-module hand-off stops
  at the outbox row.
-->
<odoo>
    <data noupdate="1">
        <record id="ir_cron_event_relay" model="ir.cron">
            <field name="name">M28: relay outbox events to in-Odoo consumers</field>
            <field name="model_id" ref="model_fix_event_outbox"/>
            <field name="state">code</field>
            <field name="code">model.cron_relay()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_event_relay_age_alert" model="ir.cron">
            <field name="name">M28: alert when the event relay lags or dead-letters</field>
            <field name="model_id" ref="model_fix_event_outbox"/>
            <field name="state">code</field>
            <field name="code">model.cron_relay_age_alert()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <!-- M28: with no external bus publisher deployed, a relayed event that
             no webhook still needs is finished — mark it published so the bus
             backlog counter, the retention purge and the tiles tell the truth.
             Stands down when fix_event_outbox.bus_publisher is set. -->
        <record id="ir_cron_event_bus_drain" model="ir.cron">
            <field name="name">M28: drain the no-publisher bus backlog</field>
            <field name="model_id" ref="model_fix_event_outbox"/>
            <field name="state">code</field>
            <field name="code">model.cron_mark_relayed_published()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
