<?xml version="1.0" encoding="utf-8"?>
<!-- M33 A03 P2 data: the business switches, the rights-request clock cron, and
     the in-Odoo party.merged consumers for M33's own party-keyed records. -->
<odoo>
    <data noupdate="1">

        <!-- What a 'draft' (unverified) party may do downstream: a business
             ruling (A03 audit M33-3). allow = today's behaviour (default);
             warn = log and return a warning; refuse = draft parties are
             refused by res.partner._fix_assert_party_usable(). Dealer,
             corporate and government parties are refused until registered
             whatever this says (BRU-CPM-02). -->
        <record id="icp_draft_party_policy" model="ir.config_parameter">
            <field name="key">cd_party_master.draft_party_policy</field>
            <field name="value">allow</field>
        </record>

        <!-- Days before the statutory due date that a rights request's handler
             is reminded (A03 audit M33-7). -->
        <record id="icp_rights_reminder_days" model="ir.config_parameter">
            <field name="key">cd_party_master.rights_reminder_days</field>
            <field name="value">7</field>
        </record>

        <record id="ir_cron_rights_request_clock" model="ir.cron">
            <field name="name">M33: data-subject request 30-day clock (remind, escalate)</field>
            <field name="model_id" ref="model_fix_rights_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_rights_request_clock()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- R8: party.merged re-points what the merge itself does not move. -->
        <record id="consumer_party_merged_duplicate" model="fix.event.consumer">
            <field name="name">M33: close duplicate candidates behind a merge</field>
            <field name="event_type">party.merged</field>
            <field name="model">fix.party.duplicate</field>
            <field name="method">consume_party_merged</field>
            <field name="module">cd_party_master</field>
        </record>

        <record id="consumer_party_merged_rights_request" model="fix.event.consumer">
            <field name="name">M33: open rights requests follow the merged party</field>
            <field name="event_type">party.merged</field>
            <field name="model">fix.rights.request</field>
            <field name="method">consume_party_merged</field>
            <field name="module">cd_party_master</field>
        </record>

        <record id="consumer_party_merged_segment_membership" model="fix.event.consumer">
            <field name="name">M33: current segment memberships follow the merged party</field>
            <field name="event_type">party.merged</field>
            <field name="model">fix.segment.membership</field>
            <field name="method">consume_party_merged</field>
            <field name="module">cd_party_master</field>
        </record>

    </data>
</odoo>
