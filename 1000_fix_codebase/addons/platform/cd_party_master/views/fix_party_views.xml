<?xml version="1.0" encoding="utf-8"?>
<!-- cd_party_master views (P03-M05) -->
<odoo>
    <record id="view_fix_party_role_tree" model="ir.ui.view">
        <field name="name">fix.party.role.tree</field>
        <field name="model">fix.party.role</field>
        <field name="arch" type="xml">
            <list string="Party Roles">
                <field name="partner_id"/>
                <field name="role_type"/>
                <field name="role_status" widget="badge"
                       decoration-success="role_status == 'active'"
                       decoration-warning="role_status == 'prospect'"
                       decoration-danger="role_status in ('suspended', 'terminated')"/>
                <field name="since"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_fix_party_role_form" model="ir.ui.view">
        <field name="name">fix.party.role.form</field>
        <field name="model">fix.party.role</field>
        <field name="arch" type="xml">
            <form string="Party Role">
                <header>
                    <field name="role_status" widget="statusbar"
                           statusbar_visible="prospect,active,suspended,terminated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="partner_id" placeholder="The ONE party this role belongs to"/></h2>
                    </div>
                    <group>
                        <group string="Role (the design rule: one party, many roles)">
                            <field name="role_type"/>
                            <field name="role_status"/>
                            <field name="since" readonly="1"/>
                        </group>
                        <group string="Scope">
                            <field name="company_id"/>
                            <field name="operating_unit_id"/>
                            <field name="operating_unit_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="">
                        <div colspan="2" class="text-muted">
                            A party with three roles has THREE role records pointing at the
                            SAME party — never three separate master records.
                        </div>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fix_identity_document_tree" model="ir.ui.view">
        <field name="name">fix.identity.document.tree</field>
        <field name="model">fix.identity.document</field>
        <field name="arch" type="xml">
            <list string="Identity Documents" create="false">
                <field name="partner_id"/>
                <field name="document_type"/>
                <field name="checksum_valid" widget="boolean_toggle"/>
                <field name="verification_status" widget="badge"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>

    <record id="action_fix_party_role" model="ir.actions.act_window">
        <field name="name">Party Roles</field>
        <field name="res_model">fix.party.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_fix_identity_document" model="ir.actions.act_window">
        <field name="name">Identity Documents</field>
        <field name="res_model">fix.identity.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- P04-M06-T03 — the Party Master workspace menu (UX-002 NVR-22 gated;
         opens on Parties — the kernel's home, NVR-19). -->
    <menuitem id="menu_fix_party_root" name="Party Master"
              parent="cd_entity_config.menu_fix_operations_root"
              groups="cd_rbac_ext.group_ws_party_master"
              sequence="50"/>
    <!-- NVR-23: the workspace carries at most 7 second-level sections, so
         the governance surfaces nest one level under Data Governance. -->
    <menuitem id="menu_fix_party_governance" name="Data Governance"
              parent="menu_fix_party_root" sequence="90"/>
    <menuitem id="menu_fix_party_role" name="Roles" parent="menu_fix_party_governance"
              action="action_fix_party_role" sequence="10"/>
    <menuitem id="menu_fix_identity_document" name="Identity Documents" parent="menu_fix_party_governance"
              action="action_fix_identity_document" sequence="20"/>
</odoo>
