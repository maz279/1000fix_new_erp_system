<?xml version="1.0" encoding="utf-8"?>
<!--
  cd_party_master — the Party Master workspace completion (P04-M06-T03).

  Adds the workspace gating (NVR-22), the partner entry (M33's kernel: ONE
  res.partner with roles — the design rule), consent stewardship (PDPA) and
  dedup rules (M64 bridge). Views read/write only (AS-09).
-->
<odoo>

    <!-- The party itself: the kernel's home action, reusing Odoo's contacts. -->
    <record id="action_fix_parties" model="ir.actions.act_window">
        <field name="name">Parties</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'default_customer_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first party</p>
            <p>ONE partner holds MANY roles (customer, seller, vendor) — never duplicate masters; add roles on the party instead.</p>
        </field>
    </record>

    <record id="action_fix_consent" model="ir.actions.act_window">
        <field name="name">Consent Records</field>
        <field name="res_model">fix.consent</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fix_consent_tree" model="ir.ui.view">
        <field name="name">fix.consent.tree</field>
        <field name="model">fix.consent</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="channel"/>
                <field name="state"/>
                <field name="date_granted"/>
                <field name="date_withdrawn" optional="hide"/>
                <field name="source"/>
                <field name="proof" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_fix_consent_form" model="ir.ui.view">
        <field name="name">fix.consent.form</field>
        <field name="model">fix.consent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="channel"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="date_granted" readonly="1"/>
                            <field name="date_withdrawn" readonly="1"/>
                            <field name="source"/>
                            <field name="proof"
                                   placeholder="Signed form ID / OTP session / legacy batch"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_fix_dedup_rule" model="ir.actions.act_window">
        <field name="name">Dedup Rules</field>
        <field name="res_model">fix.dedup.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_fix_dedup_rule_tree" model="ir.ui.view">
        <field name="name">fix.dedup.rule.tree</field>
        <field name="model">fix.dedup.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="match_fields"/>
                <field name="scope"/>
                <field name="action"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_fix_dedup_rule_form" model="ir.ui.view">
        <field name="name">fix.dedup.rule.form</field>
        <field name="model">fix.dedup.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="match_fields"
                                   placeholder="phone,name_normalized"/>
                            <field name="scope"/>
                            <field name="threshold"
                                   invisible="scope != 'fuzzy'"/>
                        </group>
                        <group>
                            <field name="action"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <!-- no chatter: fix.dedup.rule is config data, not mail.thread -->
            </form>
        </field>
    </record>

    <!-- Partner form: the party kernel projection (name_bn, roles, consent). -->
    <record id="view_partner_form_fix_party" model="ir.ui.view">
        <field name="name">res.partner.form.fix.party.kernel</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="name_bn" placeholder="নাম (বাংলা)"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Party Kernel (M33)" name="party_kernel">
                    <group>
                        <group>
                            <field name="preferred_language"/>
                        </group>
                    </group>
                    <field name="role_ids">
                        <list editable="bottom">
                            <field name="role_type"/>
                            <field name="role_status"/>
                            <field name="since"/>
                        </list>
                    </field>
                </page>
                <page string="Consent" name="consent">
                    <field name="consent_ids" readonly="1">
                        <list>
                            <field name="channel"/>
                            <field name="state"/>
                            <field name="date_granted"/>
                            <field name="proof"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_fix_party_hierarchy_tree" model="ir.ui.view">
        <field name="name">fix.party.hierarchy.tree</field>
        <field name="model">fix.party.hierarchy</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="parent_id"/>
                <field name="child_id"/>
                <field name="relation_type"/>
                <field name="date_from"/>
                <field name="date_to" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_fix_party_hierarchy" model="ir.actions.act_window">
        <field name="name">Party Relations</field>
        <field name="res_model">fix.party.hierarchy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fix_party_hierarchy" name="Party Relations" parent="menu_fix_party_root"
              action="action_fix_party_hierarchy" sequence="50"/>

    <menuitem id="menu_fix_parties" name="Parties" parent="menu_fix_party_root"
              action="action_fix_parties" sequence="5"/>
    <menuitem id="menu_fix_consent" name="Consent Records" parent="menu_fix_party_root"
              action="action_fix_consent" sequence="30"/>
    <menuitem id="menu_fix_dedup_rule" name="Dedup Rules" parent="menu_fix_party_root"
              action="action_fix_dedup_rule" sequence="40"/>

</odoo>
