# apps/web/customer — server-side environment (copy to .env.local; NEVER commit
# a real value — .env.* is git-ignored except this file, gitleaks scans history).

# --- P02 technician workbench (/technician) — R01 re-audit 2026-10-22 ---------
# Odoo's /technician/* routes are auth="bearer". The page calls the same-origin
# relay app/api/technician/[...path]/route.ts, which adds
# "Authorization: Bearer <FIX_TECHNICIAN_API_KEY>" on the server; the key is
# never sent to the browser (no NEXT_PUBLIC_ prefix, lib/technician-relay.ts is
# `server-only`).
#
# Value: an Odoo API key of the technician's Odoo user (Odoo > Preferences >
# Account Security > New API Key). That user must be linked to an hr.employee
# (Employee > Related User), otherwise Odoo answers `no_employee`.
#
# TRUST MODEL: everyone who can reach this deployment's /api/technician/* acts
# as that ONE technician. Set it only on a technician-device / internal
# deployment — never on the public customer deployment. Unset = the page shows
# "Technician access is not configured" and nothing is forwarded.
FIX_TECHNICIAN_API_KEY=

# Optional: API gateway base URL used by the relay (libs/ts/api-client).
# Default: Kong on http://127.0.0.1:8000 (routes /technician to Odoo). Without
# Kong, point it at Odoo directly.
# FIX_API_BASE=http://127.0.0.1:8069

# Optional: Odoo database for the stateless bearer calls (sent as
# X-Odoo-Database). Needed only when the Odoo server hosts several databases
# and no dbfilter selects one.
# FIX_ODOO_DB=fix_dev
