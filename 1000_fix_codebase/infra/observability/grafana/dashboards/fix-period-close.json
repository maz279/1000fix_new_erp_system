{
  "title": "1000FiX — Financial Period Close & Trial Balance (PE-008)",
  "uid": "fix-period-close",
  "schemaVersion": 39,
  "tags": ["1000fix", "finance", "close", "trial-balance", "pe-008"],
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Period Close Stage Progress (Stages 1-6)",
      "targets": [{ "expr": "fix_period_close_stage_current" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "green", "value": 6 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unposted Journal Entries (Must be 0 to close)",
      "targets": [{ "expr": "fix_gl_unposted_entries_count" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Suspense Account Balance BDT",
      "targets": [{ "expr": "abs(fix_gl_suspense_balance)" }],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyBDT",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Unallocated Cash Receipts",
      "targets": [{ "expr": "fix_gl_unallocated_receipts_count" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Trial Balance Imbalance Debit - Credit BDT",
      "targets": [{ "expr": "fix_gl_trial_balance_discrepancy_bdt" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Close Duration Days (Target <= 5 days)",
      "targets": [{ "expr": "fix_period_close_duration_days" }],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "red", "value": 5.1 }
            ]
          }
        }
      }
    }
  ]
}
