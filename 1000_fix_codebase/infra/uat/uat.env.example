# =============================================================================
# Single-host synthetic UAT - environment template (docker-compose.uat.full.yml)
#
# Copy to infra/uat/.env.uat (git-ignored: `.env.*`) and FILL every value with
# a freshly generated secret. Compose refuses to load while a ${VAR:?} is
# unset or empty, so an empty template can never start a stack by accident.
#
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Rules (DE-10): never commit the filled file; never reuse production or
# developer credentials here; the UAT database is synthetic and disposable.
# =============================================================================

# PostgreSQL superuser password for the fix_uat database (postgres-uat).
UAT_DB_PASSWORD=

# Odoo master password (admin_passwd) for the UAT instance - database
# manager operations. Testers sign in with their own portal accounts, not
# this password.
UAT_ADMIN_PASSWORD=

# Optional image label baked into the portal builds (org.opencontainers.image.version).
FIX_RELEASE=uat-synthetic

# Demo portal login passwords for tooling/scripts/seed-uat-demo.py (synthetic
# accounts only). Generate one random value and use it for all three; pass
# them through `docker compose exec -e DEMO_UAT_PW -e DEMO_PARTNER_PW -e
# DEMO_VENDOR_PW` when seeding. The customer demo signs in by phone OTP
# (01711000001), not a password.
DEMO_UAT_PW=
DEMO_PARTNER_PW=
DEMO_VENDOR_PW=
