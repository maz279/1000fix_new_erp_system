{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ewaste.collection_requested",
  "description": "Event emitted when enterprise or retail customer books e-waste collection (Journey 10)",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier for idempotency (UUIDv4)"
    },
    "event_type": {
      "type": "string",
      "const": "ewaste.collection_requested"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp"
    },
    "producer": {
      "type": "string",
      "default": "cd_ewaste"
    },
    "payload": {
      "type": "object",
      "required": [
        "collection_id",
        "customer_id",
        "category",
        "requested_at"
      ],
      "properties": {
        "collection_id": {
          "type": "integer"
        },
        "customer_id": {
          "type": "integer"
        },
        "approx_weight_kg": {
          "type": "number"
        },
        "category": {
          "type": "string"
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
