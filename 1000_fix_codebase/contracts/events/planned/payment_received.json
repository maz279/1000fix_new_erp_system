{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "payment.received",
  "description": "Event emitted when payment settlement is verified via bKash, Nagad, SSLCommerz, or cash",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier for idempotency (UUIDv4)"
    },
    "event_type": {
      "type": "string",
      "const": "payment.received"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp"
    },
    "producer": {
      "type": "string",
      "default": "cd_settlement_ext"
    },
    "payload": {
      "type": "object",
      "required": [
        "payment_id",
        "invoice_id",
        "channel",
        "amount",
        "paid_at"
      ],
      "properties": {
        "payment_id": {
          "type": "string"
        },
        "invoice_id": {
          "type": "integer"
        },
        "channel": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "default": "BDT"
        },
        "paid_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
