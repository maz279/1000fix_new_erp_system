{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tradein.evaluated",
  "description": "Event emitted when trade-in device IMEI and condition are graded with trade value (Journey 9)",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier for idempotency (UUIDv4)"
    },
    "event_type": {
      "type": "string",
      "const": "tradein.evaluated"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp"
    },
    "producer": {
      "type": "string",
      "default": "cd_tradein"
    },
    "payload": {
      "type": "object",
      "required": [
        "offer_id",
        "imei",
        "device_grade",
        "trade_value",
        "evaluated_at"
      ],
      "properties": {
        "offer_id": {
          "type": "integer"
        },
        "imei": {
          "type": "string"
        },
        "device_grade": {
          "type": "string"
        },
        "trade_value": {
          "type": "number"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
