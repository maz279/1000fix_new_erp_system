{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "msp.alert_detected",
  "description": "Event emitted when endpoint telemetry breaches SLA threshold triggering ticket (Journey 6)",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "producer",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier for idempotency (UUIDv4)"
    },
    "event_type": {
      "type": "string",
      "const": "msp.alert_detected"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp"
    },
    "producer": {
      "type": "string",
      "default": "cd_msp_contract"
    },
    "payload": {
      "type": "object",
      "required": [
        "alert_id",
        "client_id",
        "device_id",
        "severity",
        "detected_at"
      ],
      "properties": {
        "alert_id": {
          "type": "string"
        },
        "client_id": {
          "type": "integer"
        },
        "device_id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "warning",
            "critical",
            "emergency"
          ]
        },
        "metric_breached": {
          "type": "string"
        },
        "detected_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
