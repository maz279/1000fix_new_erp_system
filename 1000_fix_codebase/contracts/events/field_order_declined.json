{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "field.order.declined",
  "description": "Event emitted when a technician declines a dispatched field service order with reason taxonomy (M02, CD-M02-01)",
  "type": "object",
  "required": ["event_id", "event_type", "timestamp", "producer", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier for idempotency"
    },
    "event_type": {
      "type": "string",
      "const": "field.order.declined"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "default": "cd_field_service"
    },
    "payload": {
      "type": "object",
      "required": ["order_id", "order_name", "technician_id", "reason_code", "reason_label"],
      "properties": {
        "order_id": { "type": "integer" },
        "order_name": { "type": "string" },
        "technician_id": { "type": "integer" },
        "technician_name": { "type": "string" },
        "reason_code": { 
          "type": "string",
          "enum": ["parts_unavailable", "distance_too_far", "traffic_gridlock", "tool_missing", "skill_mismatch", "other"]
        },
        "reason_label": { "type": "string" },
        "notes": { "type": "string" },
        "declined_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
