{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "field.order.accepted",
  "description": "Event emitted when a technician accepts a dispatched field service order (M02, CD-M02-01)",
  "type": "object",
  "required": ["event_id", "event_type", "timestamp", "producer", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier for idempotency"
    },
    "event_type": {
      "type": "string",
      "const": "field.order.accepted"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "default": "cd_field_service"
    },
    "payload": {
      "type": "object",
      "required": ["order_id", "order_name", "technician_id", "accepted_at"],
      "properties": {
        "order_id": { "type": "integer" },
        "order_name": { "type": "string" },
        "technician_id": { "type": "integer" },
        "technician_name": { "type": "string" },
        "accepted_at": { "type": "string", "format": "date-time" },
        "estimated_arrival": { "type": "string", "format": "date-time" }
      }
    }
  }
}
