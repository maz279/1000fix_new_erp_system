{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "geofence.breach.detected",
  "description": "Event emitted when a field technician enters or leaves an authorized customer service geofence zone (M02, CD-M02-01)",
  "type": "object",
  "required": ["event_id", "event_type", "timestamp", "producer", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier for idempotency"
    },
    "event_type": {
      "type": "string",
      "const": "geofence.breach.detected"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "default": "cd_field_service"
    },
    "payload": {
      "type": "object",
      "required": ["order_id", "technician_id", "breach_type", "distance_meters", "geofence_radius_meters"],
      "properties": {
        "order_id": { "type": "integer" },
        "order_name": { "type": "string" },
        "technician_id": { "type": "integer" },
        "technician_name": { "type": "string" },
        "breach_type": { 
          "type": "string",
          "enum": ["arrival_entered", "departure_exited", "unauthorized_departure"]
        },
        "technician_lat": { "type": "number" },
        "technician_lon": { "type": "number" },
        "customer_lat": { "type": "number" },
        "customer_lon": { "type": "number" },
        "distance_meters": { "type": "number" },
        "geofence_radius_meters": { "type": "number" }
      }
    }
  }
}
