{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "van.reconciled",
  "description": "Event emitted when mobile technician van inventory is reconciled or audited (M15, CD-M15-01)",
  "type": "object",
  "required": ["event_id", "event_type", "timestamp", "producer", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier for idempotency"
    },
    "event_type": {
      "type": "string",
      "const": "van.reconciled"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "default": "cd_inventory"
    },
    "payload": {
      "type": "object",
      "required": ["location_id", "location_code", "technician_id", "van_plate", "audit_date", "discrepancy_count"],
      "properties": {
        "location_id": { "type": "integer" },
        "location_code": { "type": "string" },
        "technician_id": { "type": "integer" },
        "van_plate": { "type": "string" },
        "audit_date": { "type": "string" },
        "discrepancy_count": { "type": "integer" },
        "reconciled_at": { "type": "string" }
      }
    }
  }
}
