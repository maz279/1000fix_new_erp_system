  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string"
          },
          "invalid_params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PageEnvelope": {
        "type": "object",
        "required": [
          "total",
          "page",
          "limit",
          "items"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "default": "BDT"
          }
        }
      },
      "AuditStamp": {
        "type": "object",
        "required": [
          "created_at",
          "created_by"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          }
        }
      },
      "RentalAsset": {
        "type": "object",
        "required": [
          "id",
          "asset_tag",
          "daily_rate",
          "deposit"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "asset_tag": {
            "type": "string"
          },
          "daily_rate": {
            "type": "number"
          },
          "deposit": {
            "type": "number"
          }
        }
      },
      "TradeInOffer": {
        "type": "object",
        "required": [
          "id",
          "imei",
          "device_condition",
          "estimated_value"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "imei": {
            "type": "string"
          },
          "device_condition": {
            "type": "string"
          },
          "estimated_value": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "EWasteIntake": {
        "type": "object",
        "required": [
          "id",
          "intake_number",
          "weight_kg",
          "triage_class"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "intake_number": {
            "type": "string"
          },
          "weight_kg": {
            "type": "number"
          },
          "triage_class": {
            "type": "string"
          }
        }
      },
      "DestructionCertificate": {
        "type": "object",
        "required": [
          "certificate_id",
          "intake_id",
          "wipe_status",
          "certified_by"
        ],
        "properties": {
          "certificate_id": {
            "type": "string"
          },
          "intake_id": {
            "type": "integer"
          },
          "wipe_status": {
            "type": "string"
          },
          "certified_by": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 via Kong Gateway",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.1000fix.com/v1/oauth/token",
            "scopes": {
              "read": "Read access to domain resources",
              "write": "Write access to domain resources",
              "admin": "Administrative management"
            }
          }
        }
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
