  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string"
          },
          "invalid_params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PageEnvelope": {
        "type": "object",
        "required": [
          "total",
          "page",
          "limit",
          "items"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "default": "BDT"
          }
        }
      },
      "AuditStamp": {
        "type": "object",
        "required": [
          "created_at",
          "created_by"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          }
        }
      },
      "CustomerEquipment": {
        "type": "object",
        "required": [
          "id",
          "serial_number",
          "customer_id",
          "brand",
          "model"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "serial_number": {
            "type": "string"
          },
          "customer_id": {
            "type": "integer"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        }
      },
      "FixedAsset": {
        "type": "object",
        "required": [
          "id",
          "asset_tag",
          "category",
          "capital_cost"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "asset_tag": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "capital_cost": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "FleetVehicle": {
        "type": "object",
        "required": [
          "id",
          "registration_no",
          "type",
          "driver_id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "registration_no": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "driver_id": {
            "type": "integer"
          }
        }
      },
      "IotTelemetry": {
        "type": "object",
        "required": [
          "device_id",
          "temperature",
          "vibration",
          "timestamp"
        ],
        "properties": {
          "device_id": {
            "type": "string"
          },
          "temperature": {
            "type": "number"
          },
          "vibration": {
            "type": "number"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 via Kong Gateway",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.1000fix.com/v1/oauth/token",
            "scopes": {
              "read": "Read access to domain resources",
              "write": "Write access to domain resources",
              "admin": "Administrative management"
            }
          }
        }
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
