  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string"
          },
          "invalid_params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PageEnvelope": {
        "type": "object",
        "required": [
          "total",
          "page",
          "limit",
          "items"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "default": "BDT"
          }
        }
      },
      "AuditStamp": {
        "type": "object",
        "required": [
          "created_at",
          "created_by"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          }
        }
      },
      "Invoice": {
        "type": "object",
        "required": [
          "id",
          "invoice_number",
          "customer_id",
          "total_amount",
          "vat_amount"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "invoice_number": {
            "type": "string"
          },
          "customer_id": {
            "type": "integer"
          },
          "total_amount": {
            "$ref": "#/components/schemas/Money"
          },
          "vat_amount": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "PaymentConfirmation": {
        "type": "object",
        "required": [
          "payment_reference",
          "invoice_id",
          "channel",
          "amount"
        ],
        "properties": {
          "payment_reference": {
            "type": "string"
          },
          "invoice_id": {
            "type": "integer"
          },
          "channel": {
            "type": "string",
            "enum": [
              "bkash",
              "nagad",
              "sslcommerz",
              "beftn",
              "cash"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "MushakFiling": {
        "type": "object",
        "required": [
          "tax_period",
          "total_sales",
          "vat_payable",
          "status"
        ],
        "properties": {
          "tax_period": {
            "type": "string"
          },
          "total_sales": {
            "$ref": "#/components/schemas/Money"
          },
          "vat_payable": {
            "$ref": "#/components/schemas/Money"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 via Kong Gateway",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.1000fix.com/v1/oauth/token",
            "scopes": {
              "read": "Read access to domain resources",
              "write": "Write access to domain resources",
              "admin": "Administrative management"
            }
          }
        }
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
