{
  "$comment": "P07-M09-T07 + PP5 — OpenAPI operations the portals consume. W4 slice (P04/P08/P10/P06) authored at PP1; PP5 adds the P01/P05/P07/P12 surfaces and aligns the contact transcript path with the JSON-RPC dispatcher (path params are body params in JSON-RPC — combined endpoints per the corporate pattern). IN-002 burn-down reported at the gate.",
  "openapi": "3.1.0",
  "info": {
    "title": "1000FiX Portal API — P01/P04/P05/P06/P07/P08/P10/P12",
    "version": "1.1.0-pp5"
  },
  "servers": [
    {
      "url": "https://api.1000fix.com/v1"
    }
  ],
  "paths": {
    "/corporate/estate": {
      "get": {
        "summary": "P04: the corporate asset estate (multi-site)",
        "parameters": [
          {
            "name": "customer_ref",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estate listing"
          }
        },
        "operationId": "listCorporateEstate"
      }
    },
    "/corporate/invoices/consolidated": {
      "get": {
        "summary": "P04: consolidated B2B invoices (M39)",
        "responses": {
          "200": {
            "description": "Consolidated invoice list"
          }
        },
        "operationId": "listConsolidatedInvoices"
      }
    },
    "/corporate/service-requests": {
      "post": {
        "summary": "P04: service requests at scale",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "422": {
            "description": "Rejected — server-side validation (AS-09)"
          }
        },
        "operationId": "createCorporateServiceRequest"
      }
    },
    "/brand/claims": {
      "get": {
        "summary": "P08: claim submission + status (M09)",
        "responses": {
          "200": {
            "description": "Claims"
          }
        },
        "operationId": "listBrandClaims"
      }
    },
    "/brand/claims/{claim_no}/status": {
      "get": {
        "summary": "P08: claim status (webhook-fed)",
        "responses": {
          "200": {
            "description": "Status"
          }
        },
        "operationId": "getBrandClaimStatus"
      }
    },
    "/brand/claims/webhook": {
      "post": {
        "summary": "P08: inbound claim status webhook (M09/T05)",
        "responses": {
          "200": {
            "description": "Acknowledged"
          }
        },
        "operationId": "postBrandClaimWebhook"
      }
    },
    "/brand/reconciliation": {
      "get": {
        "summary": "P08: remittance reconciliation (flagged mismatches)",
        "responses": {
          "200": {
            "description": "Reconciliation"
          }
        },
        "operationId": "getBrandReconciliation"
      }
    },
    "/contact/conversations": {
      "get": {
        "summary": "P10: the unified agent queue",
        "responses": {
          "200": {
            "description": "Queue"
          }
        },
        "operationId": "listConversations"
      }
    },
    "/contact/conversations/{id}/transcript": {
      "get": {
        "summary": "P10 (REST projection): transcript + customer 360 context. The JSON-RPC realisation is /contact/conversations/detail (PP5) — path params are body params in JSON-RPC.",
        "responses": {
          "200": {
            "description": "Transcript"
          }
        },
        "operationId": "getConversationTranscript"
      }
    },
    "/contact/conversations/detail": {
      "post": {
        "summary": "P10: transcript + customer 360 (JSON-RPC realisation; conversation_id in the body)",
        "responses": {
          "200": {
            "description": "Transcript + 360"
          }
        },
        "operationId": "getConversationDetail"
      }
    },
    "/contact/softphone": {
      "get": {
        "summary": "P10: the softphone integration seam — telephony endpoints from deployment config only (no credentials)",
        "responses": {
          "200": {
            "description": "Softphone config (nulls when unset)"
          }
        },
        "operationId": "getSoftphoneConfig"
      }
    },
    "/contact/handoff": {
      "post": {
        "summary": "P10: AI-to-agent handoff with full context",
        "responses": {
          "200": {
            "description": "Handed off"
          }
        },
        "operationId": "handoffToAgent"
      }
    },
    "/contact/telephony/webhook": {
      "post": {
        "summary": "P10 / INT-015: Inbound call event & speech transcript webhook (Hotline 16743)",
        "responses": {
          "200": {
            "description": "Call captured"
          }
        },
        "operationId": "handleTelephonyWebhook"
      }
    },
    "/contact/chat/message": {
      "post": {
        "summary": "P10 / INT-018: Omnichannel chat message intake (WhatsApp, Web Chat, In-App)",
        "responses": {
          "200": {
            "description": "Turn recorded and AI evaluated"
          }
        },
        "operationId": "handleChatMessage"
      }
    },
    "/analytics/dashboards": {
      "get": {
        "summary": "P06: embedded dashboard registry (R5)",
        "responses": {
          "200": {
            "description": "Dashboards"
          }
        },
        "operationId": "listDashboards"
      }
    },
    "/analytics/kpis": {
      "get": {
        "summary": "P06: the KPI register surface (M25)",
        "responses": {
          "200": {
            "description": "KPIs"
          }
        },
        "operationId": "getKpis"
      }
    },
    "/analytics/kpis/register": {
      "get": {
        "summary": "P06: the 95-KPI registry and BM-002 reconciliation (M25 / R05-M04-T03)",
        "responses": {
          "200": {
            "description": "95 KPI Register and BM-002 reconciliation"
          }
        },
        "operationId": "getKpiRegister"
      }
    },
    "/analytics/governance/catalogue": {
      "get": {
        "summary": "P06 / R09-M02-T01: Estate-wide data catalogue (1,335 owned entities, 12 domains, DA-002/DA-003)",
        "responses": {
          "200": {
            "description": "Data catalogue summary"
          }
        },
        "operationId": "getGovernanceCatalogue"
      }
    },
    "/analytics/governance/lineage": {
      "get": {
        "summary": "P06 / R09-M02-T02: Warehouse source-to-target feed lineage (DA-003 §6 / DA-007)",
        "responses": {
          "200": {
            "description": "Lineage audit"
          }
        },
        "operationId": "getGovernanceLineage"
      }
    },
    "/analytics/governance/dq": {
      "get": {
        "summary": "P06 / R09-M02-T03: Data quality monitoring rules, thresholds, and alert dispatch (DA-008)",
        "responses": {
          "200": {
            "description": "Data quality monitoring evidence"
          }
        },
        "operationId": "getGovernanceDataQuality"
      }
    },
    "/analytics/governance/residency": {
      "get": {
        "summary": "P06 / R09-M02-T04: NFR-086c residency classification compliance scan across warehouse",
        "responses": {
          "200": {
            "description": "NFR-086c residency compliance scan"
          }
        },
        "operationId": "getGovernanceResidency"
      }
    },
    "/analytics/stt/dashboard": {
      "get": {
        "summary": "P06 / R09-M03-T04: Speech-to-Text productionisation, WER tracking and model drift monitoring",
        "responses": {
          "200": {
            "description": "Bengali STT accuracy metrics, WER distribution, drift status, and PDPA compliance"
          }
        },
        "operationId": "getSTTDashboardMetrics"
      }
    },
    "/customer/devices": {
      "post": {
        "summary": "P01: the customer's devices with the M17 history timeline",
        "responses": {
          "200": {
            "description": "Devices + history"
          }
        },
        "operationId": "listCustomerDevices"
      }
    },
    "/customer/bookings": {
      "post": {
        "summary": "P01: <=3-step booking + tracking list (combined JSON-RPC endpoint)",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerBooking"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bookings list or the created booking"
          },
          "422": {
            "description": "Rejected — server-side validation (AS-09)"
          }
        },
        "operationId": "customerBookings"
      }
    },
    "/customer/tracking": {
      "post": {
        "summary": "P01: live tracking — state, technician, SLA clocks (polling today; the websocket upgrade rides this shape)",
        "responses": {
          "200": {
            "description": "Tracking"
          }
        },
        "operationId": "trackOrder"
      }
    },
    "/customer/estimates": {
      "post": {
        "summary": "P01: estimate approval — the customer documents approval (BRU-SRM-07), the model enforces the gates",
        "responses": {
          "200": {
            "description": "Estimates list or the approval result"
          },
          "422": {
            "description": "Gate rejection — visible, never warned (G-series)"
          }
        },
        "operationId": "customerEstimates"
      }
    },
    "/customer/invoices": {
      "post": {
        "summary": "P01: the customer's issued invoices — total, paid and balance per invoice (partner-scoped, EA-05)",
        "responses": {
          "200": {
            "description": "Invoice list with backend-formatted BDT strings"
          }
        },
        "operationId": "customerInvoices"
      }
    },
    "/customer/consent": {
      "post": {
        "summary": "P01: the PDPA consent dashboard — grant/withdraw per channel, status visible (PP0 audit gap closed)",
        "responses": {
          "200": {
            "description": "Consent rows or the action result"
          },
          "422": {
            "description": "A grant without proof is refused — an unverifiable grant is not a grant"
          }
        },
        "operationId": "customerConsent"
      }
    },
    "/customer/ownership/transfer": {
      "post": {
        "summary": "P01: device ownership transfer (T05 — 'portal P01 exposes this in Phase 5')",
        "responses": {
          "200": {
            "description": "Transferred"
          },
          "422": {
            "description": "Only the current owner can transfer"
          }
        },
        "operationId": "transferOwnership"
      }
    },
    "/vendor/purchase-orders": {
      "post": {
        "summary": "P05: RFQ response (PO acknowledgement) + delivery confirm + list (M16)",
        "responses": {
          "200": {
            "description": "POs or the action result"
          },
          "422": {
            "description": "Only a sent PO can be acknowledged"
          }
        },
        "operationId": "vendorPurchaseOrders"
      }
    },
    "/vendor/invoices": {
      "post": {
        "summary": "P05: invoice submission feeding the three-way match (G3-06: blocked invoices ship their block reason)",
        "responses": {
          "200": {
            "description": "Invoices (match_state + match_detail) or the submission result"
          },
          "422": {
            "description": "An invoice must land on a PO for the match"
          }
        },
        "operationId": "vendorInvoices"
      }
    },
    "/seller/dashboard": {
      "post": {
        "summary": "P07: seller onboarding state + headline numbers (M12)",
        "responses": {
          "200": {
            "description": "Seller profile"
          }
        },
        "operationId": "sellerDashboard"
      }
    },
    "/seller/orders": {
      "post": {
        "summary": "P07: the open jobs board with the seller's own quote visible (EA-05)",
        "responses": {
          "200": {
            "description": "Jobs board"
          }
        },
        "operationId": "sellerOrders"
      }
    },
    "/seller/quotes": {
      "post": {
        "summary": "P07: quote submission + list — only a KYC-verified seller quotes (the gate is stated, not warned)",
        "responses": {
          "200": {
            "description": "Quotes or the submission result"
          },
          "422": {
            "description": "KYC gate / invalid price / closed job"
          }
        },
        "operationId": "sellerQuotes"
      }
    },
    "/seller/scorecard": {
      "post": {
        "summary": "P07: the seller's scorecard history (M12 performance)",
        "responses": {
          "200": {
            "description": "Scorecard"
          }
        },
        "operationId": "sellerScorecard"
      }
    },
    "/seller/settlements": {
      "post": {
        "summary": "P07: settlement statements from the commission ledger (owned by cd_settlement_ext — FL-03)",
        "responses": {
          "200": {
            "description": "Statement lines + net total (BN-007 strings)"
          }
        },
        "operationId": "sellerSettlements"
      }
    },
    "/partner/profile": {
      "post": {
        "summary": "P12: the partner's standing — type, territory, rate, state",
        "responses": {
          "200": {
            "description": "Partner profile"
          }
        },
        "operationId": "partnerProfile"
      }
    },
    "/partner/referrals": {
      "post": {
        "summary": "P12: referral submission (attribution on the referred party) + tracking (M53)",
        "responses": {
          "200": {
            "description": "Referrals or the submission result"
          },
          "422": {
            "description": "referred_partner_id is required"
          }
        },
        "operationId": "partnerReferrals"
      }
    },
    "/partner/commissions": {
      "post": {
        "summary": "P12: the commission statement from the referral ledger",
        "responses": {
          "200": {
            "description": "Statement lines + earned total (BN-007 strings)"
          }
        },
        "operationId": "partnerCommissions"
      }
    }
  },
  "components": {
    "schemas": {
      "ServiceRequest": {
        "type": "object",
        "required": [
          "device_serial",
          "fault_description",
          "site_ref"
        ],
        "properties": {
          "device_serial": {
            "type": "string"
          },
          "fault_description": {
            "type": "string"
          },
          "site_ref": {
            "type": "string"
          },
          "order_category": {
            "type": "string",
            "enum": [
              "standard",
              "warranty",
              "amc"
            ]
          }
        }
      },
      "CustomerBooking": {
        "type": "object",
        "required": [
          "device_id",
          "fault_description"
        ],
        "properties": {
          "device_id": {
            "type": "integer",
            "description": "M17 — every booking needs an identified device owned by the customer"
          },
          "fault_description": {
            "type": "string"
          },
          "order_category": {
            "type": "string",
            "enum": [
              "standard",
              "warranty",
              "amc"
            ]
          },
          "priority": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-contract-tests": {
    "PS-11": "an invalid payload posted directly to the API must be REJECTED — the proof that business rules are not in portal code (P07-M09-T08)",
    "event-reconciliation": "the 69 unpublished portal-consumed events (T06) are dispositioned per event: rename, project, or register"
  }
}
