  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string"
          },
          "invalid_params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PageEnvelope": {
        "type": "object",
        "required": [
          "total",
          "page",
          "limit",
          "items"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "default": "BDT"
          }
        }
      },
      "AuditStamp": {
        "type": "object",
        "required": [
          "created_at",
          "created_by"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          }
        }
      },
      "StockItem": {
        "type": "object",
        "required": [
          "id",
          "sku",
          "quantity_on_hand",
          "location_id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "sku": {
            "type": "string"
          },
          "quantity_on_hand": {
            "type": "number"
          },
          "location_id": {
            "type": "integer"
          }
        }
      },
      "PurchaseOrder": {
        "type": "object",
        "required": [
          "id",
          "po_number",
          "supplier_id",
          "total_amount"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "po_number": {
            "type": "string"
          },
          "supplier_id": {
            "type": "integer"
          },
          "total_amount": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "SupplierScorecard": {
        "type": "object",
        "required": [
          "id",
          "supplier_id",
          "composite_score",
          "on_time_delivery_rate",
          "quality_pass_rate"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "supplier_id": {
            "type": "integer"
          },
          "composite_score": {
            "type": "number"
          },
          "on_time_delivery_rate": {
            "type": "number"
          },
          "quality_pass_rate": {
            "type": "number"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 via Kong Gateway",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.1000fix.com/v1/oauth/token",
            "scopes": {
              "read": "Read access to domain resources",
              "write": "Write access to domain resources",
              "admin": "Administrative management"
            }
          }
        }
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
