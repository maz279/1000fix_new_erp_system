  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string"
          },
          "invalid_params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PageEnvelope": {
        "type": "object",
        "required": [
          "total",
          "page",
          "limit",
          "items"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "default": "BDT"
          }
        }
      },
      "AuditStamp": {
        "type": "object",
        "required": [
          "created_at",
          "created_by"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          }
        }
      },
      "NcrRecord": {
        "type": "object",
        "required": [
          "id",
          "ncr_number",
          "severity",
          "source"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "ncr_number": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "major",
              "critical"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      },
      "CapaAction": {
        "type": "object",
        "required": [
          "id",
          "ncr_id",
          "root_cause",
          "action_plan",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "ncr_id": {
            "type": "integer"
          },
          "root_cause": {
            "type": "string"
          },
          "action_plan": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "DocumentVaultItem": {
        "type": "object",
        "required": [
          "id",
          "doc_name",
          "hash_sha256",
          "signature_status"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "doc_name": {
            "type": "string"
          },
          "hash_sha256": {
            "type": "string"
          },
          "signature_status": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 via Kong Gateway",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.1000fix.com/v1/oauth/token",
            "scopes": {
              "read": "Read access to domain resources",
              "write": "Write access to domain resources",
              "admin": "Administrative management"
            }
          }
        }
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
