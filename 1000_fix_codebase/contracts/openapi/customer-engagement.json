  "components": {
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 Problem Details",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string"
          },
          "invalid_params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PageEnvelope": {
        "type": "object",
        "required": [
          "total",
          "page",
          "limit",
          "items"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "default": "BDT"
          }
        }
      },
      "AuditStamp": {
        "type": "object",
        "required": [
          "created_at",
          "created_by"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          }
        }
      },
      "CustomerLead": {
        "type": "object",
        "required": [
          "id",
          "name",
          "phone",
          "channel"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          }
        }
      },
      "ContactTranscript": {
        "type": "object",
        "required": [
          "id",
          "session_id",
          "channel",
          "messages"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "session_id": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "AssistantIntent": {
        "type": "object",
        "required": [
          "intent_code",
          "utterance",
          "confidence"
        ],
        "properties": {
          "intent_code": {
            "type": "string"
          },
          "utterance": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        }
      },
      "PartyRecord": {
        "type": "object",
        "required": [
          "id",
          "party_type",
          "display_name"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "party_type": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "nid_bin": {
            "type": "string"
          }
        }
      },
      "LoyaltyAccount": {
        "type": "object",
        "required": [
          "id",
