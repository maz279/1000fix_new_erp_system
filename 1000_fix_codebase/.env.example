# =============================================================================
# 1000fix-erp - .env.example (P02-M06-T05, DE-10)
# Copy to .env and fill the values. .env is GIT-IGNORED - never commit it.
# A new variable added to code and not to this example is a broken
# onboarding for the next joiner: keep them in lockstep.
# ALL values here are DEVELOPMENT-ONLY placeholders. No credential that works
# anywhere outside 127.0.0.1 may ever appear in this file.
# =============================================================================

# --- Environment identity (DE-11: every service asserts this is 'local') ----
FIX_ENV=local

# --- PostgreSQL (core profile) -----------------------------------------------
POSTGRES_PASSWORD=change-me-dev-only
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=fix
PGDATABASE=fix_dev

# --- Object store (core profile; D-028 Ceph local dev shape) -----------------
S3_ENDPOINT=http://127.0.0.1:9002
S3_ACCESS_KEY=fix-dev-access
S3_SECRET_KEY=fix-dev-secret
S3_BUCKET=fix-dev-bucket

# --- Redis (core profile; host port 6380 — 6379 is reserved on shared
#     workstations by neighbouring projects) ------------------------------------
REDIS_URL=redis://localhost:6380/0

# --- Mail (DE-07: Mailpit is the ONLY sink; outbound SMTP is never real) ----
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=dev-null@1000fix.local

# --- Residency stub (FF-09; synthetic-only by construction) ------------------
RESIDENCY_BASE=http://127.0.0.1:8100
RESIDENCY_MODE=synthetic-only

# --- Keycloak (auth profile; realm: 1000fix-dev, synthetic DE-09) ------------
# Realm user passwords are literal values in the realm JSON (Keycloak does
# not env-substitute on import); only the admin password is env-driven.
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=1000fix-dev
KEYCLOAK_ADMIN_PASSWORD=change-me-dev-only

# --- Odoo (generated conf reads these; see generate-odoo-conf) ---------------
ODOO_DB=fix_dev
ODOO_HTTP_PORT=8069
ODOO_ADMIN_PASSWORD=change-me-dev-only

# --- Observability (observability profile) ------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
GRAFANA_ADMIN_PASSWORD=change-me-dev-only
