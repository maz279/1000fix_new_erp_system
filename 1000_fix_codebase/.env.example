# =============================================================================
# 1000fix-erp - .env.example (P02-M06-T05, DE-10)
# Copy to .env and fill the values. .env is GIT-IGNORED - never commit it.
# A new variable added to code and not to this example is a broken
# onboarding for the next joiner: keep them in lockstep.
# ALL values here are DEVELOPMENT-ONLY placeholders. No credential that works
# anywhere outside 127.0.0.1 may ever appear in this file.
# =============================================================================

# --- Environment identity (DE-11: every service asserts this is 'local') ----
FIX_ENV=local

# --- PostgreSQL (core profile) -----------------------------------------------
POSTGRES_PASSWORD=change-me-dev-only
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=fix
PGDATABASE=fix_dev
# Streaming-replication role password (prod/dr/ha overlays: primary-init.sh +
# standby bootstrap). Vault path database/credentials/replication:password.
PG_REPLICATION_PASSWORD=change-me-dev-only
# prod overlay only - postgres-prod TLS certificate/key paths (outside the repo,
# never committed; see the header of infra/compose/docker-compose.prod.yml).
# Not needed for the local stack.
# PG_TLS_CERT_FILE=/path/outside/repo/server.crt
# PG_TLS_KEY_FILE=/path/outside/repo/server.key

# --- Object store (core profile; D-028 Ceph local dev shape) -----------------
S3_ENDPOINT=http://127.0.0.1:9002
S3_ACCESS_KEY=fix-dev-access
S3_SECRET_KEY=fix-dev-secret
S3_BUCKET=fix-dev-bucket

# --- Redis (core profile; host port 6380 — 6379 is reserved on shared
#     workstations by neighbouring projects) ------------------------------------
REDIS_URL=redis://localhost:6380/0

# --- Mail (DE-07: Mailpit is the ONLY sink; outbound SMTP is never real) ----
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=dev-null@1000fix.local

# --- Residency stub (FF-09; synthetic-only by construction) ------------------
RESIDENCY_BASE=http://127.0.0.1:8100
RESIDENCY_MODE=synthetic-only

# --- Keycloak (auth profile; realm: 1000fix-dev, synthetic DE-09) ------------
# Realm user passwords are literal values in the realm JSON (Keycloak does
# not env-substitute on import); only the admin password is env-driven.
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=1000fix-dev
KEYCLOAK_ADMIN_PASSWORD=change-me-dev-only

# --- Novu (integration profile) -----------------------------------------------
# Generate per environment, e.g. python -c "import secrets;print(secrets.token_hex(16))"
# STORE_ENCRYPTION_KEY must be exactly 32 characters.
NOVU_JWT_SECRET=
NOVU_STORE_ENCRYPTION_KEY=
NOVU_SECRET_KEY=

# --- Analytics replica + warehouse (superset/intelligence profiles) ------------
# postgres-replica (docker-compose.superset.yml) runs as fix_readonly by default.
REPLICA_POSTGRES_PASSWORD=readonly_dev_pass
# bi-warehouse reads ONLY the replica (LB-06); DSN built from the values above.
PG_READ_REPLICA_DSN=
CLICKHOUSE_PASSWORD=

# --- Odoo (generated conf reads these; see generate-odoo-conf) ---------------
ODOO_DB=fix_dev
ODOO_HTTP_PORT=8069
ODOO_ADMIN_PASSWORD=change-me-dev-only

# --- Web portals (apps/web/*) --------------------------------------------------
# Odoo database the portal logins target. Required in production builds
# (no fix_dev fallback when NODE_ENV=production).
NEXT_PUBLIC_ODOO_DB=fix_dev
# Customer portal: server-side gateway + technician relay key (never NEXT_PUBLIC).
FIX_API_BASE=http://127.0.0.1:8000
FIX_ODOO_DB=fix_dev
FIX_TECHNICIAN_API_KEY=
# Corporate portal OIDC (Keycloak). The token exchange runs server-side with
# PKCE S256 + state; the client secret is optional and must stay non-public.
OIDC_ISSUER=http://127.0.0.1:8080/realms/1000fix-dev
OIDC_CLIENT_ID=1000fix-corporate-web
OIDC_REDIRECT_URI=http://127.0.0.1:3001/auth/callback
OIDC_CLIENT_SECRET=
# Analytics portal: Superset origin allowed in CSP frame-src (unset = no embed).
NEXT_PUBLIC_SUPERSET_URL=

# --- Observability (observability profile) ------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
GRAFANA_ADMIN_PASSWORD=change-me-dev-only

# --- Intelligence profile (ClickHouse; entrypoint disables network access
# for user 'default' when no password is set) ------------------------------
CLICKHOUSE_PASSWORD=change-me-dev-only
