# =============================================================================
# identity-lifecycle (M29, KPI-090) - DEVELOPMENT PLACEHOLDERS ONLY.
# Keycloak admin credentials come from the environment and nowhere else; with
# neither a service-account secret nor an admin user+password set, the service
# refuses to start (fail closed).
# =============================================================================
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=1000fix-dev
# Preferred: a confidential service-account client with the realm-management roles
# view-users + manage-users (token from KEYCLOAK_ADMIN_REALM, default "master").
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Local dev alternative: the bootstrap admin (same value as the root .env).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_TIMEOUT_SECONDS=10
# Processed-event ledger (re-delivery safety across restarts); empty = in memory.
IDENTITY_LIFECYCLE_LEDGER=
IDENTITY_LIFECYCLE_HOST=127.0.0.1
IDENTITY_LIFECYCLE_PORT=8120
IDENTITY_LIFECYCLE_POLL_SECONDS=15
# Shared secret for the ops endpoints (/outcomes, /consume/once, /drain), sent in
# the X-Identity-Lifecycle-Token header. Unset: open in FIX_ENV=local only,
# DISABLED (503) everywhere else. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
IDENTITY_LIFECYCLE_TOKEN=
